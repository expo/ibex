+  const auto previous = runtime.embedderJobConstrainedPrincipals();
+  runtime.setEmbedderJobConstrainedPrincipals(
+      std::make_shared<const std::vector<uint32_t>>(std::move(merged)));
+  auto callResult = Callable::executeCall0(
+      callable, runtime, Runtime::getUndefinedValue());
+  runtime.setEmbedderJobConstrainedPrincipals(previous);
+  return callResult.toCallResultHermesValue();
+}
