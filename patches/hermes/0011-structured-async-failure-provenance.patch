+    uint64_t *identity,
+    uint64_t *associatedEvaluation) {
+  if (!vmRuntime || !principal || !identity || !associatedEvaluation)
+    return 0;
+  ::hermes::vm::Runtime::JobScheduleContext context{};
+  if (!reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)
+           ->takeFailedJobContext(context))
+    return 0;
+  *principal = context.principal;
+  *identity = context.identity;
+  *associatedEvaluation = context.associatedEvaluation;
+  return 1;
