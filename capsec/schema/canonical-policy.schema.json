{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/canonical-policy.schema.json",
  "title": "Ibex canonical capsec review policy",
  "type": "object",
  "required": ["policySchema", "capsVocab", "semanticCore", "vocabDigest", "registryDigest", "policyDigest", "purpose", "mode", "graphIdentity", "entryIdentity", "targetProfile", "mountProfile", "rootCeiling", "computedCandidates", "principals"],
  "properties": {
    "policySchema": { "const": "ibex/capsec-policy/2" },
    "capsVocab": { "const": "ibex/capsec/1" },
    "semanticCore": { "const": "capsec/semantics/1" },
    "vocabDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "registryDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "purpose": { "const": "production" },
    "mode": { "const": "enforce" },
    "graphIdentity": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "entryIdentity": { "$ref": "#/$defs/entryIdentity" },
    "targetProfile": { "$ref": "#/$defs/targetProfile" },
    "mountProfile": {
      "enum": ["project-v1", "compiled-app-work-v1"]
    },
    "rootCeiling": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonicalRow" }
    },
    "computedCandidates": { "$ref": "#/$defs/computedCandidates" },
    "principals": {
      "type": "array",
      "items": { "$ref": "#/$defs/principalPolicy" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entryIdentity": {
      "type": "object",
      "required": ["root", "components", "sourceIntegrity"],
      "properties": {
        "root": { "const": "project" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/pathComponent"
          }
        },
        "sourceIntegrity": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "targetProfile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "profile"],
          "properties": {
            "kind": { "const": "source" },
            "profile": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "profile", "targetTriple"],
          "properties": {
            "kind": { "const": "compiled" },
            "profile": { "type": "string", "minLength": 1 },
            "targetTriple": {
              "type": "string",
              "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)+$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "candidateSiteDeclaration": {
      "type": "object",
      "required": ["requester", "label", "specifiers", "packageClosures"],
      "properties": {
        "requester": { "type": "string", "minLength": 1 },
        "label": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "specifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "packageClosures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/packageLocator"
          }
        }
      },
      "additionalProperties": false
    },
    "candidateClosureOptIn": {
      "type": "object",
      "required": ["package", "provenance"],
      "properties": {
        "package": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/packageLocator"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/provenance" }
        }
      },
      "additionalProperties": false
    },
    "materializedCandidateSite": {
      "type": "object",
      "required": ["requester", "label", "candidates"],
      "properties": {
        "requester": { "type": "string", "minLength": 1 },
        "label": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "computedCandidates": {
      "type": "object",
      "required": ["schema", "declarations", "packageClosureOptIns", "materializedSites"],
      "properties": {
        "schema": { "const": "ibex/computed-candidate-manifest/1" },
        "declarations": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateSiteDeclaration" }
        },
        "packageClosureOptIns": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateClosureOptIn" }
        },
        "materializedSites": {
          "type": "array",
          "items": { "$ref": "#/$defs/materializedCandidateSite" }
        }
      },
      "additionalProperties": false
    },
    "canonicalRow": {
      "type": "object",
      "required": ["authority", "provenance"],
      "properties": {
        "authority": {
          "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/provenance" }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["direct", "import-site", "delegation", "macro-expansion"] },
        "source": { "type": "string", "minLength": 1 },
        "rule": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        }
      },
      "additionalProperties": false
    },
    "principalPolicy": {
      "type": "object",
      "required": ["principal", "floor", "denials", "escalationCeiling", "imports", "endowments"],
      "properties": {
        "principal": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/principal"
        },
        "floor": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalRow" }
        },
        "denials": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalRow" }
        },
        "escalationCeiling": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalRow" }
        },
        "imports": {
          "type": "object",
          "required": ["builtins", "packages"],
          "properties": {
            "builtins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "packages": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/packageLocator"
              }
            }
          },
          "additionalProperties": false
        },
        "endowments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
