{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-definition.schema.json",
  "title": "Ibex restricted Exact embedder profile definition",
  "type": "object",
  "required": [
    "definitionSchema",
    "profile",
    "fullProfile",
    "status",
    "sourceEdgeSet",
    "candidateTargets",
    "targetDispositionOverrides",
    "reachable",
    "trustedControlPlane",
    "structuralAbsencePolicy",
    "advertisements"
  ],
  "properties": {
    "definitionSchema": { "const": "ibex/restricted-profile-definition/2" },
    "profile": { "const": "ibex/exact-embedder-contract/1" },
    "fullProfile": { "const": "ibex/capsec/1" },
    "status": { "const": "draft-unadvertised" },
    "sourceEdgeSet": {
      "type": "object",
      "required": ["count", "digest"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "candidateTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "targetDispositionOverrides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["target", "edgeId", "surfaceKind", "surfaceName", "disposition", "reason"],
        "properties": {
          "target": { "$ref": "#/$defs/target" },
          "edgeId": { "type": "string", "minLength": 1 },
          "surfaceKind": { "enum": ["builtin", "callback", "cli", "host-abi", "loader", "native-op", "startup"] },
          "surfaceName": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["reachable", "structurally-absent", "trusted-control-plane"] },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "reachable": { "$ref": "#/$defs/boundEdges" },
    "trustedControlPlane": { "$ref": "#/$defs/boundEdges" },
    "structuralAbsencePolicy": {
      "type": "object",
      "required": ["complementDisposition", "evidence", "newEdgeRule"],
      "properties": {
        "complementDisposition": { "const": "structurally-absent" },
        "evidence": { "const": "pending-source-install-and-live-reachability" },
        "newEdgeRule": { "const": "fail-until-source-edge-set-digest-is-explicitly-reviewed" }
      },
      "additionalProperties": false
    },
    "advertisements": { "type": "array", "maxItems": 0 }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": { "type": "string", "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$" },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$" }
        }
      },
      "additionalProperties": false
    },
    "boundEdges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["edgeId", "surfaceKind", "surfaceName", "reason"],
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "surfaceKind": { "enum": ["builtin", "callback", "cli", "host-abi", "loader", "native-op", "startup"] },
          "surfaceName": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  }
}
