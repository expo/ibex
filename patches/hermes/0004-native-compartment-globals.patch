# LLP 0013 Hermes patch 0004 — native per-package compartment globals
# Class: B (a GCPointer field + metadata line on Domain, a native global
#         function) + C (the 3 interpreter global-resolution sites + one
#         #include). @ref LLP 0013#mechanism-2 (Phase 3)
#
# Makes compartment globals native, retiring the need for the build-time
# free-global rewrite: the interpreter resolves bare-global references and
# sloppy-mode `this` through the executing frame's Domain "compartment global"
# (a per-package object that withholds powerful globals) when one is set, and
# through the shared real global otherwise (the common case, one extra load +
# predicted-not-taken branch).
#
#   * Domain gains a GC-traced `GCPointer<JSObject> compartmentGlobal_` +
#     get/setCompartmentGlobal accessors, plus its metadata-builder field.
#   * initGlobalObject installs `__exactSetCompartmentFor(fn, obj)`, a native
#     function that stamps a just-compiled function's Domain with a compartment
#     global (the loader captures it privately and the end-of-bootstrap seal
#     deletes it — setting a Domain's compartment is a containment-escape
#     primitive if left reachable).
#   * Interpreter CASE(GetGlobalObject) / CASE(CoerceThisNS) / CASE(LoadThisNS)
#     resolve through `globalForFrame(runtime, curCodeBlock)`.
#
# Not yet native (documented Phase 3 follow-ups, both low-priority because
# lockdown already tames eval/Function and the userland freeze works): binding
# eval/Function-produced code to the caller's compartment, and a native lockdown
# freeze primitive.
diff --git a/include/hermes/VM/Domain.h b/include/hermes/VM/Domain.h
index 9a37c7c5c..7d4b8fede 100644
--- a/include/hermes/VM/Domain.h
+++ b/include/hermes/VM/Domain.h
@@ -113,6 +113,15 @@ class Domain final : public GCCell {
   /// cannot forge.
   uint32_t packageId_{0};
 
+  /// @ref LLP 0013#mechanism-2 (Phase 3) — the per-package compartment global
+  /// object. When set, bare-global references and sloppy-mode `this` in code
+  /// owned by this Domain resolve to this object (a per-package global that
+  /// withholds powerful globals) instead of the shared real global — native
+  /// compartments without a build-time source rewrite. Null (the common case)
+  /// means "resolve against the real global". GC-traced, so it needs a metadata
+  /// builder entry (unlike packageId_).
+  GCPointer<JSObject> compartmentGlobal_{};
+
  public:
   static constexpr CellKind getCellKind() {
     return CellKind::DomainKind;
@@ -133,6 +142,18 @@ class Domain final : public GCCell {
     packageId_ = packageId;
   }
 
+  /// \return the per-package compartment global for this Domain's code, or null
+  /// when it resolves against the real global. @ref LLP 0013#mechanism-2
+  JSObject *getCompartmentGlobal(Runtime &runtime) const {
+    return compartmentGlobal_.get(runtime);
+  }
+
+  /// Set the per-package compartment global for this Domain's code.
+  /// @ref LLP 0013#mechanism-2
+  void setCompartmentGlobal(Runtime &runtime, JSObject *obj) {
+    compartmentGlobal_.set(runtime, obj, runtime.getHeap());
+  }
+
   /// Create a Domain with no associated RuntimeModules.
   static PseudoHandle<Domain> create(Runtime &runtime);
 
