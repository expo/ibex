{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/conformance-report.schema.json",
  "title": "Ibex capsec exact-target conformance report",
  "type": "object",
  "required": [
    "conformanceSchema",
    "profile",
    "status",
    "bindings",
    "summary",
    "executions",
    "cells",
    "conformanceDigest"
  ],
  "properties": {
    "conformanceSchema": { "const": "ibex/capsec-conformance/1" },
    "profile": { "const": "ibex/capsec/1" },
    "status": { "enum": ["conformant", "incomplete"] },
    "bindings": {
      "type": "object",
      "required": [
        "sourceRevision",
        "sourceTreeDigest",
        "engine",
        "target",
        "vocabularyDigest",
        "registryDigest",
        "implementationManifestDigest",
        "fixtureCatalogDigest",
        "recipeCatalogDigest",
        "publicSurfaceExecutionDigest"
      ],
      "properties": {
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceTreeDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "engine": {
          "type": "object",
          "required": [
            "engineArtifactPath",
            "kind",
            "binaryDigest",
            "object",
            "targetArchitecture",
            "structuralFeatures"
          ],
          "properties": {
            "engineArtifactPath": { "type": "string", "minLength": 1 },
            "kind": { "const": "hermes" },
            "binaryDigest": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
            },
            "object": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
            },
            "targetArchitecture": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "structuralFeatures": { "$ref": "#/$defs/idSet" }
          },
          "additionalProperties": false
        },
        "target": { "$ref": "#/$defs/target" },
        "vocabularyDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "registryDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "implementationManifestDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "fixtureCatalogDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "recipeCatalogDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "publicSurfaceExecutionDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "outputDispositionEvidenceRawContentDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "cells",
        "conformantCells",
        "incompleteCells",
        "requiredFixtures",
        "passedFixtures",
        "missingFixtures",
        "failedFixtures"
      ],
      "properties": {
        "cells": { "type": "integer", "minimum": 1 },
        "conformantCells": { "type": "integer", "minimum": 0 },
        "incompleteCells": { "type": "integer", "minimum": 0 },
        "requiredFixtures": { "type": "integer", "minimum": 1 },
        "passedFixtures": { "type": "integer", "minimum": 0 },
        "missingFixtures": { "type": "integer", "minimum": 0 },
        "failedFixtures": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "executions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "fixtureId",
          "outcome",
          "executor",
          "artifactDigest",
          "bindingDigest",
          "evidence"
        ],
        "properties": {
          "fixtureId": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          },
          "outcome": { "enum": ["passed", "failed"] },
          "executor": { "type": "string", "minLength": 1 },
          "artifactDigest": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
          },
          "bindingDigest": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
          },
          "evidence": {
            "type": "object",
            "required": ["evidenceSchema", "fixtureId", "command", "exitCode", "resultMarker", "planDigest", "engineBinaryDigest", "fixturePlan", "executionBinding", "observation", "runtimeObservation"],
            "properties": {
              "evidenceSchema": { "const": "ibex/capsec-fixture-evidence/2" },
              "fixtureId": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "exitCode": { "type": "integer" },
              "resultMarker": { "type": "string", "minLength": 1 },
              "planDigest": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
              },
              "engineBinaryDigest": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
              },
              "fixturePlan": { "$ref": "#/$defs/fixturePlan" },
              "executionBinding": { "$ref": "#/$defs/executionBinding" },
              "observation": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "branchId", "result"],
                    "properties": {
                      "kind": { "const": "enforcement-branch" },
                      "branchId": {
                        "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
                      },
                      "result": { "enum": ["passed", "failed"] }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "edgeId", "result"],
                    "properties": {
                      "kind": { "const": "target-absence" },
                      "edgeId": {
                        "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
                      },
                      "result": { "enum": ["passed", "failed"] }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "runtimeObservation": {
                "type": "object",
                "required": [
                  "observationSchema",
                  "invocation",
                  "legacyObservationCount",
                  "typedDecisions"
                ],
                "properties": {
                  "observationSchema": {
                    "const": "ibex/capsec-runtime-public-observation/1"
                  },
                  "invocation": { "type": "object", "minProperties": 1 },
                  "legacyObservationCount": { "const": 0 },
                  "typedDecisions": { "type": "array" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "edgeId",
          "implementationBranchIds",
          "enforcementBranchIds",
          "status",
          "requiredFixtures",
          "passedFixtures",
          "missingFixtures",
          "failedFixtures"
        ],
        "properties": {
          "edgeId": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          },
          "implementationBranchIds": { "$ref": "#/$defs/idSet" },
          "enforcementBranchIds": { "$ref": "#/$defs/idSet" },
          "status": { "enum": ["conformant", "incomplete"] },
          "requiredFixtures": { "$ref": "#/$defs/idSet" },
          "passedFixtures": { "$ref": "#/$defs/idSet" },
          "missingFixtures": { "$ref": "#/$defs/idSet" },
          "failedFixtures": { "$ref": "#/$defs/idSet" }
        },
        "additionalProperties": false
      }
    },
    "conformanceDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "conformant" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "bindings": {
            "type": "object",
            "properties": {
              "outputDispositionEvidenceRawContentDigest": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
              }
            },
            "required": ["outputDispositionEvidenceRawContentDigest"]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "executionBinding": {
      "type": "object",
      "required": [
        "sourceRevision",
        "sourceTreeDigest",
        "target",
        "engine",
        "vocabularyDigest",
        "registryDigest",
        "implementationManifestDigest",
        "fixtureCatalogDigest",
        "recipeCatalogDigest",
        "publicSurfaceExecutionDigest"
      ],
      "properties": {
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceTreeDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "target": { "$ref": "#/$defs/target" },
        "engine": {
          "type": "object",
          "required": [
            "engineArtifactPath",
            "kind",
            "binaryDigest",
            "object",
            "targetArchitecture",
            "structuralFeatures"
          ],
          "properties": {
            "engineArtifactPath": { "type": "string", "minLength": 1 },
            "kind": { "const": "hermes" },
            "binaryDigest": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
            },
            "object": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
            },
            "targetArchitecture": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "structuralFeatures": { "$ref": "#/$defs/idSet" }
          },
          "additionalProperties": false
        },
        "vocabularyDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "registryDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "implementationManifestDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "fixtureCatalogDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "recipeCatalogDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "publicSurfaceExecutionDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "fixturePlan": {
      "type": "object",
      "required": [
        "fixtureId",
        "edgeIds",
        "implementationBranchIds",
        "enforcementBranchIds",
        "terminalObservedKey",
        "classification",
        "actionIds",
        "expectedObservation"
      ],
      "properties": {
        "fixtureId": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "edgeIds": { "$ref": "#/$defs/idSet" },
        "implementationBranchIds": { "$ref": "#/$defs/idSet" },
        "enforcementBranchIds": { "$ref": "#/$defs/idSet" },
        "terminalObservedKey": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "actionIds": { "$ref": "#/$defs/actionIdSet" },
        "expectedObservation": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "branchId"],
              "properties": {
                "kind": { "const": "enforcement-branch" },
                "branchId": {
                  "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "edgeId"],
              "properties": {
                "kind": { "const": "target-absence" },
                "edgeId": {
                  "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$"
        },
        "features": { "$ref": "#/$defs/idSet" }
      },
      "additionalProperties": false
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
      }
    },
    "actionIdSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
      }
    }
  }
}
