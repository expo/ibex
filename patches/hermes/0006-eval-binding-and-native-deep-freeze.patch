+/// @ref LLP 0013#mechanism-1 (Phase 3) — native transitive deep-freeze. Freezes
+/// the object graph reachable from \p obj, SES-style: each object is frozen
+/// (shallow, via JSObject::freeze) and the walk recurses through property
+/// *descriptors* — data values and accessor getter/setter functions, read
+/// WITHOUT invoking getters — plus the prototype. Cycles and shared subgraphs
+/// are handled by the isFrozen guard (freeze-before-recurse), with a depth bound
+/// as a backstop. Lets the boot-time lockdown do the whole intrinsics freeze in
+/// native code instead of a JS graph walk.
+static ExecutionStatus
+exactDeepFreezeRec(Runtime &runtime, Handle<JSObject> obj, unsigned depth) {
+  if (JSObject::isFrozen(createPseudoHandle(obj.get()), runtime))
+    return ExecutionStatus::RETURNED;
+  if (LLVM_UNLIKELY(
+          JSObject::freeze(obj, runtime) == ExecutionStatus::EXCEPTION))
+    return ExecutionStatus::EXCEPTION;
+  if (depth >= 512)
+    return ExecutionStatus::RETURNED;
+  GCScope gcScope{runtime};
+  auto keysRes = JSObject::getOwnPropertyKeys(
+      obj,
+      runtime,
+      OwnKeysFlags()
+          .plusIncludeSymbols()
+          .plusIncludeNonSymbols()
+          .plusIncludeNonEnumerable());
+  if (LLVM_UNLIKELY(keysRes == ExecutionStatus::EXCEPTION))
+    return ExecutionStatus::EXCEPTION;
+  Handle<JSArray> keys = *keysRes;
+  uint32_t len = JSArray::getLength(*keys, runtime);
+  MutableHandle<> keyHandle{runtime};
+  MutableHandle<> valueOrAccessor{runtime};
+  MutableHandle<JSObject> child{runtime};
+  GCScopeMarkerRAII marker{runtime};
+  for (uint32_t i = 0; i < len; ++i) {
+    marker.flush();
+    keyHandle = keys->at(runtime, i).unboxToHV(runtime);
+    ComputedPropertyDescriptor desc;
+    auto found = JSObject::getOwnComputedDescriptor(
+        obj, runtime, keyHandle, desc, valueOrAccessor);
+    if (LLVM_UNLIKELY(found == ExecutionStatus::EXCEPTION)) {
+      runtime.clearThrownValue();
+      continue;
+    }
+    if (!*found)
+      continue;
+    if (desc.flags.accessor) {
+      auto *accessor = vmcast<PropertyAccessor>(valueOrAccessor.getHermesValue());
+      if (Callable *g = accessor->getter.get(runtime)) {
+        child = g;
+        if (exactDeepFreezeRec(runtime, child, depth + 1) ==
+            ExecutionStatus::EXCEPTION)
+          return ExecutionStatus::EXCEPTION;
+      }
+      if (Callable *s = accessor->setter.get(runtime)) {
+        child = s;
+        if (exactDeepFreezeRec(runtime, child, depth + 1) ==
+            ExecutionStatus::EXCEPTION)
+          return ExecutionStatus::EXCEPTION;
+      }
+    } else {
+      HermesValue v = valueOrAccessor.getHermesValue();
+      if (v.isObject()) {
+        child = vmcast<JSObject>(v);
+        if (exactDeepFreezeRec(runtime, child, depth + 1) ==
+            ExecutionStatus::EXCEPTION)
+          return ExecutionStatus::EXCEPTION;
+      }
+    }
+  }
+  if (JSObject *proto = obj->getParent(runtime)) {
+    child = proto;
+    if (exactDeepFreezeRec(runtime, child, depth + 1) ==
+        ExecutionStatus::EXCEPTION)
+      return ExecutionStatus::EXCEPTION;
+  }
+  return ExecutionStatus::RETURNED;
+}
+
+CallResult<HermesValue> exactDeepFreeze(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  Handle<JSObject> obj = args.dyncastArg<JSObject>(0);
+  if (obj) {
+    if (LLVM_UNLIKELY(
+            exactDeepFreezeRec(runtime, obj, 0) == ExecutionStatus::EXCEPTION))
+      return ExecutionStatus::EXCEPTION;
+  }
+  return args.getArg(0);
+}
