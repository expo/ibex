  "decisionStrata": [
    {
      "id": "arm-validity",
      "scope": "arming",
      "cases": [
        {
          "when": "profile-digest-target-or-structure-mismatch",
          "outcome": "refuse-arming"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "attribution",
      "scope": "effect",
      "cases": [
        {
          "when": "no-user-missing-or-ambiguous-attribution",
          "outcome": "deny"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "lifecycle-and-target-closure",
      "scope": "effect",
      "cases": [
        {
          "when": "incomplete-or-unadvertised-target-cell",
          "outcome": "refuse-arming"
        },
        { "when": "deny-only-planned-or-closed-cell", "outcome": "deny" }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "protected-resource-guards",
      "scope": "effect",
      "cases": [
        {
          "when": "protected-object-or-always-denied-peer-match",
          "outcome": "deny"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "process-ceiling",
      "scope": "effect",
      "cases": [
        { "when": "bounded-ceiling-does-not-contain-effect", "outcome": "deny" }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "root-authority-ceiling",
      "scope": "principal",
      "cases": [
        {
          "when": "principal-is-authenticated-root-and-bounded-root-ceiling-does-not-contain-effect",
          "outcome": "deny"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "principal-denial",
      "scope": "principal",
      "cases": [
        { "when": "principal-denial-contains-effect", "outcome": "deny" }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "revocation-negative-generation",
      "scope": "principal",
      "cases": [
        { "when": "source-revoked-or-generation-stale", "outcome": "deny" }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "quarantine-deny",
      "scope": "principal",
      "cases": [{ "when": "principal-is-quarantine", "outcome": "deny" }],
      "defaultOutcome": "continue"
    },
    {
      "id": "definition-and-edge-positive-predicates",
      "scope": "effect",
      "cases": [
        {
          "when": "normalization-or-positive-predicate-fails",
          "outcome": "deny"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "bootstrap-floor",
      "scope": "principal",
      "cases": [
        {
          "when": "bootstrap-phase-token-is-live-and-bootstrap-floor-contains-root-effect",
          "outcome": "allow-principal"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "static-floor",
      "scope": "principal",
      "cases": [
        { "when": "static-floor-contains-effect", "outcome": "allow-principal" }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "bearer-handle",
      "scope": "principal",
      "cases": [
        {
          "when": "valid-possessed-handle-contains-effect",
          "outcome": "allow-principal"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "dynamic-session",
      "scope": "principal",
      "cases": [
        {
          "when": "valid-session-grant-within-static-ceiling-contains-effect",
          "outcome": "allow-principal"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "implicit-package-self",
      "scope": "principal",
      "cases": [
        {
          "when": "generated-package-self-rule-contains-effect",
          "outcome": "allow-principal"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "ambient-root",
      "scope": "principal",
      "cases": [
        {
          "when": "principal-is-authenticated-root",
          "outcome": "allow-principal"
        }
      ],
      "defaultOutcome": "continue"
    },
    {
      "id": "missing-authority-mode",
      "scope": "principal",
      "cases": [
        {
          "when": "workflow-is-diagnostic-audit",
          "outcome": "allow-principal-with-would-deny-evidence"
        },
        { "when": "workflow-is-production-enforce", "outcome": "deny" }
      ],
      "defaultOutcome": "deny"
    }
  ],
