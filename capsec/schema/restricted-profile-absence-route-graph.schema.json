{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-absence-route-graph.schema.json",
  "title": "Ibex restricted-profile executable absence route graph",
  "type": "object",
  "required": [
    "routeGraphSchema",
    "profile",
    "target",
    "authorityDigests",
    "counts",
    "sourceFiles",
    "sourceBindings",
    "topology",
    "routes"
  ],
  "properties": {
    "routeGraphSchema": { "const": "ibex/restricted-profile-absence-route-graph/2" },
    "profile": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "authorityDigests": {
      "type": "object",
      "required": ["projection", "coverage", "implementationManifest", "rootGlobalManifest", "probePlan"],
      "properties": {
        "projection": { "$ref": "#/$defs/digest" },
        "coverage": { "$ref": "#/$defs/digest" },
        "implementationManifest": { "$ref": "#/$defs/digest" },
        "rootGlobalManifest": { "$ref": "#/$defs/digest" },
        "probePlan": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["edges", "routes", "sourceFiles", "sourceBindings", "liveProbeBindings"],
      "properties": {
        "edges": { "type": "integer", "minimum": 1 },
        "routes": { "type": "integer", "minimum": 1 },
        "sourceFiles": { "type": "integer", "minimum": 1 },
        "sourceBindings": { "type": "integer", "minimum": 1 },
        "liveProbeBindings": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "rawContentDigest"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "rawContentDigest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceBinding" }
    },
    "topology": {
      "type": "object",
      "required": ["sourceSpans", "sourceSites", "nodes", "edges", "branchPaths"],
      "properties": {
        "sourceSpans": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/$defs/sourceSpan" }
        },
        "sourceSites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceSite" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edge" }
        },
        "branchPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branchPath" }
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "repoPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stableId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
    "sourceSpan": {
      "type": "object",
      "required": ["spanId", "path", "startToken", "endToken", "startByte", "endByte", "startLine", "endLine", "rawContentDigest"],
      "properties": {
        "spanId": { "$ref": "#/$defs/stableId" },
        "path": { "$ref": "#/$defs/repoPath" },
        "startToken": { "type": "string", "minLength": 1 },
        "endToken": { "type": "string", "minLength": 1 },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "sourceSite": {
      "type": "object",
      "required": ["siteId", "path", "role", "startByte", "endByte", "startLine", "endLine", "rawContentDigest"],
      "properties": {
        "siteId": { "$ref": "#/$defs/stableId" },
        "path": { "$ref": "#/$defs/repoPath" },
        "role": { "enum": ["alias", "branch-selector", "definition", "dispatch", "guard", "identity-authority", "lazy-trigger", "publication", "registration", "retention", "selector", "symbol-provenance", "value-producer"] },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "producerPath": {
      "type": "object",
      "required": ["pathId", "conditionId", "requiredSiteIds"],
      "properties": {
        "pathId": { "$ref": "#/$defs/stableId" },
        "conditionId": { "type": "string", "minLength": 1 },
        "requiredSiteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "sourceBinding": {
      "type": "object",
      "required": ["bindingId", "branchId", "sourceRef", "path", "locator", "rawContentDigest", "locatorKind", "resolutionPolicy", "siteIds", "producerPaths", "refusalPaths"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/stableId" },
        "branchId": { "$ref": "#/$defs/stableId" },
        "sourceRef": { "type": "string", "minLength": 3 },
        "path": { "$ref": "#/$defs/repoPath" },
        "locator": { "type": "string", "minLength": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" },
        "locatorKind": { "type": "string", "minLength": 1 },
        "resolutionPolicy": { "type": "string", "minLength": 1 },
        "siteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "producerPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/producerPath" }
        },
        "refusalPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/producerPath" }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["nodeId", "kind"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["attacker-root", "instrumented-cutset", "target-selection", "route-condition", "source-site", "terminal"] },
        "sourceSpanId": { "$ref": "#/$defs/stableId" },
        "observationId": { "$ref": "#/$defs/stableId" },
        "edgeId": { "$ref": "#/$defs/stableId" },
        "branchId": { "$ref": "#/$defs/stableId" },
        "observedIdentity": { "type": "string", "minLength": 1 },
        "attackerRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pathId": { "$ref": "#/$defs/stableId" },
        "conditionId": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["producer", "refusal"] },
        "sourceSiteId": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "type": "string", "pattern": "^family\\.[a-f0-9]{20}$" },
        { "$ref": "#/$defs/stableId" },
        { "$ref": "#/$defs/stableId" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["source-selection", "live-reachability"] }
        },
        { "enum": ["call", "select", "register", "alias", "expose", "retain", "lazy-activate", "descriptor-child", "dispatch"] },
        { "type": "string", "pattern": "^(?:span|site):[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
        {
          "type": ["string", "null"],
          "pattern": "^(?:condition|node):.+$"
        }
      ],
      "items": false
    },
    "terminal": {
      "type": "object",
      "required": ["edgeId", "branchId", "nodeId", "liveProbeIds"],
      "properties": {
        "edgeId": { "$ref": "#/$defs/stableId" },
        "branchId": { "$ref": "#/$defs/stableId" },
        "nodeId": { "$ref": "#/$defs/stableId" },
        "liveProbeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "branchImplementationPath": {
      "type": "object",
      "required": ["pathId", "conditionId", "disposition", "pathNodeId", "siteNodeIds"],
      "properties": {
        "pathId": { "$ref": "#/$defs/stableId" },
        "conditionId": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["producer", "refusal"] },
        "pathNodeId": { "$ref": "#/$defs/stableId" },
        "siteNodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "branchPath": {
      "type": "object",
      "required": ["branchId", "edgeId", "observedIdentity", "routeFamily", "sourceRoot", "liveRoot", "sourceCutsets", "liveCutsets", "branchNodeId", "terminalNodeId", "liveProbeIds", "paths"],
      "properties": {
        "branchId": { "$ref": "#/$defs/stableId" },
        "edgeId": { "$ref": "#/$defs/stableId" },
        "observedIdentity": { "type": "string", "minLength": 1 },
        "routeFamily": { "type": "string", "pattern": "^family\\.[a-f0-9]{20}$" },
        "sourceRoot": { "$ref": "#/$defs/stableId" },
        "liveRoot": { "$ref": "#/$defs/stableId" },
        "sourceCutsets": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "liveCutsets": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "branchNodeId": { "$ref": "#/$defs/stableId" },
        "terminalNodeId": { "$ref": "#/$defs/stableId" },
        "liveProbeIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/branchImplementationPath" }
        }
      },
      "additionalProperties": false
    },
    "routePath": {
      "type": "object",
      "required": ["pathId", "nodes"],
      "properties": {
        "pathId": { "$ref": "#/$defs/stableId" },
        "nodes": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["observationId", "lastObservedNode", "blockedEdge"],
      "properties": {
        "observationId": { "$ref": "#/$defs/stableId" },
        "lastObservedNode": { "$ref": "#/$defs/stableId" },
        "blockedEdge": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/stableId" },
            "to": { "$ref": "#/$defs/stableId" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "routeId", "edgeId", "sourceProbeId", "branchId", "observedIdentity",
        "liveProbeIds", "targetApplicability", "applicability", "sourceBindingIds",
        "branchPathId", "sourceBoundary", "liveBoundary",
        "sourceCutsetObservationIds", "liveCutsetObservationIds"
      ],
      "properties": {
        "routeId": { "$ref": "#/$defs/stableId" },
        "edgeId": { "$ref": "#/$defs/stableId" },
        "sourceProbeId": { "$ref": "#/$defs/stableId" },
        "branchId": { "$ref": "#/$defs/stableId" },
        "observedIdentity": { "type": "string", "minLength": 3 },
        "liveProbeIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "targetApplicability": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["all", "build-condition", "fallback", "linux-backend", "operating-system", "operating-system-family", "runtime-variant"] },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "applicability": {
          "type": "object",
          "required": ["classification", "reason"],
          "properties": {
            "classification": { "enum": ["selected", "platform-excluded", "compiled-but-disabled", "runtime-disabled"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "sourceBindingIds": {
          "type": "array", "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "branchPathId": { "type": "string", "pattern": "^family\\.[a-f0-9]{20}$" },
        "sourceBoundary": { "$ref": "#/$defs/boundary" },
        "liveBoundary": { "$ref": "#/$defs/boundary" },
        "sourceCutsetObservationIds": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "liveCutsetObservationIds": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    }
  }
}
