{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/module-carrier-v2.schema.json",
  "title": "Ibex Prepared Module Carrier v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "encoding",
    "carrierDigest",
    "definingPrincipal",
    "producerId",
    "producerBinaryDigest",
    "deploymentGraphDigest",
    "entries"
  ],
  "properties": {
    "schema": { "const": "ibex/module-carrier/2" },
    "encoding": { "$ref": "#/$defs/encoding" },
    "carrierDigest": { "$ref": "#/$defs/digest" },
    "definingPrincipal": { "$ref": "#/$defs/principal" },
    "producerId": { "$ref": "#/$defs/nonEmpty" },
    "producerBinaryDigest": { "$ref": "#/$defs/digest" },
    "deploymentGraphDigest": { "$ref": "#/$defs/digest" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "engineBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binaryDigest"],
          "properties": {
            "kind": { "const": "loaded-file" },
            "binaryDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "compatibilityIdentity"],
          "properties": {
            "kind": { "const": "static-compatibility" },
            "compatibilityIdentity": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "encoding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "javascript-factory-table" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "engineBinding", "bytecodeVersion"],
          "properties": {
            "kind": { "const": "hermes-bytecode" },
            "engineBinding": { "$ref": "#/$defs/engineBinding" },
            "bytecodeVersion": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "principal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "integrity", "locator"],
          "properties": {
            "kind": { "const": "package" },
            "name": { "$ref": "#/$defs/nonEmpty" },
            "integrity": { "$ref": "#/$defs/digest" },
            "locator": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity"],
          "properties": {
            "kind": {
              "enum": ["root", "runtime", "module-loader", "quarantine"]
            },
            "identity": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "semantics", "semanticDigest"],
      "properties": {
        "entryId": { "$ref": "#/$defs/nonEmpty" },
        "semantics": {
          "$ref": "module-artifact-v1.schema.json#/$defs/semantics"
        },
        "semanticDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
