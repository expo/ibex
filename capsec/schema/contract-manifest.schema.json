{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/contract-manifest.schema.json",
  "title": "Ibex capsec checked file manifest",
  "type": "object",
  "required": ["manifestSchema", "schemas", "registries", "examples", "invalidFixtures", "generated"],
  "properties": {
    "manifestSchema": { "const": "ibex/capsec-contract-files/1" },
    "schemas": { "$ref": "#/$defs/pathSet" },
    "registries": { "$ref": "#/$defs/pathSet" },
    "examples": { "$ref": "#/$defs/pathSet" },
    "invalidFixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "validator"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "validator": {
            "enum": ["strict-json", "selector", "occurrence", "effect-set", "armed-snapshot"]
          }
        },
        "additionalProperties": false
      }
    },
    "generated": { "$ref": "#/$defs/pathSet" }
  },
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "pattern": "^[a-z0-9._/-]+$" },
    "pathSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    }
  }
}
