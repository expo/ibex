# CapSec digests and generated drift checks are byte-sensitive. Pin every
# contract artifact and cross-language generated binding to LF so a Windows
# checkout cannot be clean in Git while differing from the canonical bytes.
capsec/** text eol=lf
packages/ibex-runtime-js/src/security/capsec-registry.generated.ts text eol=lf
src/builtins/helpers/capsec-registry.generated.cjs text eol=lf
src/capsec_registry_generated.rs text eol=lf
src/engine/capsec_registry_generated.h text eol=lf
src/capsec_runtime_projection_generated.rs text eol=lf
src/compiled_environment_profile_generated.rs text eol=lf
src/identity_generated.rs text eol=lf
src/module_loader/transform_config_generated.rs text eol=lf
config/oxc-retirement-manifest.json text eol=lf
vendored-generated/** text eol=lf

# Rust golden tests hash these fixture bytes and compare canonical JSON text.
# Keep their sources and expected artifacts identical on Windows checkouts.
tests/fixtures/computed-candidates-v1.golden.json text eol=lf
tests/fixtures/module-runner-spike/** text eol=lf

# Archived LLP evidence and its independently checked-in inputs are hashed as
# exact bytes; preserve their canonical identity on Windows checkouts.
# @ref LLP 0024#31-post-retirement-oxc-handoff — the parser differential is a
# content-addressed cutover report bound to its projection and corpus.
llp/evidence/** text eol=lf
config/llp0024-parser-differential-projection.json text eol=lf
tests/fixtures/llp0024-parser-differential/** text eol=lf

# Checked example policies authenticate their complete source trees and compare
# the rendered artifact byte-for-byte. Keep those portable-v1 authorities
# canonical across Git checkout platforms.
# @ref LLP 0014#the-generated-artifact — one reviewed policy binds exact source
# integrity and must not drift solely because Git selected CRLF on Windows.
examples/llp0013-supply-chain/** text eol=lf
examples/capsec-demo/01-supply-chain/** text eol=lf
examples/capsec-demo/02-least-privilege/** text eol=lf
examples/capsec-demo/04-defense-in-depth/** text eol=lf

# Evaluator identity review hashes these checked-in bytes. Keep a Windows
# checkout byte-identical to the reviewed LF source and patch authorities.
patches/hermes/*.patch text eol=lf
scripts/hermes-version.sh text eol=lf
scripts/apply-hermes-patches.sh text eol=lf
scripts/build-hermes.sh text eol=lf
scripts/build-hermes-linux.sh text eol=lf
# The exact-target prerequisite matrix invokes these through Git Bash on
# Windows; CRLF would become part of shell tokens and invalidate the evidence.
scripts/run-tests.sh text eol=lf
scripts/test-android-java.sh text eol=lf
scripts/check-generated-drift.sh text eol=lf
src/engine/hermes_runtime.cc text eol=lf

# The vendored-runtime fingerprint hashes these source bytes directly. Keep
# every authority byte-identical across checkouts so the hermetic build's
# content check is genuinely portable to Windows.
src/builtins/** text eol=lf
src/engine/bootstrap/web-streams-polyfill.js text eol=lf
packages/ibex-runtime-js/src/** text eol=lf
modules.ts text eol=lf
