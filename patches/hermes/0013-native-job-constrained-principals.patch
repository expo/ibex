+static CallResult<HermesValue> getPromisePropertyWithConstrainedPrincipals(
+    Runtime &runtime,
+    const char *propertyName) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  auto object = args.dyncastArg<JSObject>(0);
+  if (!object) {
+    return runtime.raiseTypeError(
+        "First argument to constrained Promise property Get must be an object");
+  }
+  auto propertySymbol = symbolForCStr(runtime, propertyName);
+  if (LLVM_UNLIKELY(propertySymbol == ExecutionStatus::EXCEPTION)) {
+    return ExecutionStatus::EXCEPTION;
+  }
+
+  auto merged = captureJobConstrainedPrincipals(runtime);
+  bool valid = true;
+  appendJobConstrainedPrincipalsToken(
+      runtime, args, 1, false, merged, valid);
+
+  const auto previous = runtime.embedderJobConstrainedPrincipals();
+  runtime.setEmbedderJobConstrainedPrincipals(
+      std::make_shared<const std::vector<uint32_t>>(std::move(merged)));
+  auto getResult =
+      JSObject::getNamed_RJS(object, runtime, **propertySymbol);
+  runtime.setEmbedderJobConstrainedPrincipals(previous);
+  return getResult.toCallResultHermesValue();
+}
