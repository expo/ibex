+bool HermesRuntimeImpl::getSafeStage1Text(
+    const jsi::Value &value,
+    std::string &text,
+    bool &truncated) {
+  text.clear();
+  truncated = false;
+  if (!value.isString() && !value.isSymbol() && !value.isBigInt())
+    return false;
+
+  vm::GCScope gcScope(runtime_);
+  vm::PinnedHermesValue valueStorage;
+  auto valueHandle = vmHandleFromValue(value, &valueStorage);
+  if (valueHandle->isString()) {
+    auto stringHandle = runtime_.makeHandle(valueHandle->getString());
+    text = boundedUTF8FromStringView(
+        vm::StringPrimitive::createStringView(runtime_, stringHandle),
+        kMaximumSafeTextBytes,
+        truncated);
+    return true;
+  }
+
+  if (valueHandle->isSymbol()) {
+    auto *description =
+        runtime_.getStringPrimFromSymbolID(valueHandle->getSymbol());
+    if (description == runtime_.strForSymbolNoDescription.get()) {
+      text = "Symbol()";
+      return true;
+    }
+    constexpr size_t kSymbolWrapperBytes = sizeof("Symbol()") - 1;
+    auto descriptionHandle = runtime_.makeHandle(description);
+    auto boundedDescription = boundedUTF8FromStringView(
+        vm::StringPrimitive::createStringView(runtime_, descriptionHandle),
+        kMaximumSafeTextBytes - kSymbolWrapperBytes,
+        truncated);
+    if (truncated) {
+      assert(llvh::StringRef{boundedDescription}.endswith(
+          kSafeTextTruncationMarker));
+      boundedDescription.resize(
+          boundedDescription.size() - kSafeTextTruncationMarkerBytes);
+    }
+    text.reserve(sizeof("Symbol(") - 1 + boundedDescription.size() + 1);
+    text = "Symbol(";
+    text += boundedDescription;
+    text.push_back(')');
+    if (truncated)
+      text.append(kSafeTextTruncationMarker);
+    return true;
+  }
+
+  // The full-storage span exposes its byte count in constant time. Converting
+  // at most 4096 bytes remains below the public text bound; larger values
+  // return the trusted opaque marker without materializing an attacker-sized
+  // decimal string.
+  constexpr size_t kMaximumConvertedBigIntBytes = 4096;
+  auto *bigInt = valueHandle->getBigInt();
+  if (bigInt->getRawDataFull().size() > kMaximumConvertedBigIntBytes) {
+    text = kSafeTextTruncationMarker;
+    truncated = true;
+    return true;
+  }
+  auto converted = vm::BigIntPrimitive::toString(
+      runtime_, vm::createPseudoHandle(bigInt), 10);
+  checkStatus(converted.getStatus());
+  auto convertedHandle = runtime_.makeHandle(converted->getString());
+  text = boundedUTF8FromStringView(
+      vm::StringPrimitive::createStringView(runtime_, convertedHandle),
+      kMaximumSafeTextBytes,
+      truncated);
+  return true;
+}
+
+SafeJSErrorClass HermesRuntimeImpl::getSafeJSErrorMetadata(
+    const jsi::Value &value,
+    std::string &message,
+    std::string &stack,
+    bool &messageTruncated,
+    bool &stackTruncated) {
+  message.clear();
+  stack.clear();
+  messageTruncated = false;
+  stackTruncated = false;
+  if (!value.isObject())
+    return SafeJSErrorClass::Unclassified;
+
+  vm::GCScope gcScope(runtime_);
+  vm::PinnedHermesValue valueStorage;
+  auto valueHandle = vmHandleFromValue(value, &valueStorage);
+  auto error = vm::Handle<vm::JSError>::dyn_vmcast(valueHandle);
+  if (!error)
+    return SafeJSErrorClass::Unclassified;
+
+  // Classify only by the JSError's internal direct-prototype pointer. This
+  // does not invoke Proxy traps, consult a replaceable `.constructor`/`.name`,
+  // or walk a user-controlled prototype chain. Subclasses with their own
+  // direct prototype deliberately remain Unclassified.
+  SafeJSErrorClass errorClass = SafeJSErrorClass::Unclassified;
+  auto *directPrototype = error->getParent(runtime_);
+#define ALL_ERROR_TYPE(name)                                            \
+  if (directPrototype ==                                                \
+      vm::Handle<vm::JSObject>::vmcast(&runtime_.name##Prototype).get()) \
+    errorClass = SafeJSErrorClass::name;
+#include "hermes/VM/NativeErrorTypes.def"
+
+  // The Error constructor creates `message` as an own data property. Read the
+  // slot only when it is still a plain string data property; never invoke a
+  // replacement accessor or walk a user-controlled prototype.
+  vm::NamedPropertyDescriptor messageDescriptor;
+  if (vm::JSObject::getOwnNamedDescriptor(
+          error,
+          runtime_,
+          vm::Predefined::getSymbolID(vm::Predefined::message),
+          messageDescriptor) &&
+      !messageDescriptor.flags.accessor &&
+      !messageDescriptor.flags.proxyObject &&
+      !messageDescriptor.flags.hostObject) {
+    auto messageValue = vm::JSObject::getNamedSlotValueUnsafe(
+                            error.get(), runtime_, messageDescriptor)
+                            .unboxToHV(runtime_);
+    if (messageValue.isString()) {
+      auto messageHandle = runtime_.makeHandle(messageValue.getString());
+      message = boundedUTF8FromStringView(
+          vm::StringPrimitive::createStringView(runtime_, messageHandle),
+          kMaximumSafeTextBytes,
+          messageTruncated);
+    }
+  }
+
+  const vm::StackTrace *frames = error->getStackTrace();
+  if (!frames)
+    return errorClass;
+  constexpr size_t kMaximumSafeFrames = 100;
+  const size_t count = std::min(frames->size(), kMaximumSafeFrames);
+  for (size_t index = 0; index < count; ++index) {
+    if (!stack.empty() && !appendBoundedUTF8(stack, "\n", stackTruncated))
+      break;
+    if (!appendBoundedUTF8(stack, "    at ", stackTruncated))
+      break;
+    const auto &frame = frames->at(index);
+    if (const auto *bytecode =
+            std::get_if<vm::BytecodeStackTraceInfo>(&frame)) {
+      if (!bytecode->codeBlock) {
+        if (!appendBoundedUTF8(stack, "<native>", stackTruncated))
+          break;
+        continue;
+      }
+      auto *provider =
+          bytecode->codeBlock->getRuntimeModule()->getBytecode();
+      const auto functionName = provider->getStringTableEntry(
+          bytecode->codeBlock->getFunctionHeader().getFunctionName());
+      if (!appendBoundedStringTableEntry(
+              stack,
+              functionName,
+              provider->getStringStorage(),
+              stackTruncated) ||
+          !appendBoundedUTF8(stack, " (", stackTruncated))
+        break;
+      auto location = vm::JSError::getDebugInfo(
+          bytecode->codeBlock, bytecode->bytecodeOffset);
+      if (location) {
+        const auto *debugInfo = provider->getDebugInfo();
+        const auto filenameTable = debugInfo->getFilenameTable();
+        assert(location->filenameId < filenameTable.size());
+        if (!appendBoundedStringTableEntry(
+                stack,
+                filenameTable[location->filenameId],
+                debugInfo->getFilenameStorage(),
+                stackTruncated) ||
+            !appendBoundedUTF8(stack, ":", stackTruncated) ||
+            !appendBoundedUTF8(
+                stack, std::to_string(location->line), stackTruncated) ||
+            !appendBoundedUTF8(stack, ":", stackTruncated) ||
+            !appendBoundedUTF8(
+                stack, std::to_string(location->column), stackTruncated))
+          break;
+      } else {
+        auto sourceURL =
+            bytecode->codeBlock->getRuntimeModule()->getSourceURL();
+        if (!appendBoundedUTF8(
+                stack,
+                sourceURL.empty() ? llvh::StringRef{"unknown"} : sourceURL,
+                stackTruncated))
+          break;
+      }
+      if (!appendBoundedUTF8(stack, ")", stackTruncated))
+        break;
+    } else {
+      if (!appendBoundedUTF8(stack, "<native>", stackTruncated))
+        break;
+    }
+  }
+  if (frames->size() > count && !stackTruncated) {
+    (void)appendBoundedUTF8(stack, "\n    ", stackTruncated);
+    finishBoundedTruncation(stack, stackTruncated);
+  }
+  return errorClass;
+}
