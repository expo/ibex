+/// Enqueue a Promise reaction under the union of its current scheduling
+/// context, settlement context, and handler-registration context. Tokens are
+/// produced only by the internal capture method above; malformed inputs still
+/// collapse to the fail-closed no-user sentinel.
+CallResult<HermesValue>
+hermesInternalEnqueueJobWithConstrainedPrincipals(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  auto callable = args.dyncastArg<Callable>(0);
+  if (!callable) {
+    return runtime.raiseTypeError(
+        "First argument to constrained enqueueJob must be callable");
+  }
+
+  auto merged = captureJobConstrainedPrincipals(runtime);
+  bool valid = true;
+  for (uint32_t argument = 1; argument <= 2; ++argument) {
+    appendJobConstrainedPrincipalsToken(
+        runtime, args, argument, false, merged, valid);
+  }
+
+  const auto previous = runtime.embedderJobConstrainedPrincipals();
+  runtime.setEmbedderJobConstrainedPrincipals(
+      std::make_shared<const std::vector<uint32_t>>(std::move(merged)));
+  runtime.enqueueJob(callable.get());
+  runtime.setEmbedderJobConstrainedPrincipals(previous);
+  return HermesValue::encodeUndefinedValue();
+}
