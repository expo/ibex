{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/portable-engine-source-tree-identity-v1.schema.json",
  "title": "Ibex portable engine source-tree identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "sourceRevision",
    "sourceRef",
    "gitObjectFormat",
    "sourceRevisionObjectType",
    "sourceRevisionObjectContent",
    "treeObjectId",
    "treeObjectType",
    "treeObjectContent"
  ],
  "properties": {
    "schema": { "const": "ibex/portable-engine-source-tree-identity/1" },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "sourceRevision": {
      "$ref": "portable-engine-common-v1.schema.json#/$defs/sourceRevision"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^refs/(?:heads|tags)/[^\\u0000-\\u001F\\u007F]+$"
    },
    "gitObjectFormat": { "enum": ["sha1", "sha256"] },
    "sourceRevisionObjectType": { "const": "commit" },
    "sourceRevisionObjectContent": {
      "allOf": [
        { "$ref": "#/$defs/rawObjectContent" },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "META-INF/authority/source-tree/commit.content"
            }
          }
        }
      ]
    },
    "treeObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "treeObjectType": { "const": "tree" },
    "treeObjectContent": {
      "allOf": [
        { "$ref": "#/$defs/rawObjectContent" },
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "META-INF/authority/source-tree/tree.content"
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "gitObjectFormat": { "const": "sha1" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    {
      "properties": {
        "gitObjectFormat": { "const": "sha256" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "treeObjectId": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  ],
  "$defs": {
    "rawObjectContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "size", "encoding"],
      "properties": {
        "path": {
          "$ref": "portable-engine-common-v1.schema.json#/$defs/normalizedPayloadPath"
        },
        "digest": {
          "$ref": "portable-engine-common-v1.schema.json#/$defs/rawDigest"
        },
        "size": {
          "$ref": "portable-engine-common-v1.schema.json#/$defs/safeInteger"
        },
        "encoding": { "const": "raw-uncompressed-git-object-content" }
      }
    }
  }
}
