{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/armed-snapshot.schema.json",
  "title": "Ibex immutable capsec armed snapshot",
  "type": "object",
  "required": [
    "snapshotSchema",
    "capsVocab",
    "semanticCore",
    "vocabDigest",
    "registryDigest",
    "policyDigest",
    "armedSnapshotDigest",
    "workflow",
    "effectiveMode",
    "engine",
    "runNonce",
    "channelEpoch",
    "rootIdentity",
    "entry",
    "projectRootDiscovery",
    "packageGraph",
    "rootBindings",
    "pathCanonicalizers",
    "principals",
    "environmentBase",
    "bootstrapCompatibilityModes",
    "processAuthorityCeiling",
    "rootAuthorityCeiling",
    "bootstrapAuthorityFloor",
    "generations",
    "protectedObjects",
    "networkPosture",
    "structuralPosture"
  ],
  "properties": {
    "snapshotSchema": { "const": "ibex/capsec-armed/1" },
    "capsVocab": { "const": "ibex/capsec/1" },
    "semanticCore": { "const": "capsec/semantics/1" },
    "vocabDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "registryDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "armedSnapshotDigest": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
    },
    "workflow": { "enum": ["production", "diagnostic-audit", "contract-fixture"] },
    "effectiveMode": { "enum": ["enforce", "audit"] },
    "engine": {
      "type": "object",
      "required": ["target", "binaryDigest", "features"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$"
        },
        "binaryDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "exactEmbedder": {
      "type": "object",
      "required": ["schema", "operationManifestDigest", "endowments"],
      "properties": {
        "schema": { "const": "exact/host-operation-endowments/1" },
        "operationManifestDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "endowments": {
          "type": "object",
          "required": ["app", "agentIsolate", "uiWorklet"],
          "properties": {
            "app": { "$ref": "#/$defs/exactOperationEndowment" },
            "agentIsolate": { "$ref": "#/$defs/exactOperationEndowment" },
            "uiWorklet": { "$ref": "#/$defs/exactOperationEndowment" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensions": {
      "$ref": "#/$defs/runtimeExtensionAuthorityCapsule"
    },
    "runNonce": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/base64url"
    },
    "channelEpoch": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "rootIdentity": { "$ref": "#/$defs/rootPrincipal" },
    "entry": { "$ref": "#/$defs/entry" },
    "projectRootDiscovery": { "$ref": "#/$defs/projectRootDiscovery" },
    "devServedProjectRoot": {
      "description": "Explicit dev-project root paired with the dev-served bootstrap compatibility mode.",
      "$ref": "#/$defs/absoluteHostPath"
    },
    "packageGraph": { "$ref": "#/$defs/packageGraph" },
    "rootBindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rootBinding" }
    },
    "pathCanonicalizers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathCanonicalizer" }
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/principalAuthority" }
    },
    "environmentBase": {
      "description": "Explicitly empty armed session environment base. Values exist only in exact-name principal overlays admitted by the principal authority rows.",
      "type": "array",
      "maxItems": 0
    },
    "bootstrapCompatibilityModes": {
      "description": "Digest-bound, authority-neutral compatibility controls consumed during trusted bootstrap. They are not environment entries and are removed before project code.",
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["bun", "dev-served", "fixture", "fixture:bun"]
      }
    },
    "processAuthorityCeiling": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "unbounded" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "authorities"],
          "properties": {
            "kind": { "const": "bounded" },
            "authorities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rootAuthorityCeiling": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "unbounded" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "authorities"],
          "properties": {
            "kind": { "const": "bounded" },
            "authorities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "bootstrapAuthorityFloor": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
      }
    },
    "generations": {
      "type": "object",
      "required": ["policy", "negative", "dynamic", "handle"],
      "properties": {
        "policy": { "$ref": "#/$defs/generation" },
        "negative": { "$ref": "#/$defs/generation" },
        "dynamic": { "$ref": "#/$defs/generation" },
        "handle": { "$ref": "#/$defs/generation" }
      },
      "additionalProperties": false
    },
    "protectedObjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "object", "deniedActions"],
        "properties": {
          "role": {
            "enum": ["armed-policy", "engine-binary", "exact-operation-manifest", "package-graph", "registry", "runtime-extension-authority-capsule"]
          },
          "object": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
          },
          "embeddedRange": {
            "type": "object",
            "required": ["offset", "length"],
            "properties": {
              "offset": { "$ref": "#/$defs/generation" },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "contentDigest": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
          },
          "deniedActions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["fs:write"] }
          }
        },
        "dependentRequired": {
          "embeddedRange": ["contentDigest"],
          "contentDigest": ["embeddedRange"]
        },
        "additionalProperties": false
      }
    },
    "networkPosture": {
      "type": "object",
      "required": ["routePolicy", "alwaysDeniedPeerClasses"],
      "properties": {
        "routePolicy": { "const": "direct-only-refuse-nondirect-before-io" },
        "alwaysDeniedPeerClasses": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["metadata", "unspecified"] }
        }
      },
      "additionalProperties": false
    },
    "structuralPosture": {
      "type": "object",
      "required": ["lockdown", "frameAttribution", "compartments", "fullDeputyIntersection", "immutableDecisionContext"],
      "properties": {
        "lockdown": { "const": true },
        "frameAttribution": { "const": true },
        "compartments": { "const": true },
        "fullDeputyIntersection": { "const": true },
        "immutableDecisionContext": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "workflow": { "const": "diagnostic-audit" } },
        "required": ["workflow"]
      },
      "then": { "properties": { "effectiveMode": { "const": "audit" } } },
      "else": { "properties": { "effectiveMode": { "const": "enforce" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "runtimeExtensionAuthorityCapsule": {
      "type": "object",
      "required": [
        "schema",
        "authorityCapsuleDigest",
        "target",
        "profile",
        "sdkVersion",
        "runtimeFeatures",
        "extensionSetDigest",
        "declaredExecutableSelectionIdentity",
        "executableSelectionIdentity",
        "descriptors",
        "linkedArtifacts",
        "mappedExecutable"
      ],
      "properties": {
        "schema": {
          "const": "ibex/runtime-extension-authority-capsule/1"
        },
        "authorityCapsuleDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "target": {
          "enum": ["ios", "macos", "windows", "android"]
        },
        "profile": {
          "enum": ["development", "production"]
        },
        "sdkVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "runtimeFeatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "enum": [
              "copied-buffers",
              "introspection",
              "keyed-external-buffers",
              "native-modules",
              "operation-membrane",
              "owner-executor"
            ]
          }
        },
        "extensionSetDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "declaredExecutableSelectionIdentity": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "executableSelectionIdentity": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "descriptors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/runtimeExtensionDescriptor" }
        },
        "linkedArtifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/runtimeExtensionLinkedArtifact" }
        },
        "mappedExecutable": {
          "$ref": "#/$defs/runtimeExtensionMappedExecutable"
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionDescriptor": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sdkVersion",
        "manifestDigest",
        "trustedBootstrap",
        "bootstrap",
        "requiredFeatureBits",
        "globals",
        "modules",
        "callbacks",
        "linkedArtifactIds",
        "authorityFragment"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "version": { "$ref": "#/$defs/runtimeExtensionWireString" },
        "sdkVersion": { "$ref": "#/$defs/runtimeExtensionWireString" },
        "manifestDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "trustedBootstrap": {
          "type": "object",
          "required": ["realm", "installPhase"],
          "properties": {
            "realm": { "const": "app" },
            "installPhase": { "const": "pre-user-code" }
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/runtimeExtensionBootstrapArtifact"
          }
        },
        "requiredFeatureBits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "globals": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "properties": {
              "name": { "$ref": "#/$defs/runtimeExtensionWireString" },
              "kind": { "enum": ["function", "object"] }
            },
            "additionalProperties": false
          }
        },
        "modules": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": ["specifier"],
            "properties": {
              "specifier": { "$ref": "#/$defs/runtimeExtensionWireString" }
            },
            "additionalProperties": false
          }
        },
        "callbacks": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "id",
              "operationId",
              "producerAffinity",
              "delivery",
              "maxPending"
            ],
            "properties": {
              "id": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "operationId": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "producerAffinity": {
                "enum": [
                  "runtime-owner",
                  "background-producer",
                  "provider-thread"
                ]
              },
              "delivery": { "const": "runtime-thread" },
              "maxPending": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              }
            },
            "additionalProperties": false
          }
        },
        "providerAbi": {
          "type": "object",
          "required": [
            "id",
            "minVersion",
            "selectedVersion",
            "structSize",
            "identityDigest",
            "linkedArtifactId"
          ],
          "properties": {
            "id": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
            },
            "minVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "selectedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "structSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "identityDigest": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
            },
            "linkedArtifactId": {
              "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
            }
          },
          "additionalProperties": false
        },
        "linkedArtifactIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        },
        "authorityFragment": {
          "$ref": "#/$defs/runtimeExtensionAuthorityFragment"
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionBootstrapArtifact": {
      "type": "object",
      "required": [
        "id",
        "format",
        "evaluationMode",
        "contentDigest",
        "sourceUrl",
        "byteLength"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "format": {
          "enum": ["source", "hermes-bytecode"]
        },
        "evaluationMode": {
          "const": "script-global"
        },
        "contentDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "sourceUrl": {
          "$ref": "#/$defs/runtimeExtensionWireString"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionAuthorityFragment": {
      "type": "object",
      "required": ["schema", "namespace", "operations"],
      "properties": {
        "schema": {
          "const": "ibex/runtime-extension-authority-fragment/1"
        },
        "namespace": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "operationId",
              "authorityClass",
              "semantics",
              "stage",
              "atomicityGroup",
              "resourceKinds",
              "jsEntryPath",
              "flags"
            ],
            "properties": {
              "operationId": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "authorityClass": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "semantics": {
                "const": "runtime-extension.invoke.authenticated-v1"
              },
              "stage": {
                "enum": [
                  "requested",
                  "discovery",
                  "candidate",
                  "commit",
                  "delivery",
                  "repeat",
                  "cleanup"
                ]
              },
              "atomicityGroup": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "resourceKinds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "uniqueItems": true,
                "items": { "const": "runtime-extension" }
              },
              "jsEntryPath": {
                "$ref": "#/$defs/runtimeExtensionWireString"
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionLinkedArtifact": {
      "type": "object",
      "required": [
        "artifactId",
        "extensionId",
        "executableObject",
        "range",
        "contentDigest"
      ],
      "properties": {
        "artifactId": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "extensionId": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "executableObject": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
        },
        "range": {
          "type": "object",
          "required": ["offset", "length"],
          "properties": {
            "offset": { "$ref": "#/$defs/generation" },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "contentDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionMappedExecutable": {
      "type": "object",
      "required": [
        "schema",
        "executableObject",
        "range",
        "contentDigest",
        "anchors"
      ],
      "properties": {
        "schema": {
          "const": "ibex/runtime-extension-mapped-executable/1"
        },
        "executableObject": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
        },
        "range": {
          "type": "object",
          "required": ["offset", "length"],
          "properties": {
            "offset": { "const": 0 },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "contentDigest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": ["label", "imageOffset"],
            "properties": {
              "label": { "$ref": "#/$defs/runtimeExtensionWireString" },
              "imageOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeExtensionWireString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "projectRootDiscovery": {
      "type": "object",
      "required": [
        "origin",
        "selectedRoot",
        "markerKind",
        "markerPath",
        "markerSetVersion"
      ],
      "properties": {
        "origin": { "$ref": "#/$defs/absoluteHostPath" },
        "selectedRoot": { "$ref": "#/$defs/absoluteHostPath" },
        "markerKind": {
          "enum": [
            "explicit-project",
            "pnpm-workspace",
            "package-workspace",
            "lockfile",
            "package-manifest",
            "origin-fallback"
          ]
        },
        "markerPath": {
          "oneOf": [
            { "$ref": "#/$defs/absoluteHostPath" },
            { "type": "null" }
          ]
        },
        "markerSetVersion": { "const": "ibex/project-root-markers/1" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "markerKind": { "const": "origin-fallback" } },
            "required": ["markerKind"]
          },
          "then": { "properties": { "markerPath": { "type": "null" } } },
          "else": {
            "properties": {
              "markerPath": { "$ref": "#/$defs/absoluteHostPath" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "identity", "mode"],
          "properties": {
            "kind": { "const": "file" },
            "identity": {
              "type": "string",
              "pattern": "^file:///project/(?:[^?#\\u0000]+)$"
            },
            "mode": { "const": "program" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "identity", "mode"],
          "properties": {
            "kind": { "const": "stdin" },
            "identity": { "const": "ibex:stdin" },
            "mode": { "const": "program" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "identity", "mode"],
          "properties": {
            "kind": { "const": "repl" },
            "identity": { "const": "ibex:repl" },
            "mode": { "enum": ["interactive", "transcript"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "identity", "mode"],
          "properties": {
            "kind": { "const": "eval" },
            "identity": { "const": "ibex:eval" },
            "mode": { "const": "one-shot" }
          },
          "additionalProperties": false
        }
      ]
    },
    "exactOperationEndowment": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rootPrincipal": {
      "type": "object",
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "const": "root" },
        "identity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "packagePrincipal": {
      "type": "object",
      "required": ["kind", "name", "integrity", "locator"],
      "properties": {
        "kind": { "const": "package" },
        "name": { "type": "string", "minLength": 1 },
        "integrity": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "locator": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/packageLocator"
        }
      },
      "additionalProperties": false
    },
    "packageGraph": {
      "type": "object",
      "required": ["digest", "nodes", "importEdges"],
      "properties": {
        "digest": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/digest"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["principal"],
            "properties": { "principal": { "$ref": "#/$defs/packagePrincipal" } },
            "additionalProperties": false
          }
        },
        "importEdges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["importer", "imported"],
            "properties": {
              "importer": {
                "oneOf": [
                  { "$ref": "#/$defs/rootPrincipal" },
                  { "$ref": "#/$defs/packagePrincipal" }
                ]
              },
              "imported": { "$ref": "#/$defs/packagePrincipal" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "absoluteHostPath": {
      "allOf": [
        {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/logicalPath"
        },
        {
          "type": "object",
          "required": ["root", "components", "hostBound"],
          "properties": {
            "root": { "const": "absolute" },
            "components": { "type": "array" },
            "hostBound": { "const": true }
          }
        }
      ]
    },
    "rootBinding": {
      "type": "object",
      "required": ["logicalRoot", "hostPath", "object"],
      "properties": {
        "logicalRoot": {
          "enum": ["project", "package", "app", "work", "home", "tmp", "absolute"]
        },
        "owner": { "$ref": "#/$defs/packagePrincipal" },
        "logicalPath": { "$ref": "#/$defs/absoluteHostPath" },
        "hostPath": { "$ref": "#/$defs/absoluteHostPath" },
        "object": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/objectIdentity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "logicalRoot": { "const": "package" } },
            "required": ["logicalRoot"]
          },
          "then": {
            "properties": { "owner": { "$ref": "#/$defs/packagePrincipal" } },
            "required": ["owner"]
          },
          "else": { "not": { "required": ["owner"] } }
        },
        {
          "if": {
            "properties": { "logicalRoot": { "const": "absolute" } },
            "required": ["logicalRoot"]
          },
          "then": {
            "properties": { "logicalPath": { "$ref": "#/$defs/absoluteHostPath" } },
            "required": ["logicalPath"]
          },
          "else": { "not": { "required": ["logicalPath"] } }
        }
      ],
      "additionalProperties": false
    },
    "pathCanonicalizer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["platform", "volume", "identity"],
          "properties": {
            "platform": { "enum": ["unix", "android"] },
            "volume": { "type": "string", "minLength": 1 },
            "identity": { "const": "byte-identity-v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["platform", "volume", "identity"],
          "properties": {
            "platform": { "const": "windows" },
            "volume": { "type": "string", "minLength": 1 },
            "identity": { "const": "windows-ascii-casefold-v1" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["platform", "volume", "identity"],
          "properties": {
            "platform": { "const": "apple" },
            "volume": { "type": "string", "minLength": 1 },
            "identity": {
              "enum": [
                "apple-apfs-unicode9-nfd-v1",
                "apple-apfs-unicode9-safe-casefold-nfd-v1"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "principalAuthority": {
      "type": "object",
      "required": ["principal", "floor", "denials", "escalationCeiling", "imports", "endowments"],
      "properties": {
        "principal": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/principal"
        },
        "floor": {
          "type": "array",
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
          }
        },
        "denials": {
          "type": "array",
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
          }
        },
        "escalationCeiling": {
          "type": "array",
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/authority-selector.schema.json"
          }
        },
        "imports": {
          "type": "object",
          "required": ["builtins", "packages"],
          "properties": {
            "builtins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "packages": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/packageLocator"
              }
            }
          },
          "additionalProperties": false
        },
        "endowments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
