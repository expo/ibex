+jsi::ArrayBuffer HermesRuntimeImpl::createKeyedExternalRangeAlias(
+    const jsi::ArrayBuffer &source,
+    size_t byteOffset,
+    size_t byteLength) {
+  struct : public vm::Locals {
+    vm::PinnedValue<vm::JSArrayBuffer> alias;
+  } lv;
+  vm::LocalsRAII lraii(runtime_, &lv);
+  vm::GCScope gcScope(runtime_);
+
+  auto sourceBuffer = arrayBufferHandle(source);
+  if (LLVM_UNLIKELY(!sourceBuffer->attached())) {
+    throw jsi::JSINativeException("Cannot alias a detached ArrayBuffer.");
+  }
+  if (LLVM_UNLIKELY(sourceBuffer->hasKeyedExternalDetachKey())) {
+    throw jsi::JSINativeException(
+        "A keyed external alias cannot be used as an alias source.");
+  }
+  const size_t sourceSize = sourceBuffer->size();
+  if (LLVM_UNLIKELY(
+          byteOffset > sourceSize || byteLength > sourceSize - byteOffset)) {
+    throw jsi::JSINativeException("Keyed external alias is out of bounds.");
+  }
+
+  auto context = vm::JSArrayBuffer::getOrPromoteExternalDataContext(
+      runtime_, sourceBuffer);
+  auto *data = sourceBuffer->getDataBlock();
+  lv.alias = vm::JSArrayBuffer::create(
+      runtime_,
+      vm::Handle<vm::JSObject>::vmcast(&runtime_.arrayBufferPrototype));
+  vm::JSArrayBuffer::setExternalDataBlock(
+      runtime_,
+      lv.alias,
+      data == nullptr ? nullptr : data + byteOffset,
+      byteLength,
+      context);
+  lv.alias->setKeyedExternalDetachKey();
+  return add<jsi::ArrayBuffer>(lv.alias.getHermesValue());
+}
+
+bool HermesRuntimeImpl::detachKeyedExternalRange(
+    const jsi::ArrayBuffer &buffer) {
+  vm::GCScope gcScope(runtime_);
+  return vm::JSArrayBuffer::detachWithKeyedExternalKey(
+      runtime_, arrayBufferHandle(buffer));
+}
