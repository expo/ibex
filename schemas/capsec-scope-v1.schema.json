{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/capsec-scope-v1.schema.json",
  "title": "Ibex CapSec scoped-certification scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scopeSchema",
    "profile",
    "target",
    "intensionalDefinition",
    "expandedCellIds",
    "closureEdges",
    "predecessor",
    "scopeExpansionDiffDigest",
    "scopeCellMappingDigest",
    "scopeDigest"
  ],
  "properties": {
    "scopeSchema": { "const": "ibex/capsec-scope/1" },
    "profile": { "const": "ibex/capsec/1" },
    "target": { "$ref": "#/$defs/target" },
    "intensionalDefinition": { "$ref": "#/$defs/intensionalDefinition" },
    "expandedCellIds": { "$ref": "#/$defs/cellIdSet" },
    "closureEdges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/closureEdge" }
    },
    "predecessor": { "$ref": "#/$defs/predecessor" },
    "scopeExpansionDiffDigest": { "$ref": "#/$defs/digest" },
    "scopeCellMappingDigest": { "$ref": "#/$defs/digest" },
    "scopeDigest": {
      "$ref": "#/$defs/digest",
      "$comment": "SHA-256 over JCS(scope without scopeDigest), domain ibex:capsec:scope:1 followed by one NUL byte."
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "nonemptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cellIdSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^surface\\.[a-z0-9]+(?:[._/-][a-z0-9]+)+$"
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triple", "features"],
      "properties": {
        "triple": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "intensionalDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityFamilies", "surfaceKinds"],
      "properties": {
        "capabilityFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "surfaceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "genesis" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scopeDigest"],
          "properties": {
            "kind": { "const": "scope" },
            "scopeDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "closureEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromEdgeId",
        "toEdgeId",
        "dependencyKind",
        "implementationBranchId",
        "terminalObservedKey",
        "proofPaths",
        "sourceRefs"
      ],
      "properties": {
        "fromEdgeId": { "$ref": "#/$defs/stableId" },
        "toEdgeId": { "$ref": "#/$defs/stableId" },
        "dependencyKind": {
          "enum": ["source-derived-route", "argument-selected-branch-alternative"]
        },
        "implementationBranchId": { "$ref": "#/$defs/stableId" },
        "terminalObservedKey": { "type": "string", "minLength": 1 },
        "proofPaths": { "$ref": "#/$defs/nonemptyStringSet" },
        "sourceRefs": { "$ref": "#/$defs/nonemptyStringSet" }
      }
    }
  }
}
