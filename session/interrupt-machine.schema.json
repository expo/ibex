{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schema/interrupt-machine.v1.json",
  "title": "Ibex terminal-session interrupt machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "sourceRef",
    "identityDomains",
    "initialState",
    "properties",
    "eventAlphabet",
    "dispatchPrecedence",
    "interruptRows",
    "eventRules",
    "namedSchedules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "const": "ibex-terminal-interrupt-machine" },
    "sourceRef": { "const": "LLP 0025#6-interruption-and-cancellation" },
    "identityDomains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "schedules", "completionRequests"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "schedules": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "completionRequests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        }
      }
    },
    "initialState": { "$ref": "#/$defs/state" },
    "properties": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expression"],
        "properties": {
          "id": { "type": "string" },
          "expression": { "type": "string" },
          "statusRule": { "type": "string" }
        }
      }
    },
    "eventAlphabet": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "kind": { "enum": ["external", "derived-atomic"] },
          "description": { "type": "string" }
        }
      }
    },
    "dispatchPrecedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termination", "status"],
      "properties": {
        "termination": {
          "const": ["latched-cause", "prior-promise", "credit-three", "target-row"]
        },
        "status": {
          "const": ["latched-cause", "prior-promise", "interrupt-130-fallback"]
        }
      }
    },
    "interruptRows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/interruptRow" }
    },
    "eventRules": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "event", "operation"],
        "properties": {
          "id": { "type": "string" },
          "event": { "type": "string" },
          "operation": { "type": "string" }
        }
      }
    },
    "namedSchedules": {
      "type": "array",
      "minItems": 14,
      "items": { "$ref": "#/$defs/schedule" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "bufferGeneration",
        "typedAhead",
        "pendingSubmission",
        "executing",
        "suspended",
        "due",
        "completionQueued",
        "pendingCancellations",
        "escapeCredit",
        "promise",
        "cause",
        "exitCode",
        "ended"
      ],
      "properties": {
        "phase": { "enum": ["idle", "editing", "continuation", "evaluating", "shutdown"] },
        "bufferGeneration": { "type": "integer", "minimum": 0, "maximum": 1 },
        "typedAhead": { "type": "boolean" },
        "pendingSubmission": { "enum": ["none", "undispatched", "dispatched", "discarded"] },
        "executing": { "type": ["object", "null"] },
        "suspended": { "type": "array" },
        "due": { "type": "array" },
        "completionQueued": { "type": "array" },
        "pendingCancellations": { "type": "array" },
        "escapeCredit": { "type": "integer", "minimum": 0, "maximum": 3 },
        "promise": { "enum": ["none", "orderly", "interrupt-130"] },
        "cause": { "type": ["object", "null"] },
        "exitCode": { "type": "integer" },
        "ended": { "type": "boolean" }
      }
    },
    "guard": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "boolean" },
          { "type": "integer" },
          { "type": "array", "items": { "type": ["string", "boolean", "integer"] } }
        ]
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice",
        "promise",
        "abandonCompletion",
        "raiseCancellation",
        "buffer",
        "submission"
      ],
      "properties": {
        "notice": {
          "enum": [
            "orderly-promise",
            "cancelling-work",
            "work-in-flight",
            "cancelling-completion",
            "input-discarded",
            "none"
          ]
        },
        "promise": { "enum": ["none", "orderly", "interrupt-130"] },
        "abandonCompletion": { "type": "boolean" },
        "raiseCancellation": { "enum": ["none", "executing"] },
        "buffer": { "enum": ["unchanged", "preserve-invalidate", "discard-invalidate"] },
        "submission": { "enum": ["unchanged", "discard", "discard-and-idle"] }
      }
    },
    "interruptRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "when", "decision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "label": { "type": "string" },
        "when": { "$ref": "#/$defs/guard" },
        "decision": { "$ref": "#/$defs/decision" }
      }
    },
    "event": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "event": { "type": "string" }
      },
      "additionalProperties": true
    },
    "expectation": {
      "type": "object",
      "additionalProperties": true
    },
    "scheduleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "$ref": "#/$defs/event" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "llpSchedule", "title", "steps", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "llpSchedule": { "type": "string", "pattern": "^[a-n]$" },
        "title": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scheduleStep" }
        },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    }
  }
}
