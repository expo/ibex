{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/capsec-executable-recipes-v2.schema.json",
  "title": "Ibex portable CapSec executable recipe catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipeCatalogSchema",
    "profile",
    "target",
    "recipes",
    "summary",
    "recipeCatalogDigest"
  ],
  "properties": {
    "recipeCatalogSchema": { "const": "ibex/capsec-executable-recipes/2" },
    "profile": { "const": "ibex/capsec/1" },
    "target": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/target"
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/recipe" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "recipeCatalogDigest": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest",
      "$comment": "SHA-256 over JCS({scopeDigest, recipeCatalog: catalog without recipeCatalogDigest}), domain ibex:capsec:executable-recipes:2 followed by one NUL byte."
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "status", "executor", "planDigest"],
      "properties": {
        "fixtureId": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/stableId"
        },
        "status": {
          "enum": ["fully-executable", "internally-verified"]
        },
        "executor": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/stableId"
        },
        "planDigest": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest",
          "$comment": "SHA-256 over the exact fixtureId/status/executor plan projection, domain ibex:capsec:executable-recipe-plan:1 followed by one NUL byte."
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFixtures",
        "fullyExecutableFixtures",
        "internallyVerifiedFixtures",
        "unresolvedFixtures"
      ],
      "properties": {
        "requiredFixtures": { "type": "integer", "minimum": 1 },
        "fullyExecutableFixtures": { "type": "integer", "minimum": 0 },
        "internallyVerifiedFixtures": { "type": "integer", "minimum": 0 },
        "unresolvedFixtures": { "const": 0 }
      }
    }
  }
}
