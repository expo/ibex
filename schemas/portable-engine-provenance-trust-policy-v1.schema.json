{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/portable-engine-provenance-trust-policy-v1.schema.json",
  "title": "Ibex portable engine provenance trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "portableArtifactAcceptanceEnabled",
    "admittedTargets",
    "enginePublisher",
    "provenanceBundleBytes",
    "authoritativeConformance",
    "crossRunnerConformance",
    "archiveLimits",
    "payloadPathPolicy",
    "platformSystemDependencies"
  ],
  "properties": {
    "schema": { "const": "ibex/portable-engine-provenance-trust-policy/1" },
    "portableArtifactAcceptanceEnabled": { "const": false },
    "admittedTargets": {
      "const": [
        {
          "triple": "aarch64-apple-darwin",
          "targetFamily": "apple",
          "structuralFeatures": [
            "dynamic-library",
            "framework"
          ],
          "nonSystemLoadableComponentPolicy": "runtime-only",
          "profile": {
            "id": "source-patched",
            "targetVariant": "default",
            "configuration": "Release",
            "debugger": false,
            "hermesBytecodeVersion": 99
          },
          "sourceTreeGitObjectFormat": "sha1",
          "reviewedProfileOriginKind": "source-patched-cache",
          "exportExtractor": "macho-nlist-external-defined",
          "exportPolicy": {
            "requiredMatchers": [
              {
                "kind": "contains",
                "value": "makeHermesRuntime"
              },
              {
                "kind": "exact",
                "value": "_ex_hermes_vm_current_package_id"
              }
            ],
            "forbiddenMatchers": [
              {
                "kind": "contains",
                "value": "AsyncDebuggerAPI"
              },
              {
                "kind": "contains",
                "value": "CDPAgent"
              },
              {
                "kind": "contains",
                "value": "CDPDebugAPI"
              }
            ]
          },
          "requiredHostTools": [
            {
              "toolRole": "bytecode-compiler",
              "toolPath": "bin/hermesc"
            }
          ],
          "buildAuthorityPaths": [
            ".gitattributes",
            ".github/workflows/hermes-artifacts.yml",
            "schemas/portable-engine-abi-contract-v1.schema.json",
            "schemas/portable-engine-common-v1.schema.json",
            "schemas/portable-engine-export-set-v1.schema.json",
            "schemas/portable-engine-header-set-v1.schema.json",
            "schemas/portable-engine-host-tool-compatibility-v1.schema.json",
            "schemas/portable-engine-manifest-v1.schema.json",
            "schemas/portable-engine-provenance-trust-policy-v1.json",
            "schemas/portable-engine-provenance-trust-policy-v1.schema.json",
            "schemas/portable-engine-reviewed-profile-identity-v1.schema.json",
            "schemas/portable-engine-source-tree-identity-v1.schema.json",
            "scripts/apply-hermes-patches.sh",
            "scripts/build-hermes-linux.sh",
            "scripts/build-hermes.sh",
            "scripts/hermes-version.sh",
            "scripts/package-portable-hermes-macos.mjs",
            "scripts/portable-engine-contract.mjs",
            "tests/fixtures/portable-engine/host-tools/smoke.js"
          ],
          "mappingProof": {
            "class": "macos-proc-pid-region-path-info",
            "platform": "macos"
          },
          "receiptTargetArchitectures": [
            "aarch64",
            "universal"
          ],
          "hostTool": {
            "actualHostTriple": "aarch64-apple-darwin",
            "binaryMachine": {
              "format": "mach-o",
              "architecture": "arm64"
            },
            "dependencyExtractorFormat": "mach-o",
            "systemDependencyPolicyKey": "apple",
            "executionContract": {
              "environmentMode": "replace-exactly",
              "environment": [
                {
                  "name": "LC_ALL",
                  "value": "C"
                },
                {
                  "name": "TZ",
                  "value": "UTC"
                }
              ],
              "stdin": "empty",
              "workingDirectoryLifetime": "fresh-private-per-invocation",
              "argv0": "exact-tool-path",
              "timeoutMs": 30000,
              "maxStdoutBytes": 1048576,
              "maxStderrBytes": 1048576,
              "maxOutputBytes": 1048576
            }
          },
          "systemDependencyPolicyKey": "apple",
          "directJsiAbi": {
            "languageBoundary": "cxx-jsi-direct",
            "cxxStandard": "c++17",
            "compilerAbi": "itanium",
            "standardLibraryAbi": "libc++",
            "exceptions": "enabled",
            "rtti": "enabled",
            "pointerWidth": 64,
            "endianness": "little",
            "allocationBoundary": "cxx-allocator-compatible",
            "contractFeatures": [
              "direct-jsi-objects",
              "hermes-bytecode-v99"
            ]
          }
        }
      ]
    },
    "enginePublisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedTriggers",
        "buildType",
        "certificateIssuer",
        "enabled",
        "offlineVerifier",
        "repository",
        "repositoryId",
        "repositoryOwnerId",
        "repositoryVisibility",
        "workflowPath",
        "workflowName",
        "sourceRef",
        "runnerClass",
        "provenanceRoot",
        "trustedRoot"
      ],
      "properties": {
        "allowedTriggers": { "const": ["push", "workflow_dispatch"] },
        "buildType": { "const": "https://actions.github.io/buildtypes/workflow/v1" },
        "certificateIssuer": { "const": "https://token.actions.githubusercontent.com" },
        "enabled": { "const": true },
        "offlineVerifier": {
          "const": {
            "binaryDigest": "sha256-f69505f54caad78b6012519ac866eea23c19ade9d274bd61044c791a1e30f594",
            "binarySize": 25130562,
            "goVersion": "go1.26.5",
            "targetTriple": "aarch64-apple-darwin"
          }
        },
        "repository": { "const": "ccheever/ibex" },
        "repositoryId": { "const": "1268046138" },
        "repositoryOwnerId": { "const": "56719" },
        "repositoryVisibility": { "const": "private" },
        "workflowPath": { "const": ".github/workflows/hermes-artifacts.yml" },
        "workflowName": { "const": "Hermes artifact cache" },
        "sourceRef": { "const": "refs/heads/main" },
        "runnerClass": { "const": "github-hosted" },
        "provenanceRoot": { "const": "github-oidc-artifact-attestations" },
        "trustedRoot": {
          "const": {
            "profile": "github-private-signed-timestamp-v1",
            "sha256": "484cdfe1a7c65479c5ba2a22193d1be90f0020db1997de696ab207434c62fbb7",
            "size": 31645
          }
        }
      }
    },
    "provenanceBundleBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "mediaType",
        "textEncoding",
        "jsonContract",
        "byteProjection",
        "normalization",
        "digest",
        "maxBundleBytes",
        "acceptanceRequiresOfflineVerification"
      ],
      "properties": {
        "container": { "const": "single-json-document" },
        "mediaType": {
          "const": "application/vnd.dev.sigstore.bundle.v0.3+json"
        },
        "textEncoding": { "const": "utf-8" },
        "jsonContract": { "const": "strict-ijson-no-duplicate-keys" },
        "byteProjection": { "const": "entire-file-as-stored" },
        "normalization": { "const": "none" },
        "digest": { "const": "sha256-lowercase-hex" },
        "maxBundleBytes": { "const": 16777216 },
        "acceptanceRequiresOfflineVerification": { "const": true }
      }
    },
    "authoritativeConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerClass", "sameRunnerOnly"],
      "properties": {
        "runnerClass": { "const": "github-hosted" },
        "sameRunnerOnly": { "const": true }
      }
    },
    "crossRunnerConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinatorAssignmentsEnabled",
        "diagnosticShardTransportEnabled",
        "promotionAuthorityEnabled",
        "retryEnabled",
        "resumptionEnabled"
      ],
      "properties": {
        "coordinatorAssignmentsEnabled": { "const": false },
        "diagnosticShardTransportEnabled": { "const": false },
        "promotionAuthorityEnabled": { "const": false },
        "retryEnabled": { "const": false },
        "resumptionEnabled": { "const": false }
      }
    },
    "archiveLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxArchiveBytes",
        "maxMemberCount",
        "maxRegularFileBytes",
        "maxExpandedBytes",
        "maxSymlinkDepth"
      ],
      "properties": {
        "maxArchiveBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxMemberCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxRegularFileBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxExpandedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxSymlinkDepth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "payloadPathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicodeNormalization",
        "unicodeCaseFolding",
        "appleCaseFolded",
        "linuxCaseFolded",
        "windowsCaseFolded",
        "windowsTrailingDotSpaceCollapse",
        "windowsReservedDeviceNames",
        "windowsAlternateDataStreamsForbidden"
      ],
      "properties": {
        "unicodeNormalization": { "const": "NFC" },
        "unicodeCaseFolding": { "const": "Unicode-15.1.0-default-case-fold" },
        "appleCaseFolded": { "const": true },
        "linuxCaseFolded": { "const": false },
        "windowsCaseFolded": { "const": true },
        "windowsTrailingDotSpaceCollapse": { "const": true },
        "windowsReservedDeviceNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "aux", "clock$", "com1", "com2", "com3", "com4", "com5",
              "com6", "com7", "com8", "com9", "con", "lpt1", "lpt2",
              "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9",
              "nul", "prn"
            ]
          }
        },
        "windowsAlternateDataStreamsForbidden": { "const": true }
      }
    },
    "platformSystemDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apple", "linux", "windows"],
      "properties": {
        "apple": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation",
              "/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation",
              "/usr/lib/libSystem.B.dylib",
              "/usr/lib/libc++.1.dylib",
              "/usr/lib/libobjc.A.dylib"
            ]
          }
        },
        "linux": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "libc.so.6", "libdl.so.2", "libgcc_s.so.1", "libm.so.6",
              "libpthread.so.0", "librt.so.1", "libstdc++.so.6"
            ]
          }
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "advapi32.dll", "bcrypt.dll", "kernel32.dll", "ntdll.dll",
              "ole32.dll", "ucrtbase.dll", "user32.dll", "vcruntime140.dll",
              "ws2_32.dll"
            ]
          }
        }
      }
    }
  }
}
