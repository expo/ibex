{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-absence-route-graph.schema.json",
  "title": "Ibex restricted-profile absence dominance graph",
  "type": "object",
  "required": [
    "routeGraphSchema",
    "profile",
    "target",
    "authorityDigests",
    "counts",
    "sourceFiles",
    "topology",
    "routes"
  ],
  "properties": {
    "routeGraphSchema": { "const": "ibex/restricted-profile-absence-route-graph/1" },
    "profile": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "authorityDigests": {
      "type": "object",
      "required": ["projection", "coverage", "implementationManifest", "rootGlobalManifest", "probePlan"],
      "properties": {
        "projection": { "$ref": "#/$defs/digest" },
        "coverage": { "$ref": "#/$defs/digest" },
        "implementationManifest": { "$ref": "#/$defs/digest" },
        "rootGlobalManifest": { "$ref": "#/$defs/digest" },
        "probePlan": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["edges", "routes", "sourceFiles", "sourceBindings", "liveProbeBindings"],
      "properties": {
        "edges": { "type": "integer", "minimum": 1 },
        "routes": { "type": "integer", "minimum": 1 },
        "sourceFiles": { "type": "integer", "minimum": 1 },
        "sourceBindings": { "type": "integer", "minimum": 1 },
        "liveProbeBindings": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "rawContentDigest"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "rawContentDigest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "topology": {
      "type": "object",
      "required": ["sourceSpans", "nodes", "edges", "sourceRoot", "liveRoot", "sourceCutsets", "liveCutsets", "terminals"],
      "properties": {
        "sourceSpans": {
          "type": "array", "minItems": 5,
          "items": {
            "type": "object",
            "required": ["spanId", "path", "startToken", "endToken", "startByte", "endByte", "startLine", "endLine", "rawContentDigest"],
            "properties": {
              "spanId": { "$ref": "#/$defs/stableId" },
              "path": { "$ref": "#/$defs/repoPath" },
              "startToken": { "type": "string", "minLength": 1 },
              "endToken": { "type": "string", "minLength": 1 },
              "startByte": { "type": "integer", "minimum": 0 },
              "endByte": { "type": "integer", "minimum": 1 },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "rawContentDigest": { "$ref": "#/$defs/digest" }
            },
            "additionalProperties": false
          }
        },
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nodeId", "kind"],
            "properties": {
              "nodeId": { "$ref": "#/$defs/stableId" },
              "kind": { "enum": ["attacker-root", "instrumented-cutset", "exposure-gateway", "terminal"] },
              "sourceSpanId": { "$ref": "#/$defs/stableId" },
              "observationId": { "$ref": "#/$defs/stableId" },
              "surfaceKind": { "type": "string", "minLength": 1 },
              "edgeId": { "$ref": "#/$defs/stableId" }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "routeClass"],
            "properties": {
              "from": { "$ref": "#/$defs/stableId" },
              "to": { "$ref": "#/$defs/stableId" },
              "routeClass": { "enum": ["source-selection", "live-reachability", "terminal-exposure"] }
            },
            "additionalProperties": false
          }
        },
        "sourceRoot": { "$ref": "#/$defs/stableId" },
        "liveRoot": { "$ref": "#/$defs/stableId" },
        "sourceCutsets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "liveCutsets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "terminals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["edgeId", "nodeId", "gatewayNodeId", "branchIds", "liveProbeIds"],
            "properties": {
              "edgeId": { "$ref": "#/$defs/stableId" },
              "nodeId": { "$ref": "#/$defs/stableId" },
              "gatewayNodeId": { "$ref": "#/$defs/stableId" },
              "branchIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
              "liveProbeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "repoPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stableId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
    "sourceBinding": {
      "type": "object",
      "required": ["sourceRef", "path", "locator", "rawContentDigest"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 3 },
        "path": { "$ref": "#/$defs/repoPath" },
        "locator": { "type": "string", "minLength": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segmentId", "kind"],
      "properties": {
        "segmentId": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["attacker-root", "target-selection", "implementation-branch", "cut-set"] },
        "expectedTarget": { "type": "string", "minLength": 1 },
        "branchId": { "$ref": "#/$defs/stableId" },
        "cutsetObservationId": { "$ref": "#/$defs/stableId" },
        "observer": { "type": "string", "minLength": 1 },
        "expectedFailureSegment": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "routeId", "edgeId", "sourceProbeId", "branchId", "observedIdentity",
        "attackerRoots", "liveProbeIds", "applicability", "sourceBindings",
        "sourcePath", "livePath", "sourceCutsetObservationIds", "liveCutsetObservationIds"
      ],
      "properties": {
        "routeId": { "$ref": "#/$defs/stableId" },
        "edgeId": { "$ref": "#/$defs/stableId" },
        "sourceProbeId": { "$ref": "#/$defs/stableId" },
        "branchId": { "$ref": "#/$defs/stableId" },
        "observedIdentity": { "type": "string", "minLength": 3 },
        "attackerRoots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "liveProbeIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "applicability": {
          "type": "object",
          "required": ["classification", "reason"],
          "properties": {
            "classification": { "enum": ["selected", "platform-excluded", "compiled-but-disabled", "runtime-disabled"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "sourceBindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceBinding" } },
        "sourcePath": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "livePath": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "sourceCutsetObservationIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "liveCutsetObservationIds": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
      },
      "additionalProperties": false
    }
  }
}
