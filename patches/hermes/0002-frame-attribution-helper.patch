+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+//===----------------------------------------------------------------------===//
+// @ref LLP 0013#mechanism-3 — Frame-derived capability attribution (Ibex patch,
+// Class A). See CapabilityAttribution.h. The frame walk mirrors the existing
+// in-tree pattern in Interpreter-slowpaths.cpp (curCodeBlock ->
+// getRuntimeModule() -> getDomain()).
+//===----------------------------------------------------------------------===//
+
+#include "hermes/VM/CapabilityAttribution.h"
+
+#include <cstddef>
+
+#include "hermes/Public/HermesExport.h"
+
+#include "hermes/VM/Callable.h"
+#include "hermes/VM/Domain.h"
+#include "hermes/VM/Runtime-inline.h"
+#include "hermes/VM/RuntimeModule-inline.h"
+#include "hermes/VM/StackFrame-inline.h"
+
+namespace hermes {
+namespace vm {
+
+// The reserved principal for runtime-internal code: the bootstrap scripts, the
+// module loader, and the lockdown/compartment installers. Frames stamped with
+// it are transparent to attribution — skipped so a trusted deputy (the
+// `process.env` getter, `fs.readFileSync`, `fetch`) does not launder a package's
+// host access into the root principal. Kept in sync with kRuntimePrincipalId on
+// the Ibex side. @ref LLP 0013 — Open-Q3 (skip runtime-internal frames).
+static constexpr uint32_t kRuntimePackageId = 0xFFFFFFFFu;
+
+uint32_t getCurrentPackageId(Runtime &runtime) {
+  // Walk from the innermost frame outward, skipping native frames (null callee
+  // CodeBlock) and runtime-internal deputy frames, and return the principal of
+  // the nearest *user* frame — the true acting package or the root principal.
+  for (StackFramePtr frame : runtime.getStackFrames()) {
+    CodeBlock *cb = frame.getCalleeCodeBlock();
+    if (!cb)
+      continue;
+    RuntimeModule *rm = cb->getRuntimeModule();
+    if (!rm)
+      continue;
+    Domain *domain = rm->getDomainUnsafe(runtime);
+    if (!domain)
+      continue;
+    uint32_t packageId = domain->getPackageId();
+    if (packageId == kRuntimePackageId)
+      continue;
+    return packageId;
+  }
+  return 0;
+}
+
+// @ref LLP 0013#phase-5 — collect the distinct user principals on the stack,
+// innermost-first, for stack-intersection ("deputy") enforcement. Skips native
+// and runtime-internal frames and collapses consecutive duplicates so the host
+// can AND the capability masks of every package that is actually on the stack.
+// Returns the number written (capped at \p max).
+size_t collectStackPackageIds(Runtime &runtime, uint32_t *out, size_t max) {
+  size_t count = 0;
+  uint32_t last = kRuntimePackageId; // sentinel that never equals a user id
+  for (StackFramePtr frame : runtime.getStackFrames()) {
+    if (count >= max)
+      break;
+    CodeBlock *cb = frame.getCalleeCodeBlock();
+    if (!cb)
+      continue;
+    RuntimeModule *rm = cb->getRuntimeModule();
+    if (!rm)
+      continue;
+    Domain *domain = rm->getDomainUnsafe(runtime);
+    if (!domain)
+      continue;
+    uint32_t packageId = domain->getPackageId();
+    if (packageId == kRuntimePackageId)
+      continue;
+    if (packageId == last)
+      continue;
+    out[count++] = packageId;
+    last = packageId;
+  }
+  return count;
+}
+
+} // namespace vm
+} // namespace hermes
+
+//===----------------------------------------------------------------------===//
+// Exported C bridge (Ibex patch, Class A). @ref LLP 0013#mechanism-3
+//
+// Ibex holds only a facebook::hermes::HermesRuntime and reaches the vm::Runtime
+// through IHermes::getVMRuntimeUnsafe() (an opaque void*). These wrappers are
+// the entire embedder-visible attribution surface: no VM header crosses into
+// Ibex's translation units. HERMES_EXPORT overrides the framework's
+// -fvisibility=hidden so the symbols survive into the shipped dylib.
+//===----------------------------------------------------------------------===//
+
+extern "C" {
+
+/// \return the package id of the nearest JS frame on \p vmRuntime's stack, or 0
+/// when none is attributable. \p vmRuntime is IHermes::getVMRuntimeUnsafe().
+HERMES_EXPORT uint32_t ex_hermes_vm_current_package_id(void *vmRuntime) {
+  if (!vmRuntime)
+    return 0;
+  return ::hermes::vm::getCurrentPackageId(
+      *reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime));
+}
+
+/// Stamp the package principal onto the next Domain \p vmRuntime creates.
+/// One-shot: consumed by the next runBytecode(). Set 0 to reset to root.
+HERMES_EXPORT void ex_hermes_vm_set_pending_package_id(
+    void *vmRuntime,
+    uint32_t id) {
+  if (!vmRuntime)
+    return;
+  reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)->setPendingPackageId(id);
+}
+
+/// Set the principal stamped onto Domains created with no pending id. The
+/// embedder sets this to the runtime principal (0xFFFFFFFF) while the bootstrap
+/// scripts evaluate, then to 0 (root) before user code runs.
+HERMES_EXPORT void ex_hermes_vm_set_default_package_id(
+    void *vmRuntime,
+    uint32_t id) {
+  if (!vmRuntime)
+    return;
+  reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)->setDefaultPackageId(id);
+}
+
+/// Fill \p out (capacity \p max) with the distinct user principals on the stack,
+/// innermost-first, and return the count. @ref LLP 0013#phase-5
+HERMES_EXPORT size_t ex_hermes_vm_collect_package_ids(
+    void *vmRuntime,
+    uint32_t *out,
+    size_t max) {
+  if (!vmRuntime || !out || max == 0)
+    return 0;
+  return ::hermes::vm::collectStackPackageIds(
+      *reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime), out, max);
+}
+
+} // extern "C"
