{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/coverage-edge.schema.json",
  "title": "Ibex capsec coverage-edge dataset",
  "type": "object",
  "required": ["coverageSchema", "profile", "edges"],
  "properties": {
    "coverageSchema": { "const": "ibex/capsec-coverage/1" },
    "profile": { "const": "ibex/capsec/1" },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/effectEdge" },
          { "$ref": "#/$defs/nonCapabilityEdge" },
          { "$ref": "#/$defs/closedEdge" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["kind", "name", "sourceRef"],
      "properties": {
        "kind": {
          "enum": ["builtin", "callback", "cli", "host-abi", "loader", "native-op", "startup"]
        },
        "name": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effectTemplate": {
      "type": "object",
      "required": ["cap", "selectorNormalizer", "occurrenceNormalizer", "stages", "positiveSources"],
      "properties": {
        "cap": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
        },
        "selectorNormalizer": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "occurrenceNormalizer": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["requested", "discovery", "candidate", "commit", "delivery", "repeat", "cleanup"]
          }
        },
        "positiveSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ambient-root", "handle", "implicit-self", "session", "static-floor"]
          }
        }
      },
      "additionalProperties": false
    },
    "barriers": {
      "type": "object",
      "required": ["authorizeBefore", "recheckAt", "cancelAt"],
      "properties": {
        "authorizeBefore": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "recheckAt": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cancelAt": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "effectEdge": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "surface",
        "effects",
        "principalSources",
        "effectOwnerSource",
        "gate",
        "atomicityGroup",
        "lifetimeContract",
        "barriers",
        "implementationOwner",
        "fixtures"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "effects" },
        "surface": { "$ref": "#/$defs/surface" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effectTemplate" }
        },
        "principalSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["descriptor-owner", "frame-set", "loader-referrer", "root", "runtime", "schedule-time"]
          }
        },
        "effectOwnerSource": {
          "enum": ["descriptor-owner", "innermost-nontransparent-frame", "loader-referrer", "root", "runtime"]
        },
        "gate": {
          "enum": ["adds-op-gate", "loader-admission", "reachability-close", "reclassifies"]
        },
        "atomicityGroup": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "lifetimeContract": {
          "enum": ["child-process", "file-handle", "listener", "none", "operation", "socket-stream", "watch"]
        },
        "barriers": { "$ref": "#/$defs/barriers" },
        "implementationOwner": { "type": "string", "minLength": 1 },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "nonCapabilityEdge": {
      "type": "object",
      "required": ["id", "classification", "surface", "rationaleId", "rationale"],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "non-capability" },
        "surface": { "$ref": "#/$defs/surface" },
        "rationaleId": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "closedEdge": {
      "type": "object",
      "required": ["id", "classification", "surface", "cap", "fixtures", "rationale"],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "closed" },
        "surface": { "$ref": "#/$defs/surface" },
        "cap": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
          }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
