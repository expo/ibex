+/// Optional Hermes-specific support for keyed external ArrayBuffer aliases.
+///
+/// The embedder owns publication of this capability. It is intentionally a
+/// native interface instead of a JavaScript intrinsic: ordinary JavaScript
+/// must not be able to detach a buffer carrying an embedder-owned detach
+/// key. Implementations return aliases over one existing backing store,
+/// privately promoting internal ownership when required, and detach only
+/// aliases minted by this interface.
+class JSI_EXPORT IKeyedExternalArrayBuffer : public jsi::ICast {
+ public:
+  static constexpr jsi::UUID uuid{
+      0x7ae10e78,
+      0x4581,
+      0x4b5e,
+      0xa9d2,
+      0x5139c72b23e7};
+
+  virtual jsi::ArrayBuffer createKeyedExternalRangeAlias(
+      const jsi::ArrayBuffer& source,
+      size_t byteOffset,
+      size_t byteLength) = 0;
+
+  /// Returns false without mutation unless \p buffer is an attached alias
+  /// minted by createKeyedExternalRangeAlias().
+  virtual bool detachKeyedExternalRange(
+      const jsi::ArrayBuffer& buffer) = 0;
+
+ protected:
+  ~IKeyedExternalArrayBuffer() = default;
+};
