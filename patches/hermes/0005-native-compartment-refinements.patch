+/// @ref LLP 0013#mechanism-1 — (Phase 3) — native shallow freeze primitive.
+/// __exactNativeFreeze(obj): freeze one object natively (JSObject::freeze). The
+/// userland lockdown walk can call this per intrinsic to freeze faster than a
+/// JS Object.freeze; a full boot-time native snapshot is the further step.
+CallResult<HermesValue> exactNativeFreeze(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  Handle<JSObject> obj = args.dyncastArg<JSObject>(0);
+  if (obj) {
+    if (JSObject::freeze(obj, runtime) == ExecutionStatus::EXCEPTION) {
+      return ExecutionStatus::EXCEPTION;
+    }
+  }
+  return args.getArg(0);
+}
