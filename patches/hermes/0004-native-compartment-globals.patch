+  /// @ref LLP 0013#mechanism-2 — (Phase 3) — the per-package compartment global
+  /// object. When set, bare-global references and sloppy-mode `this` in code
+  /// owned by this Domain resolve to this object (a per-package global that
+  /// withholds powerful globals) instead of the shared real global — native
+  /// compartments without a build-time source rewrite. Null (the common case)
+  /// means "resolve against the real global". GC-traced, so it needs a metadata
+  /// builder entry (unlike packageId_).
+  GCPointer<JSObject> compartmentGlobal_{};
+
+  /// @ref LLP 0013#mechanism-2 — POD mirror of "compartmentGlobal_ is non-null",
+  /// set by setCompartmentGlobal. Lets Interpreter::globalForFrame skip the
+  /// GCPointer read barrier on compartmentGlobal_ for root/first-party frames
+  /// even after another package installs a compartment (ENG-22948). POD: unlike
+  /// compartmentGlobal_ it holds no heap pointer and needs no metadata entry.
+  bool hasCompartmentGlobal_{false};
+
  public:
   static constexpr CellKind getCellKind() {
     return CellKind::DomainKind;
@@ -133,6 +149,27 @@ class Domain final : public GCCell {
     packageId_ = packageId;
   }
 
+  /// \return the per-package compartment global for this Domain's code, or null
+  /// when it resolves against the real global. @ref LLP 0013#mechanism-2
+  JSObject *getCompartmentGlobal(Runtime &runtime) const {
+    return compartmentGlobal_.get(runtime);
+  }
+
+  /// \return whether a compartment global is installed on this Domain. A POD,
+  /// barrier-free read the interpreter hot path uses to skip the GCPointer read
+  /// of compartmentGlobal_ for frames with no compartment (ENG-22948).
+  /// @ref LLP 0013#mechanism-2
+  bool hasCompartmentGlobal() const {
+    return hasCompartmentGlobal_;
+  }
