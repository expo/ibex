+//===----------------------------------------------------------------------===//
+// @ref LLP 0013#mechanism-3 — Frame-derived capability attribution.
+//
+// Ibex patch (Class A: additive file). The host-boundary capability check must
+// identify the calling package from engine truth, not a JS-settable thread
+// local. Bytecode provenance is unforgeable: given the executing frame, we walk
+// CodeBlock -> RuntimeModule -> Domain -> packageId. Native frames (JSI host
+// functions) have a null callee CodeBlock, so we skip them and attribute to the
+// nearest JS frame — the RFC's Open-Q3 rule.
+//===----------------------------------------------------------------------===//
+
+#ifndef HERMES_VM_CAPABILITYATTRIBUTION_H
+#define HERMES_VM_CAPABILITYATTRIBUTION_H
+
+#include <cstdint>
+
+namespace hermes {
+namespace vm {
+
+class Runtime;
+
+/// \return the capability principal (package id) of the nearest JS frame on the
+/// stack, or 0 (trusted root / unassigned) when no attributable JS frame is
+/// found. Skips native frames, whose callee CodeBlock is null.
+uint32_t getCurrentPackageId(Runtime &runtime);
+
+} // namespace vm
+} // namespace hermes
+
+#endif // HERMES_VM_CAPABILITYATTRIBUTION_H
