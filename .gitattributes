# CapSec digests and generated drift checks are byte-sensitive. Pin every
# contract artifact and cross-language generated binding to LF so a Windows
# checkout cannot be clean in Git while differing from the canonical bytes.
capsec/** text eol=lf
packages/ibex-runtime-js/src/security/capsec-registry.generated.ts text eol=lf
src/builtins/helpers/capsec-registry.generated.cjs text eol=lf
src/capsec_registry_generated.rs text eol=lf
src/engine/capsec_registry_generated.h text eol=lf
src/capsec_runtime_projection_generated.rs text eol=lf
src/compiled_environment_profile_generated.rs text eol=lf
src/identity_generated.rs text eol=lf
src/module_loader/transform_config_generated.rs text eol=lf
config/oxc-retirement-manifest.json text eol=lf
vendored-generated/** text eol=lf

# Rust golden tests hash these fixture bytes and compare canonical JSON text.
# Keep their sources and expected artifacts identical on Windows checkouts.
tests/fixtures/computed-candidates-v1.golden.json text eol=lf
tests/fixtures/module-runner-spike/** text eol=lf

# WebGPU registry authorities hash raw fixture bytes. Keep their source and
# generated corpus identities invariant on Windows checkouts.
tests/fixtures/webgpu-*.json text eol=lf
tests/fixtures/webgpu-*.js text eol=lf

# Archived LLP evidence and its independently checked-in inputs are hashed as
# exact bytes; preserve their canonical identity on Windows checkouts.
# @ref LLP 0024#31-post-retirement-oxc-handoff — the parser differential is a
# content-addressed cutover report bound to its projection and corpus.
llp/evidence/** text eol=lf
config/llp0024-parser-differential-projection.json text eol=lf
tests/fixtures/llp0024-parser-differential/** text eol=lf

# Cross-host contract tests inspect exact multiline engine source structure.
# Keep the text they verify identical on every checkout platform.
src/engine/** text eol=lf

# Checked example policies authenticate their complete source trees and compare
# the rendered artifact byte-for-byte. Keep those portable-v1 authorities
# canonical across Git checkout platforms.
# @ref LLP 0014#the-generated-artifact — one reviewed policy binds exact source
# integrity and must not drift solely because Git selected CRLF on Windows.
examples/llp0013-supply-chain/** text eol=lf
examples/capsec-demo/01-supply-chain/** text eol=lf
examples/capsec-demo/02-least-privilege/** text eol=lf
examples/capsec-demo/04-defense-in-depth/** text eol=lf

# Generated example policies bind raw package-tree bytes into package principal
# integrity. Keep every current text input byte-identical on Windows while
# leaving binary example payloads under Git's normal binary handling.
examples/**/*.js text eol=lf
examples/**/*.mjs text eol=lf
examples/**/*.json text eol=lf

# The aggregate generated-drift gate hashes generator/authority bytes and
# compares committed outputs byte-for-byte. Keep that closed text family at LF
# so a Windows checkout evaluates the same generation contract as Unix hosts.
packages/ibex-devtools/src/scripts/** text eol=lf
vendored-generated/** text eol=lf
session/** text eol=lf
llp/fixtures/** text eol=lf
runtime-surface.json text eol=lf

# Parser-pin conformance searches the lockfile's checked-in text with an
# LF-delimited exact version record.
Cargo.lock text eol=lf

# The shared Rust/JavaScript JCS oracle is a tab-separated byte corpus; the
# JavaScript contract test splits its records on LF.
crates/capsec-semantics/tests/fixtures/jcs-number-vectors.tsv text eol=lf

# The Rust module-runner producer binds source bytes into artifacts and compares
# its canonical JSON renderings byte-for-byte with these checked-in outputs.
tests/fixtures/module-runner-spike/sources/** text eol=lf
tests/fixtures/module-runner-spike/canonical-artifacts.json text eol=lf
tests/fixtures/module-runner-spike/test262-artifacts.json text eol=lf

# Evaluator identity review hashes these checked-in bytes. Keep a Windows
# checkout byte-identical to the reviewed LF source and patch authorities.
patches/hermes/*.patch text eol=lf -whitespace
scripts/hermes-version.sh text eol=lf
scripts/apply-hermes-patches.sh text eol=lf
scripts/build-hermes.sh text eol=lf
scripts/build-hermes-linux.sh text eol=lf
scripts/build-hermes-windows.ps1 text eol=lf
scripts/install-windows-hermes.ps1 text eol=lf
# The exact-target prerequisite matrix invokes these through Git Bash on
# Windows; CRLF would become part of shell tokens and invalidate the evidence.
scripts/run-tests.sh text eol=lf
scripts/test-android-java.sh text eol=lf
scripts/check-generated-drift.sh text eol=lf

# The vendored-runtime fingerprint hashes these source bytes directly. Keep
# every runtime, registry, embedding, and build authority byte-identical across
# checkouts so the hermetic build and source-review checks are portable to
# Windows.
build.rs text eol=lf
include/** text eol=lf
platform/android/** text eol=lf
src/** text eol=lf
src/builtins/** text eol=lf
src/engine/bootstrap/** text eol=lf
packages/ibex-runtime-js/src/** text eol=lf
modules.ts text eol=lf

# Portable-engine identities hash these exact checked-in authority and fixture
# bytes. A platform checkout must not rewrite them before the producer or
# golden-vector updater observes them.
.gitattributes text eol=lf
.github/workflows/hermes-artifacts.yml text eol=lf
schemas/portable-engine-* text eol=lf
schemas/vectors/portable-engine-* text eol=lf
packages/ibex-devtools/src/scripts/*portable-engine-* text eol=lf
scripts/package-portable-hermes-macos.mjs text eol=lf
scripts/portable-engine-contract.mjs text eol=lf
scripts/portable-engine-promotion-lineage*.mjs text eol=lf
scripts/package-portable-hermes-macos.test.mjs text eol=lf
scripts/hermes-artifacts-workflow-security.test.mjs text eol=lf
tests/fixtures/portable-engine/** text eol=lf

# The standalone offline verifier embeds and hashes exact trust/corpus bytes;
# its source-build entry point must also remain portable shell text.
tools/portable-engine-attestation-verifier/** text eol=lf
scripts/build-portable-engine-attestation-verifier.sh text eol=lf
scripts/build-portable-engine-attestation-verifier.test.sh text eol=lf

# Preserve third-party ring sources and pregenerated assembly byte-for-byte.
# Upstream intentionally carries whitespace that Git's default checker flags.
vendor/ring/** -whitespace
