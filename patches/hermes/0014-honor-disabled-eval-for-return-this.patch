@@ -229,6 +229,14 @@ class Runtime : public RuntimeBase, public HandleRootOwner {
 
   ~Runtime();
 
+  /// Irreversibly disable eval and Function-family string compilation for this
+  /// runtime. Embedders may call this after trusted bootstrap and before
+  /// exposing the runtime to application code. There is deliberately no
+  /// inverse operation.
+  void disableEval() {
+    enableEval = false;
+  }
+
   /// Add a custom function that will be executed at the start of every garbage
   /// collection to mark additional GC roots that may not be known to the
   /// Runtime.
@@ -873,7 +881,7 @@ class Runtime : public RuntimeBase, public HandleRootOwner {
   uint32_t objectIDCounter{0};
 
   /// Whether to allow eval and Function ctor.
-  const bool enableEval : 1;
+  bool enableEval : 1;
   /// Whether to verify the IR being generated by eval and the Function ctor.
   const bool verifyEvalIR : 1;
   /// Whether to optimize the code in the string passed to eval and the Function
