{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-source-bindings.schema.json",
  "title": "Ibex restricted-profile executable branch source routes",
  "type": "object",
  "required": [
    "sourceBindingSchema",
    "profile",
    "target",
    "authorityDigests",
    "counts",
    "branches"
  ],
  "properties": {
    "sourceBindingSchema": {
      "const": "ibex/restricted-profile-source-bindings/1"
    },
    "profile": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "authorityDigests": {
      "type": "object",
      "required": ["implementationManifest"],
      "properties": {
        "implementationManifest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["branches", "sourceRefs", "sites", "producerPaths", "incomplete"],
      "properties": {
        "branches": { "type": "integer", "minimum": 1 },
        "sourceRefs": { "type": "integer", "minimum": 1 },
        "sites": { "type": "integer", "minimum": 1 },
        "producerPaths": { "type": "integer", "minimum": 1 },
        "incomplete": { "const": 0 }
      },
      "additionalProperties": false
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/branchRoute" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "site": {
      "type": "object",
      "required": [
        "siteId",
        "path",
        "role",
        "startByte",
        "endByte",
        "startLine",
        "endLine",
        "rawContentDigest"
      ],
      "properties": {
        "siteId": { "$ref": "#/$defs/stableId" },
        "path": { "$ref": "#/$defs/repoPath" },
        "role": {
          "enum": [
            "definition",
            "value-producer",
            "selector",
            "guard",
            "registration",
            "publication",
            "alias",
            "lazy-trigger",
            "retention",
            "dispatch"
          ]
        },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "producerPath": {
      "type": "object",
      "required": ["pathId", "conditionId", "requiredSiteIds"],
      "properties": {
        "pathId": { "$ref": "#/$defs/stableId" },
        "conditionId": { "$ref": "#/$defs/stableId" },
        "requiredSiteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "bindingDisposition": {
      "type": "object",
      "required": ["sourceRef", "disposition", "locatorKind"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 3 },
        "disposition": {
          "enum": [
            "selected-route",
            "supporting-provenance",
            "excluded-nonterminal-route"
          ]
        },
        "locatorKind": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "branchRoute": {
      "type": "object",
      "required": [
        "branchId",
        "edgeId",
        "observedKey",
        "targetVariant",
        "status",
        "resolutionPolicy",
        "sites",
        "producerPaths",
        "bindingDispositions"
      ],
      "properties": {
        "branchId": { "$ref": "#/$defs/stableId" },
        "edgeId": { "$ref": "#/$defs/stableId" },
        "observedKey": { "type": "string", "minLength": 3 },
        "targetVariant": { "type": "string", "minLength": 1 },
        "status": { "const": "executable" },
        "resolutionPolicy": {
          "enum": ["composite-path", "conditioned-alternatives"]
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/site" }
        },
        "producerPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/producerPath" }
        },
        "bindingDispositions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bindingDisposition" }
        }
      },
      "additionalProperties": false
    }
  }
}
