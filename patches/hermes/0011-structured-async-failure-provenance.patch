+
+std::string boundedUTF8FromStringView(
+    vm::StringView view,
+    size_t maximumBytes,
+    bool &truncated) {
+  assert(maximumBytes >= kSafeTextTruncationMarkerBytes);
+  assert(maximumBytes <= kMaximumSafeTextBytes);
+  truncated = false;
+  if (view.isASCII()) {
+    if (view.length() <= maximumBytes) {
+      return std::string{view.castToCharPtr(), view.length()};
+    }
+    truncated = true;
+    const size_t prefixBytes = maximumBytes - kSafeTextTruncationMarkerBytes;
+    std::string result{view.castToCharPtr(), prefixBytes};
+    result.append(kSafeTextTruncationMarker);
+    return result;
+  }
+
+  const auto source =
+      llvh::ArrayRef<char16_t>{view.castToChar16Ptr(), view.length()};
+  // Convert directly into a fixed-size buffer. A first pass determines
+  // whether the complete string fits. Only when it does not do we make a
+  // second bounded pass that reserves room for the trusted marker. The
+  // converter never writes a partial Unicode scalar.
+  std::array<uint8_t, kMaximumSafeTextBytes> buffer{};
+  auto converted = ::hermes::convertUTF16ToUTF8BufferWithReplacements(
+      llvh::MutableArrayRef<uint8_t>{buffer.data(), maximumBytes}, source);
+  if (converted.first == source.size()) {
+    return std::string{
+        reinterpret_cast<const char *>(buffer.data()), converted.second};
+  }
+
+  truncated = true;
+  const size_t contentBytes = maximumBytes - kSafeTextTruncationMarkerBytes;
+  converted = ::hermes::convertUTF16ToUTF8BufferWithReplacements(
+      llvh::MutableArrayRef<uint8_t>{buffer.data(), contentBytes}, source);
+  std::string result{
+      reinterpret_cast<const char *>(buffer.data()), converted.second};
+  result.append(kSafeTextTruncationMarker);
+  return result;
+}
+
+std::string boundedUTF8FromStringTableEntry(
+    const ::hermes::StringTableEntry &entry,
+    llvh::ArrayRef<unsigned char> storage,
+    bool &truncated) {
+  const uint32_t offset = entry.getOffset();
+  const uint32_t length = entry.getLength();
+  assert(offset <= storage.size());
+  if (!entry.isUTF16()) {
+    assert(length <= storage.size() - offset);
+    llvh::StringRef text{
+        reinterpret_cast<const char *>(storage.data() + offset), length};
+    if (text.size() <= kMaximumSafeTextBytes) {
+      truncated = false;
+      return text.str();
+    }
+    truncated = true;
+    const size_t contentBytes =
+        kMaximumSafeTextBytes - kSafeTextTruncationMarkerBytes;
+    std::string result{
+        text.data(), validUTF8PrefixLength(text, contentBytes)};
+    result.append(kSafeTextTruncationMarker);
+    return result;
+  }
+
+  assert(
+      static_cast<size_t>(length) * sizeof(char16_t) <=
+      storage.size() - offset);
+  const auto source = llvh::ArrayRef<char16_t>{
+      reinterpret_cast<const char16_t *>(storage.data() + offset), length};
+  std::array<uint8_t, kMaximumSafeTextBytes> buffer{};
+  auto converted = ::hermes::convertUTF16ToUTF8BufferWithReplacements(
+      llvh::MutableArrayRef<uint8_t>{buffer.data(), buffer.size()}, source);
+  if (converted.first == source.size()) {
+    truncated = false;
+    return std::string{
+        reinterpret_cast<const char *>(buffer.data()), converted.second};
+  }
+  truncated = true;
+  const size_t contentBytes =
+      kMaximumSafeTextBytes - kSafeTextTruncationMarkerBytes;
+  converted = ::hermes::convertUTF16ToUTF8BufferWithReplacements(
+      llvh::MutableArrayRef<uint8_t>{buffer.data(), contentBytes}, source);
+  std::string result{
+      reinterpret_cast<const char *>(buffer.data()), converted.second};
+  result.append(kSafeTextTruncationMarker);
+  return result;
