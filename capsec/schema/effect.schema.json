{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/effect.schema.json",
  "title": "Ibex conjunctive effect decision set",
  "type": "object",
  "required": ["decisionSetSchema", "operationId", "atomicityGroup", "combination", "context", "effects"],
  "properties": {
    "decisionSetSchema": { "const": "ibex/capsec-decision-set/1" },
    "operationId": { "type": "string", "minLength": 1 },
    "atomicityGroup": {
      "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
    },
    "combination": { "const": "conjunction" },
    "context": {
      "type": "object",
      "required": ["stage", "actor", "constrainedPrincipals"],
      "properties": {
        "stage": {
          "enum": ["requested", "discovery", "candidate", "commit", "delivery", "repeat", "cleanup"]
        },
        "actor": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/principal"
        },
        "constrainedPrincipals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/principal"
          }
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "effect": {
      "type": "object",
      "required": ["cap", "effectOwner", "resource"],
      "properties": {
        "cap": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
        },
        "effectOwner": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/principal"
        },
        "resource": {
          "$ref": "https://ibex.dev/capsec/schema/effect-occurrence.schema.json#/properties/resource"
        }
      },
      "additionalProperties": false
    }
  }
}
