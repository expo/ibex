+    bool &truncated);
+
+bool appendBoundedStringTableEntry(
+    std::string &output,
+    const ::hermes::StringTableEntry &entry,
+    llvh::ArrayRef<unsigned char> storage,
+    bool &truncated) {
+  bool entryTruncated = false;
+  auto text = boundedUTF8FromStringTableEntry(
+      entry, storage, entryTruncated);
+  if (!appendBoundedUTF8(output, text, truncated))
+    return false;
