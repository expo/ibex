{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schema/authenticated-graph-snapshot-v1.schema.json",
  "title": "Ibex authenticated graph snapshot v1",
  "type": "object",
  "required": ["schema", "entry", "nodes", "packages", "edges", "candidateSets"],
  "properties": {
    "schema": { "const": "ibex/authenticated-graph-snapshot/1" },
    "entry": {
      "type": "object",
      "required": ["name", "sourceId"],
      "properties": {
        "name": { "const": "main" },
        "sourceId": { "$ref": "#/$defs/sourceId" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/packagePrincipal" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "candidateSets": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateSet" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "sourceId": { "type": "string", "pattern": "^ibex-source-id-v1:[A-Za-z0-9_-]+$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "packagePrincipal": {
      "type": "object",
      "required": ["kind", "name", "locator", "integrity"],
      "properties": {
        "kind": { "const": "package" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "locator": { "$ref": "#/$defs/nonEmpty" },
        "integrity": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["sourceId", "sourceIntegrity"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/sourceId" },
        "sourceIntegrity": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["requester", "specifier", "resolutionKind", "conditions", "attributes", "target"],
      "properties": {
        "requester": { "$ref": "#/$defs/sourceId" },
        "specifier": { "$ref": "#/$defs/nonEmpty" },
        "resolutionKind": { "enum": ["esm-static", "dynamic-import", "common-js-require"] },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "attributes": {
          "type": "object",
          "properties": { "type": { "const": "json" } },
          "additionalProperties": false
        },
        "target": { "$ref": "#/$defs/sourceId" }
      },
      "additionalProperties": false
    },
    "candidateSet": {
      "type": "object",
      "required": ["id", "requester", "label", "candidates"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "requester": { "$ref": "#/$defs/sourceId" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      },
      "additionalProperties": false
    }
  }
}
