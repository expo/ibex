--- a/lib/VM/CapabilityAttribution.cpp
+++ b/lib/VM/CapabilityAttribution.cpp
@@ -57,6 +57,26 @@ uint32_t getCurrentPackageId(Runtime &runtime) {
   return 0;
 }
 
+// @ref LLP 0013#mechanism-2 — the compartment global of the nearest user JS
+// frame's Domain (skipping native and runtime-internal frames), or nullptr.
+JSObject *getCurrentCompartmentGlobal(Runtime &runtime) {
+  for (StackFramePtr frame : runtime.getStackFrames()) {
+    CodeBlock *cb = frame.getCalleeCodeBlock();
+    if (!cb)
+      continue;
+    RuntimeModule *rm = cb->getRuntimeModule();
+    if (!rm)
+      continue;
+    Domain *domain = rm->getDomainUnsafe(runtime);
+    if (!domain)
+      continue;
+    if (domain->getPackageId() == kRuntimePackageId)
+      continue;
+    return domain->getCompartmentGlobal(runtime);
+  }
+  return nullptr;
+}
