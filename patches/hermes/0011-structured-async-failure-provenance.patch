+  return reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)
+      ->currentJobSchedulerPrincipal();
+}
+
+HERMES_EXPORT uint64_t ex_hermes_vm_current_job_identity(void *vmRuntime) {
+  if (!vmRuntime)
