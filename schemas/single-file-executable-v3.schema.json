{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/single-file-executable-v3.schema.json",
  "title": "Ibex app-bound single-file executable v3 section directory",
  "type": "object",
  "required": ["schema", "stubContractDigest", "sections"],
  "properties": {
    "schema": { "const": "ibex/single-file-executable/3" },
    "stubContractDigest": { "$ref": "app-bound-common-v1.schema.json#/$defs/digest" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["id", "kind", "offset", "length", "alignment", "digest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
          "kind": {
            "enum": [
              "stub-contract",
              "provenance-manifest",
              "embedded-module-graph",
              "resolved-policy",
              "entry-designation",
              "candidate-table",
              "carrier-manifest",
              "carrier-payload",
              "application-binding"
            ]
          },
          "pairId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
          "offset": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 },
          "alignment": { "enum": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096] },
          "digest": { "$ref": "app-bound-common-v1.schema.json#/$defs/digest" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
