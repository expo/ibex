+bool HermesRuntimeImpl::getSafeJSErrorMetadata(
+    const jsi::Value &value,
+    std::string &message,
+    std::string &stack) {
+  message.clear();
+  stack.clear();
+  if (!value.isObject())
+    return false;
+
+  vm::GCScope gcScope(runtime_);
+  vm::PinnedHermesValue valueStorage;
+  auto valueHandle = vmHandleFromValue(value, &valueStorage);
+  auto error = vm::Handle<vm::JSError>::dyn_vmcast(valueHandle);
+  if (!error)
+    return false;
+
+  // The Error constructor creates `message` as an own data property. Read the
+  // slot only when it is still a plain string data property; never invoke a
+  // replacement accessor or walk a user-controlled prototype.
+  vm::NamedPropertyDescriptor messageDescriptor;
+  if (vm::JSObject::getOwnNamedDescriptor(
+          error,
+          runtime_,
+          vm::Predefined::getSymbolID(vm::Predefined::message),
+          messageDescriptor) &&
+      !messageDescriptor.flags.accessor &&
+      !messageDescriptor.flags.proxyObject &&
+      !messageDescriptor.flags.hostObject) {
+    auto messageValue = vm::JSObject::getNamedSlotValueUnsafe(
+                            error.get(), runtime_, messageDescriptor)
+                            .unboxToHV(runtime_);
+    if (messageValue.isString()) {
+      auto messageHandle = runtime_.makeHandle(messageValue.getString());
+      message = utf8FromStringView(
+          vm::StringPrimitive::createStringView(runtime_, messageHandle));
+    }
+  }
+
+  const vm::StackTrace *frames = error->getStackTrace();
+  if (!frames)
+    return true;
+  constexpr size_t kMaximumSafeFrames = 100;
+  const size_t count = std::min(frames->size(), kMaximumSafeFrames);
+  for (size_t index = 0; index < count; ++index) {
+    if (!stack.empty())
+      stack.push_back('\n');
+    stack += "    at ";
+    const auto &frame = frames->at(index);
+    if (const auto *bytecode =
+            std::get_if<vm::BytecodeStackTraceInfo>(&frame)) {
+      if (!bytecode->codeBlock) {
+        stack += "<native>";
+        continue;
+      }
+      stack += bytecode->codeBlock->getNameString();
+      stack += " (";
+      auto location = vm::JSError::getDebugInfo(
+          bytecode->codeBlock, bytecode->bytecodeOffset);
+      if (location) {
+        auto *provider =
+            bytecode->codeBlock->getRuntimeModule()->getBytecode();
+        stack += provider->getDebugInfo()->getUTF8FilenameByID(
+            location->filenameId);
+        stack.push_back(':');
+        stack += std::to_string(location->line);
+        stack.push_back(':');
+        stack += std::to_string(location->column);
+      } else {
+        auto sourceURL =
+            bytecode->codeBlock->getRuntimeModule()->getSourceURL();
+        stack += sourceURL.empty() ? "unknown" : sourceURL.str();
+      }
+      stack.push_back(')');
+    } else {
+      stack += "<native>";
+    }
+  }
+  if (frames->size() > count) {
+    stack += "\n    ... truncated";
+  }
+  return true;
+}
