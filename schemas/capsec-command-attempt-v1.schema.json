{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/capsec-command-attempt-v1.schema.json",
  "title": "Ibex successful CapSec supervisor command attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attemptId",
    "commandId",
    "commandIdentity",
    "phase",
    "displayedInvocation",
    "declaredInputs",
    "startedAt",
    "finishedAt",
    "elapsedMs",
    "deadlineMs",
    "gracePeriodMs",
    "classification",
    "exitCode",
    "signal",
    "cleanup",
    "stdout",
    "stderr",
    "outputs",
    "attemptDigest"
  ],
  "properties": {
    "schema": { "const": "ibex/capsec-command-attempt/1" },
    "attemptId": { "type": "string", "pattern": "^attempt-[0-9]{6}$" },
    "commandId": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/stableId"
    },
    "commandIdentity": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest"
    },
    "phase": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/stableId"
    },
    "displayedInvocation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "declaredInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/declaredInput" }
    },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": "string", "minLength": 1 },
    "elapsedMs": { "$ref": "portable-engine-common-v1.schema.json#/$defs/safeInteger" },
    "deadlineMs": { "$ref": "portable-engine-common-v1.schema.json#/$defs/positiveSafeInteger" },
    "gracePeriodMs": { "$ref": "portable-engine-common-v1.schema.json#/$defs/positiveSafeInteger" },
    "classification": { "const": "success" },
    "exitCode": { "const": 0 },
    "signal": { "type": "null" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "cleanupProven", "escapedDescendants"],
      "properties": {
        "actions": { "type": "array", "maxItems": 0 },
        "cleanupProven": { "const": true },
        "escapedDescendants": { "type": "array", "maxItems": 0 }
      }
    },
    "stdout": { "$ref": "#/$defs/log" },
    "stderr": { "$ref": "#/$defs/log" },
    "outputs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/output" }
    },
    "attemptDigest": {
      "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest"
    }
  },
  "$defs": {
    "declaredInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "digest": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "digest", "tail", "truncated"],
      "properties": {
        "bytes": { "$ref": "portable-engine-common-v1.schema.json#/$defs/safeInteger" },
        "digest": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest"
        },
        "tail": { "type": "string" },
        "truncated": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "$ref": "portable-engine-common-v1.schema.json#/$defs/safeInteger" },
        "digest": {
          "$ref": "capsec-portable-engine-evidence-common-v1.schema.json#/$defs/digest"
        }
      }
    }
  }
}
