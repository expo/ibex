{
  "schema": "ibex/portable-engine-provenance-trust-policy/1",
  "enginePublisher": {
    "enabled": true,
    "repository": "ccheever/ibex",
    "workflowPath": ".github/workflows/hermes-artifacts.yml",
    "sourceRef": "refs/heads/main",
    "runnerClass": "github-hosted",
    "provenanceRoot": "github-oidc-artifact-attestations"
  },
  "authoritativeConformance": {
    "runnerClass": "github-hosted",
    "sameRunnerOnly": true
  },
  "crossRunnerConformance": {
    "coordinatorAssignmentsEnabled": false,
    "diagnosticShardTransportEnabled": false,
    "promotionAuthorityEnabled": false,
    "retryEnabled": false,
    "resumptionEnabled": false
  },
  "archiveLimits": {
    "maxArchiveBytes": 1073741824,
    "maxMemberCount": 4096,
    "maxRegularFileBytes": 536870912,
    "maxExpandedBytes": 2147483648,
    "maxSymlinkDepth": 32
  },
  "payloadPathPolicy": {
    "unicodeNormalization": "NFC",
    "unicodeCaseFolding": "Unicode-15.1.0-default-case-fold",
    "appleCaseFolded": true,
    "linuxCaseFolded": false,
    "windowsCaseFolded": true,
    "windowsTrailingDotSpaceCollapse": true,
    "windowsReservedDeviceNames": [
      "aux",
      "clock$",
      "com1",
      "com2",
      "com3",
      "com4",
      "com5",
      "com6",
      "com7",
      "com8",
      "com9",
      "con",
      "lpt1",
      "lpt2",
      "lpt3",
      "lpt4",
      "lpt5",
      "lpt6",
      "lpt7",
      "lpt8",
      "lpt9",
      "nul",
      "prn"
    ],
    "windowsAlternateDataStreamsForbidden": true
  },
  "platformSystemDependencies": {
    "apple": [
      "/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation",
      "/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation",
      "/usr/lib/libSystem.B.dylib",
      "/usr/lib/libc++.1.dylib",
      "/usr/lib/libobjc.A.dylib"
    ],
    "linux": [
      "libc.so.6",
      "libdl.so.2",
      "libgcc_s.so.1",
      "libm.so.6",
      "libpthread.so.0",
      "librt.so.1",
      "libstdc++.so.6"
    ],
    "windows": [
      "advapi32.dll",
      "bcrypt.dll",
      "kernel32.dll",
      "ntdll.dll",
      "ole32.dll",
      "ucrtbase.dll",
      "user32.dll",
      "vcruntime140.dll",
      "ws2_32.dll"
    ]
  }
}
