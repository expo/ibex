# LLP 0013 Hermes patch 0006 — eval/Function compartment binding + native deep-freeze
# Class: B (GC-rooted Runtime field + accessors; a new native function) + A (a C
#         bridge export). @ref LLP 0013#mechanism-2 (Phase 3)
#
# Two independent Phase-3 refinements that both need in-tree Hermes edits:
#
#   * eval / `new Function` compartment binding. Patch 0005 shipped the helper
#     (getCurrentCompartmentGlobal) but documented that binding produced code
#     could not be done inside runBytecode — the eval'd code's caller frame is no
#     longer on the stack there. This patch does the capture at the correct site:
#     in evalInEnvironment (eval.cpp), where the caller's frame IS current, it
#     reads the caller's package principal and compartment global and stashes them
#     as pending; runBytecode then stamps both onto the Domain it mints. So
#     eval/Function-produced code inherits its caller's compartment (cannot escape
#     it) and attribution instead of running in the root realm.
#       - pendingCompartment_ : a new GC-rooted (PinnedValue) HermesValue field on
#         Runtime, so the captured compartment survives the allocations between
#         the eval call site and runBytecode. Declared in
#         RuntimeHermesValueFields.def; set/consumePendingCompartment on Runtime.
#       - clearPendingPackageId() / ex_hermes_vm_clear_pending_package_id: clearing
#         the pending id is distinct from pinning 0 (root). The module loader
#         clears after each compile so a subsequent eval is seen as unlabelled and
#         inherits its caller, rather than being pinned to root.
#
#   * Native transitive deep-freeze. `__exactDeepFreeze(obj)` freezes the whole
#     reachable object graph in native code (SES-style): each object frozen via
#     JSObject::freeze, recursing through property *descriptors* — data values and
#     accessor getter/setter functions read WITHOUT invoking getters — and the
#     prototype. Cycles/shared subgraphs handled by a freeze-before-recurse
#     isFrozen guard, with a depth bound as a backstop. Lets boot-time lockdown do
#     the intrinsics freeze natively (IBEX_NATIVE_LOCKDOWN) instead of a JS walk.
#
diff --git a/include/hermes/VM/Runtime.h b/include/hermes/VM/Runtime.h
index aeb865ed6..66b65c3db 100644
--- a/include/hermes/VM/Runtime.h
+++ b/include/hermes/VM/Runtime.h
@@ -1008,6 +1008,14 @@ class Runtime : public RuntimeBase, public HandleRootOwner {
     pendingPackageIdSet_ = true;
   }
 
+  /// Clear the pending package id so the next Domain falls back to the default
+  /// principal. Distinct from setPendingPackageId(0), which pins root. The loader
+  /// clears (not pins 0) after a compile so that a later eval/Function is
+  /// recognised as unlabelled and inherits its caller. @ref LLP 0013#mechanism-2
+  void clearPendingPackageId() {
+    pendingPackageIdSet_ = false;
+  }
+
   /// The principal stamped onto Domains created with no pending id set — used to
   /// mark runtime-internal code (bootstrap, the module loader) with the runtime
   /// principal during boot, then reset to the root principal so that eval/Function
@@ -1043,6 +1051,20 @@ class Runtime : public RuntimeBase, public HandleRootOwner {
     anyCompartmentActive_ = true;
   }
 
+  /// @ref LLP 0013#mechanism-2 (Phase 3) — set/consume the pending compartment
+  /// global (a HermesValue holding a JSObject, or undefined). Captured at the
+  /// eval call site from the caller's frame and consumed by runBytecode() to
+  /// bind eval/Function-produced code to the caller's compartment. Rooted via
+  /// the pendingCompartment_ PinnedValue so it survives allocations in between.
+  void setPendingCompartment(HermesValue v) {
+    pendingCompartment_ = v;
+  }
+  HermesValue consumePendingCompartment() {
+    HermesValue v = *pendingCompartment_;
+    pendingCompartment_ = HermesValue::encodeUndefinedValue();
+    return v;
+  }
+
   experiments::VMExperimentFlags getVMExperimentFlags() const {
