+// RUN: %hermes %s | %FileCheck --match-full-lines %s
+// RUN: %hermes -Xmicrotask-queue %s | %FileCheck --match-full-lines %s
+
+var originalRejected = 0;
+var originalHandled = 0;
+var replacementRejected = 0;
+
+HermesInternal.enablePromiseRejectionTracker({
+  checkpointRejections: true,
+  onRejectedAtCheckpoint: function () {
+    ++originalRejected;
+  },
+  onHandledAtCheckpoint: function () {
+    ++originalHandled;
+  },
+});
+
+// Package code runs after the embedder installs checkpoint tracking. It must
+// not be able to replace the host's callbacks through the public hook.
+HermesInternal.enablePromiseRejectionTracker({
+  checkpointRejections: true,
+  onRejectedAtCheckpoint: function () {
+    ++replacementRejected;
+  },
+  onHandledAtCheckpoint: function () {},
+});
+
+var rejected = Promise.reject("locked");
+print(originalRejected, replacementRejected);
+// CHECK: 1 0
+
+rejected.catch(function () {});
+print(originalHandled, replacementRejected);
+// CHECK-NEXT: 1 0
