{
  "exampleSchema": "ibex/capsec-selector-examples/1",
  "selectors": [
    {
      "cap": "clipboard:read",
      "resource": {
        "kind": "clipboard",
        "selection": "system",
        "formats": ["text"]
      }
    },
    {
      "cap": "device:camera",
      "resource": {
        "kind": "camera",
        "facing": "back",
        "media": ["photo", "video"]
      }
    },
    {
      "cap": "device:location",
      "resource": {
        "kind": "device-location",
        "usage": "foreground",
        "precision": "precise"
      }
    },
    {
      "cap": "device:microphone",
      "resource": {
        "kind": "microphone",
        "media": "audio"
      }
    },
    {
      "cap": "env:read",
      "resource": {
        "kind": "environment-name",
        "target": "broker-base",
        "name": "API_TOKEN"
      }
    },
    {
      "cap": "fs:read",
      "resource": {
        "kind": "path-exact",
        "path": {
          "root": "project",
          "components": [
            { "encoding": "utf8", "value": "config" },
            { "encoding": "utf8", "value": "app.json" }
          ]
        }
      }
    },
    {
      "cap": "fs:write",
      "resource": {
        "kind": "path-tree",
        "path": {
          "root": "project",
          "components": [
            { "encoding": "utf8", "value": "out" }
          ]
        }
      }
    },
    {
      "cap": "gpu:operation",
      "resource": {
        "kind": "gpu-operation",
        "profileId": "exact-webgpu-v1-draft",
        "profileDigest": "sha256-7tqDeE_0KXdgYZy331Tw4vInpwViVhkJxH7MncMjLZU",
        "webgpuCVocabularyDigest": "sha256-LQX5IbUTGfNs4TdV4mCH0cPfdvS-ozh0Y9pAW82rmD8",
        "operationSetDigest": "sha256--xIQesQthJUGflDwlrTWxK7Z4_KvZNbRR_nJnvyqZoc",
        "semanticProgramDigest": "sha256-qblwPVmzuQa6iI_zP6yFMT-vwnhfDdNk5rVkim70atY",
        "runtimeRoutingDigest": "sha256-189MIB-1igoFzWXNULDrPrKmTMF8RyTgB56DWbPmO_c",
        "operationId": "GPUBuffer.mapAsync"
      }
    },
    {
      "cap": "lifecycle:exit",
      "resource": {
        "kind": "session-lifecycle",
        "disposition": "exit-request"
      }
    },
    {
      "cap": "network:connect",
      "resource": {
        "kind": "connect-endpoint",
        "transport": "wss",
        "host": { "kind": "dns-name", "name": "events.example.com" },
        "port": { "kind": "exact", "value": 443 },
        "peerClasses": ["public"],
        "route": { "kind": "direct" }
      }
    },
    {
      "cap": "network:connect",
      "resource": {
        "kind": "connect-unix",
        "socketType": "stream",
        "address": {
          "kind": "path",
          "path": {
            "root": "tmp",
            "components": [
              { "encoding": "utf8", "value": "service.sock" }
            ]
          }
        }
      }
    },
    {
      "cap": "network:fetch",
      "resource": {
        "kind": "fetch-endpoint",
        "schemes": ["https"],
        "host": { "kind": "dns-name", "name": "api.example.com" },
        "port": { "kind": "exact", "value": 443 },
        "peerClasses": ["public"],
        "route": { "kind": "direct" }
      }
    },
    {
      "cap": "network:listen",
      "resource": {
        "kind": "listen-inet",
        "transport": "tcp",
        "bind": { "kind": "loopback" },
        "port": { "kind": "ephemeral" },
        "dualStack": false,
        "peerClasses": ["loopback"]
      }
    },
    {
      "cap": "network:listen",
      "resource": {
        "kind": "listen-unix",
        "socketType": "stream",
        "address": {
          "kind": "path",
          "path": {
            "root": "tmp",
            "components": [
              { "encoding": "utf8", "value": "ibex.sock" }
            ]
          }
        }
      }
    },
    {
      "cap": "network:resolve",
      "resource": {
        "kind": "dns-query",
        "name": "api.example.com",
        "absolute": true,
        "recordTypes": ["A", "AAAA"],
        "resolver": "system"
      }
    },
    {
      "cap": "path:cwd-mutate",
      "resource": {
        "kind": "path-exact",
        "path": {
          "root": "project",
          "components": [
            { "encoding": "utf8", "value": "src" }
          ]
        }
      }
    },
    {
      "cap": "path:cwd-observe",
      "resource": {
        "kind": "session-state",
        "name": "cwd"
      }
    },
    {
      "cap": "process:spawn",
      "resource": {
        "kind": "executable",
        "logicalName": "git",
        "path": {
          "root": "absolute",
          "components": [
            { "encoding": "utf8", "value": "usr" },
            { "encoding": "utf8", "value": "bin" },
            { "encoding": "utf8", "value": "git" }
          ],
          "hostBound": true
        },
        "contentDigest": "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      }
    },
    {
      "cap": "stdio:read",
      "resource": {
        "kind": "stdio",
        "stream": "stdin",
        "source": { "kind": "pipe", "identity": "pipe:stdin:1" }
      }
    },
    {
      "cap": "sys:read",
      "resource": {
        "kind": "system-info",
        "name": "platform"
      }
    }
  ]
}
