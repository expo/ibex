+  auto merged = captureJobConstrainedPrincipals(runtime);
+  bool valid = true;
+  for (uint32_t argument = 0; argument < 2; ++argument) {
+    appendJobConstrainedPrincipalsToken(
+        runtime, args, argument, true, merged, valid);
+  }
+  return jobConstrainedPrincipalsToken(runtime, merged);
