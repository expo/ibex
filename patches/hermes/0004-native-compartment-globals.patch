+  /// Set the per-package compartment global for this Domain's code.
+  /// @ref LLP 0013#mechanism-2
+  void setCompartmentGlobal(Runtime &runtime, JSObject *obj) {
+    compartmentGlobal_.set(runtime, obj, runtime.getHeap());
+    hasCompartmentGlobal_ = obj != nullptr;
+  }
+
   /// Create a Domain with no associated RuntimeModules.
   static PseudoHandle<Domain> create(Runtime &runtime);
 
