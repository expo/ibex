{
  "name": "@ibex/runtime-js",
  "version": "0.1.0",
  "description": "JavaScript runtime and polyfill layer for Ibex",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./bootstrap": {
      "import": "./src/bootstrap.ts",
      "types": "./src/bootstrap.ts"
    },
    "./abort": {
      "import": "./src/abort/index.ts",
      "types": "./src/abort/index.ts"
    },
    "./arraybuffer-detach": {
      "import": "./src/arraybuffer-detach.ts",
      "types": "./src/arraybuffer-detach.ts"
    },
    "./blob": {
      "import": "./src/blob/index.ts",
      "types": "./src/blob/index.ts"
    },
    "./clone": {
      "import": "./src/clone/index.ts",
      "types": "./src/clone/index.ts"
    },
    "./camera": {
      "import": "./src/camera/index.ts",
      "types": "./src/camera/index.ts"
    },
    "./events": {
      "import": "./src/events/index.ts",
      "types": "./src/events/index.ts"
    },
    "./fetch": {
      "import": "./src/fetch/index.ts",
      "types": "./src/fetch/index.ts"
    },
    "./fetch/native-bridge": {
