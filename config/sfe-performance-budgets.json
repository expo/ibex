      "factoryTableDisposition": "undecided-pending-measurement",
      "fixtureConstraints": {
        "helloHbcMaximumRecords": 5,
        "largeGraphHbcMinimumRecords": 40,
        "helloFactoryTableMaximumRecords": 5
      },
      "maximums": {
