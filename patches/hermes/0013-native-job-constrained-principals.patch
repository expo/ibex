+/// itself be replaced by user code. An absent or malformed token collapses to
+/// the fail-closed no-user principal.
+CallResult<HermesValue>
+hermesInternalCallThenWithConstrainedPrincipals(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  auto callable = args.dyncastArg<Callable>(0);
+  if (!callable) {
+    return runtime.raiseTypeError(
+        "First argument to constrained Promise then call must be callable");
