{
  "name": "ibex-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:builtins": "bun packages/ibex-devtools/src/scripts/build-builtins.mjs --src-dir src/builtins --out-dir vendored-generated/builtins",
    "build:runtime": "bun packages/ibex-devtools/src/scripts/rolldown-bundle.mjs --entry packages/ibex-runtime-js/src/runtime-entry.ts --out vendored-generated/embedded_runtime_bundle.js --format iife --lower-classes",
    "generate:capability-bits": "bun packages/ibex-devtools/src/scripts/generate-capability-bits.mjs",
    "generate:identity": "bun packages/ibex-devtools/src/scripts/generate-runtime-identity.ts",
    "generate:modules": "bun packages/ibex-devtools/src/scripts/generate-module-manifest.ts",
    "refresh:vendored": "IBEX_REGENERATE_RUNTIME=1 IBEX_UPDATE_VENDORED_GENERATED=1 cargo build --features openssl-crypto",
    "test": "bun test packages"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-classes": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^6.1.0",
    "acorn": "^8.15.0",
    "rolldown": "^1.0.0-rc.4",
    "terser": "^5.31.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.0"
  }
}
