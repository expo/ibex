{
  "name": "ibex-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:builtins": "bun packages/ibex-devtools/src/scripts/build-builtins.mjs --src-dir src/builtins --out-dir vendored-generated/builtins",
    "build:runtime": "bun packages/ibex-devtools/src/scripts/rolldown-bundle.mjs --entry packages/ibex-runtime-js/src/runtime-entry.ts --out vendored-generated/embedded_runtime_bundle.js --format iife --lower-classes",
    "generate:capability-bits": "bun packages/ibex-devtools/src/scripts/generate-capability-bits.mjs",
    "generate:capsec-contract": "bun packages/ibex-devtools/src/scripts/capsec-contract.mjs --write",
    "generate:capsec-registry": "bun packages/ibex-devtools/src/scripts/generate-capsec-registry.mjs --write",
    "generate:restricted-exact-profile": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-profile.mjs --write",
    "generate:restricted-exact-absence-probe-plan": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-absence-probe-plan.mjs --write",
    "generate:restricted-exact-macos-report": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-target-report.mjs capsec/conformance/evidence/restricted-exact/reachable-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/control-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/absence-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/global-corpora-aarch64-apple-darwin-04a08eeb.json capsec/conformance/restricted-exact-aarch64-apple-darwin-report.json --failed-review=capsec/conformance/reviews/restricted-exact-aarch64-apple-darwin-041fbd55.json --write",
    "generate:capsec-conformance": "bun packages/ibex-devtools/src/scripts/generate-capsec-conformance.mjs",
    "generate:capsec-recipes": "bun packages/ibex-devtools/src/scripts/generate-capsec-conformance-recipes.mjs",
    "verify:capsec-conformance": "bun packages/ibex-devtools/src/scripts/run-capsec-conformance.mjs",
    "generate:identity": "bun packages/ibex-devtools/src/scripts/generate-runtime-identity.ts",
    "generate:import-grant-keys": "bun packages/ibex-devtools/src/scripts/generate-import-grant-keys.mjs --write",
    "check:import-grant-keys": "bun packages/ibex-devtools/src/scripts/generate-import-grant-keys.mjs --check",
    "generate:repl-surface": "bun packages/ibex-devtools/src/scripts/generate-repl-surface.mjs --write",
    "check:repl-surface": "bun packages/ibex-devtools/src/scripts/generate-repl-surface.mjs --check",
    "generate:session-constants": "bun packages/ibex-devtools/src/scripts/generate-session-constants.mjs --write",
    "check:session-constants": "bun packages/ibex-devtools/src/scripts/generate-session-constants.mjs --check",
    "generate:interrupt-machine": "bun packages/ibex-devtools/src/scripts/generate-interrupt-machine.mjs --write",
    "check:interrupt-machine": "bun packages/ibex-devtools/src/scripts/generate-interrupt-machine.mjs --check",
    "generate:session-semantics": "bun packages/ibex-devtools/src/scripts/session-semantics-model.mjs --write",
    "check:session-semantics": "bun packages/ibex-devtools/src/scripts/session-semantics-model.mjs --check",
    "generate:vfs-error-union": "bun packages/ibex-devtools/src/scripts/generate-vfs-error-union.mjs --write",
    "check:vfs-error-union": "bun packages/ibex-devtools/src/scripts/generate-vfs-error-union.mjs --check",
    "generate:root-global-dispositions": "bun packages/ibex-devtools/src/scripts/generate-root-global-dispositions.mjs --write",
    "check:root-global-dispositions": "bun packages/ibex-devtools/src/scripts/generate-root-global-dispositions.mjs --check",
    "generate:runtime-environment-inventory": "bun packages/ibex-devtools/src/scripts/generate-runtime-environment-inventory.mjs --write",
    "check:runtime-environment-inventory": "bun packages/ibex-devtools/src/scripts/generate-runtime-environment-inventory.mjs --check",
    "generate:modules": "bun packages/ibex-devtools/src/scripts/generate-module-manifest.ts --rust-out-dir vendored-generated",
    "generate:vendored-fingerprint": "bun packages/ibex-devtools/src/scripts/generate-vendored-source-fingerprint.mjs",
    "refresh:vendored": "IBEX_REGENERATE_RUNTIME=1 IBEX_UPDATE_VENDORED_GENERATED=1 cargo build --features openssl-crypto",
    "regenerate:vendored": "scripts/regenerate-vendored.sh",
    "check:drift": "scripts/check-generated-drift.sh",
    "check:capsec-contract": "bun packages/ibex-devtools/src/scripts/capsec-contract.mjs --check",
    "check:capsec-registry": "bun packages/ibex-devtools/src/scripts/generate-capsec-registry.mjs --check",
    "check:restricted-exact-profile": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-profile.mjs --check",
    "check:restricted-exact-absence-probe-plan": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-absence-probe-plan.mjs --check",
    "check:restricted-exact-macos-report": "bun packages/ibex-devtools/src/scripts/generate-restricted-exact-target-report.mjs capsec/conformance/evidence/restricted-exact/reachable-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/control-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/absence-aarch64-apple-darwin-04a08eeb.json capsec/conformance/evidence/restricted-exact/global-corpora-aarch64-apple-darwin-04a08eeb.json capsec/conformance/restricted-exact-aarch64-apple-darwin-report.json --failed-review=capsec/conformance/reviews/restricted-exact-aarch64-apple-darwin-041fbd55.json --check",
    "check:example-policy": "bun packages/ibex-devtools/src/scripts/check-generated-policies.mjs",
    "test:android-java": "scripts/test-android-java.sh",
    "test": "bun test packages",
    "test:hermes-compat": "node packages/ibex-devtools/src/scripts/run-hermes-compat-corpus.mjs && node packages/ibex-devtools/src/scripts/run-hermes-compat-loader.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-classes": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^6.1.0",
    "ajv": "^8.17.1",
    "rolldown": "^1.0.0-rc.4",
    "terser": "^5.31.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.0"
  }
}
