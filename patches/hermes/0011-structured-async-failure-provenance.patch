+      ->currentJobIdentity();
+}
+
+HERMES_EXPORT uint64_t ex_hermes_vm_current_job_associated_evaluation(
+    void *vmRuntime) {
+  if (!vmRuntime)
+    return 0;
+  return reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)
+      ->currentJobAssociatedEvaluation();
+}
+
+HERMES_EXPORT void ex_hermes_vm_set_job_associated_evaluation(
+    void *vmRuntime,
