 namespace hermes {
 namespace vm {
 
+/// @ref LLP 0013#mechanism-2 (Phase 3) — resolve the global object for the
+/// currently-executing frame. If the frame's Domain carries a compartment
+/// global (a per-package global that withholds powerful globals), bare-global
+/// references and sloppy-mode `this` resolve to it; otherwise, and in the common
+/// case, to the shared real global. One load plus a predicted-not-taken branch
+/// on the hot path.
+static LLVM_ATTRIBUTE_ALWAYS_INLINE HermesValue
+globalForFrame(Runtime &runtime, CodeBlock *cb) {
+  if (LLVM_LIKELY(cb)) {
+    Domain *d = cb->getRuntimeModule()->getDomainUnsafe(runtime);
+    if (JSObject *cg = d->getCompartmentGlobal(runtime))
+      return HermesValue::encodeObjectValue(cg);
+  }
+  return runtime.getGlobal().getHermesValue();
+}
