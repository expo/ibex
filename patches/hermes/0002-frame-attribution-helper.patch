# LLP 0013 Hermes patch 0002 — frame-derived capability attribution
# Class: A (two additive files) + B (one CMakeLists source line)
# @ref LLP 0013#mechanism-3
#
# Adds VM::getCurrentPackageId(Runtime&), which walks the stack to the nearest
# JS frame and returns its Domain's packageId. Native (JSI host) frames have a
# null callee CodeBlock and are skipped — the RFC's Open-Q3 rule. This is the
# unforgeable replacement for the g_active_module_id thread-local.
diff --git a/include/hermes/VM/CapabilityAttribution.h b/include/hermes/VM/CapabilityAttribution.h
new file mode 100644
index 000000000..2b1a48add
