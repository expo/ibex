# LLP 0013 Hermes patch 0009 — bind package principal with its compartment
# Class: B (one existing native binder extension)
# @ref LLP 0013#mechanism-3
#
# The trusted CommonJS loader already binds each freshly compiled package
# function's Domain to its authenticated compartment after `new Function`.
# Extend that same private, boot-sealed binder to stamp and read back the package
# principal directly on the Domain, refusing invalid functions, compartments,
# principals, or missing RuntimeModule/Domain state. The existing pending path
# remains the creation-time mechanism and the eval/Function inheritance
# substrate, while this post-compile binding makes the module invariant explicit
# on source and HBC bootstrap profiles alike: compartment and principal describe
# the same authenticated package Domain.
diff --git a/lib/VM/JSLib/GlobalObject.cpp b/lib/VM/JSLib/GlobalObject.cpp
index 792a8df67..c911e7fab 100644
--- a/lib/VM/JSLib/GlobalObject.cpp
+++ b/lib/VM/JSLib/GlobalObject.cpp
@@ -35,27 +35,47 @@ namespace hermes {
 namespace vm {
 
 /// @ref LLP 0013#mechanism-2 — (Phase 3) — bind a compartment global to a
-/// compiled function's Domain. __exactSetCompartmentFor(fn, obj): after the
-/// loader compiles a package's module body (`new Function(...)`), it calls this
-/// to set that Domain's compartment global, so bare-global references in the
-/// package's code (and any function it defines, which shares the Domain) resolve
-/// through `obj` instead of the real global. A no-op for native callees (no
-/// CodeBlock) — the loader only ever passes a freshly compiled JSFunction.
+/// compiled function's Domain. __exactSetCompartmentFor(fn, obj, packageId):
+/// after the loader compiles a package's module body (`new Function(...)`), it
+/// calls this to bind that Domain's compartment global and package principal as
+/// one invariant. Invalid functions, compartments, principals, or missing
+/// RuntimeModule/Domain state fail closed. The returned numeric id is the
+/// post-bind readback the loader must verify. @ref LLP 0013#mechanism-3
 CallResult<HermesValue> exactSetCompartmentFor(void *, Runtime &runtime) {
   NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
   JSFunction *fn = dyn_vmcast<JSFunction>(args.getArg(0));
   JSObject *obj = dyn_vmcast<JSObject>(args.getArg(1));
-  if (fn && obj) {
-    RuntimeModule *rm = fn->getRuntimeModule();
-    if (rm) {
-      if (Domain *domain = rm->getDomainUnsafe(runtime)) {
-        domain->setCompartmentGlobal(runtime, obj);
-        // Arm the interpreter's compartment fast-path guard.
-        runtime.markCompartmentActive();
-      }
-    }
-  }
-  return HermesValue::encodeUndefinedValue();
+  HermesValue packageId = args.getArg(2);
+  if (!fn)
+    return runtime.raiseTypeError(
+        "Package Domain binding requires a compiled JS function");
+  if (!obj)
+    return runtime.raiseTypeError(
+        "Package Domain binding requires a compartment object");
+  if (!packageId.isNumber())
+    return runtime.raiseTypeError(
+        "Package Domain binding requires a numeric principal");
+  double value = packageId.getNumber();
+  if (value != value || value < 0.0 || value > 4294967295.0 ||
+      static_cast<double>(static_cast<uint32_t>(value)) != value)
+    return runtime.raiseTypeError(
+        "Package Domain binding principal must be a uint32");
+  RuntimeModule *rm = fn->getRuntimeModule();
+  if (!rm)
+    return runtime.raiseTypeError(
+        "Package Domain binding requires a RuntimeModule");
+  Domain *domain = rm->getDomainUnsafe(runtime);
+  if (!domain)
+    return runtime.raiseTypeError(
+        "Package Domain binding requires a live Domain");
+  uint32_t id = static_cast<uint32_t>(value);
+  domain->setCompartmentGlobal(runtime, obj);
+  domain->setPackageId(id);
+  // Arm the interpreter's compartment fast-path guard.
+  runtime.markCompartmentActive();
+  if (domain->getPackageId() != id)
+    return runtime.raiseTypeError("Package Domain principal readback failed");
+  return HermesValue::encodeTrustedNumberValue(domain->getPackageId());
 }
 
