+  reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)
+      ->setEmbedderJobAssociatedEvaluation(associatedEvaluation);
+}
+
+HERMES_EXPORT void ex_hermes_vm_set_embedder_job_scheduler_principal(
+    void *vmRuntime,
