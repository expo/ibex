{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schema/capsec-runtime-projection-v1.schema.json",
  "title": "Ibex compiled-runtime CapSec semantic projection v1",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "semanticCore",
    "acceptedSchemas",
    "definitions",
    "rules"
  ],
  "properties": {
    "schema": { "const": "ibex/capsec-runtime-projection/1" },
    "profile": { "type": "string", "minLength": 1 },
    "semanticCore": { "type": "string", "minLength": 1 },
    "acceptedSchemas": {
      "type": "object",
      "required": [
        "armedSnapshot",
        "canonicalPolicy",
        "capabilityDefinitions",
        "policyRules"
      ],
      "properties": {
        "armedSnapshot": { "const": "ibex/capsec-armed/1" },
        "canonicalPolicy": { "const": "ibex/capsec-policy/2" },
        "capabilityDefinitions": { "const": "ibex/capsec-definitions/1" },
        "policyRules": { "const": "ibex/capsec-rules/1" }
      },
      "additionalProperties": false
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "rules": { "type": "object" }
  },
  "additionalProperties": false
}
