diff --git a/lib/VM/JSLib/GlobalObject.cpp b/lib/VM/JSLib/GlobalObject.cpp
index ce55c5401..665ecc0a6 100644
--- a/lib/VM/JSLib/GlobalObject.cpp
+++ b/lib/VM/JSLib/GlobalObject.cpp
@@ -25,9 +25,35 @@
 
 #include "JSLibInternal.h"
 
+// @ref LLP 0013#mechanism-2 (Phase 3) — native compartment global binding.
+#include "hermes/VM/Domain.h"
+#include "hermes/VM/RuntimeModule-inline.h"
+
 namespace hermes {
 namespace vm {
 
+/// @ref LLP 0013#mechanism-2 (Phase 3) — bind a compartment global to a
+/// compiled function's Domain. __exactSetCompartmentFor(fn, obj): after the
+/// loader compiles a package's module body (`new Function(...)`), it calls this
+/// to set that Domain's compartment global, so bare-global references in the
+/// package's code (and any function it defines, which shares the Domain) resolve
+/// through `obj` instead of the real global. A no-op for native callees (no
+/// CodeBlock) — the loader only ever passes a freshly compiled JSFunction.
+CallResult<HermesValue> exactSetCompartmentFor(void *, Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  JSFunction *fn = dyn_vmcast<JSFunction>(args.getArg(0));
+  JSObject *obj = dyn_vmcast<JSObject>(args.getArg(1));
+  if (fn && obj) {
+    RuntimeModule *rm = fn->getRuntimeModule();
+    if (rm) {
+      if (Domain *domain = rm->getDomainUnsafe(runtime)) {
+        domain->setCompartmentGlobal(runtime, obj);
+      }
+    }
+  }
+  return HermesValue::encodeUndefinedValue();
+}
+
