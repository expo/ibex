@@ -111,10 +111,21 @@ namespace vm {
 /// on the hot path.
 static LLVM_ATTRIBUTE_ALWAYS_INLINE HermesValue
 globalForFrame(Runtime &runtime, CodeBlock *cb) {
+  // Fast path: until the first compartment is installed anywhere, every frame
+  // resolves to the real global — a single predicted-not-taken branch.
+  if (LLVM_LIKELY(!runtime.anyCompartmentActive()))
+    return runtime.getGlobal().getHermesValue();
+  // Second fast path (ENG-22948): a compartment exists somewhere, but this
+  // frame's Domain has none — the common case for root/first-party code even
+  // after a dependency installs one. hasCompartmentGlobal() is a POD read, so we
+  // skip the GCPointer read barrier on compartmentGlobal_ unless this frame's
+  // OWN Domain actually carries a compartment.
   if (LLVM_LIKELY(cb)) {
     Domain *d = cb->getRuntimeModule()->getDomainUnsafe(runtime);
-    if (JSObject *cg = d->getCompartmentGlobal(runtime))
-      return HermesValue::encodeObjectValue(cg);
+    if (LLVM_UNLIKELY(d->hasCompartmentGlobal())) {
+      if (JSObject *cg = d->getCompartmentGlobal(runtime))
+        return HermesValue::encodeObjectValue(cg);
+    }
   }
   return runtime.getGlobal().getHermesValue();
 }
