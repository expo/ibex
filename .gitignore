/target
/node_modules
/packages/*/node_modules
/packages/*/dist
/ios/Frameworks
/ios/Frameworks-vanilla
/android
/linux
/tools/hermes
/tools/hermes-vanilla
.agent-skill-sources/
.agent-skill-backups/
vendored-generated/*.deps.json
*.o
# The published ring crate uses these checked-in NASM objects on Windows so
# consumers do not need an assembler. They are source inputs, not build output.
!vendor/ring/pregenerated/*.o
*.a.tmp

# Local secrets and environment overrides. Keep example templates trackable.
.env
.env.*
!.env.example
*.env
secrets.env

# Local LLP run bookkeeping (ship runs etc.), matching the snapback convention
.llp/
/ios/Frameworks-vanilla-nodebug
/**/.ibex2
