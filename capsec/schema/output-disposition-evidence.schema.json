{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/output-disposition-evidence.schema.json",
  "title": "Ibex loaded-engine output-disposition evidence",
  "type": "object",
  "required": [
    "outputDispositionEvidenceSchema",
    "profile",
    "status",
    "requiredExecutor",
    "observations"
  ],
  "properties": {
    "outputDispositionEvidenceSchema": {
      "const": "ibex/capsec-output-disposition-evidence/2"
    },
    "profile": { "const": "ibex/capsec/1" },
    "status": { "enum": ["unpromotable", "verified"] },
    "requiredExecutor": { "$ref": "#/$defs/nonEmptyString" },
    "reason": { "$ref": "#/$defs/nonEmptyString" },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "engineBinaryDigest": { "$ref": "#/$defs/digest" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "unpromotable" } },
        "required": ["status"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": { "$ref": "#/$defs/nonEmptyString" },
          "sourceRevision": false,
          "engineBinaryDigest": false,
          "observations": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "verified" } },
        "required": ["status"]
      },
      "then": {
        "required": ["sourceRevision", "engineBinaryDigest"],
        "properties": {
          "reason": false,
          "sourceRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "engineBinaryDigest": { "$ref": "#/$defs/digest" },
          "observations": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "key": {
      "type": "object",
      "required": [
        "surfaceId",
        "output",
        "alias",
        "mode",
        "sourceKind",
        "returnVariant",
        "contextId"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "pattern": "^surface\\.[a-z0-9.]+$"
        },
        "output": { "$ref": "#/$defs/nonEmptyString" },
        "alias": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "$ref": "#/$defs/nonEmptyString" },
        "sourceKind": { "$ref": "#/$defs/nonEmptyString" },
        "returnVariant": { "$ref": "#/$defs/nonEmptyString" },
        "contextId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        }
      },
      "additionalProperties": false
    },
    "normalizedObservation": {
      "type": "object",
      "required": ["outcome", "normalizedValue"],
      "properties": {
        "outcome": {
          "enum": ["absent", "return", "throw", "typed-return"]
        },
        "normalizedValue": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["key", "disposition", "proofKind", "observation"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "disposition": {
          "enum": [
            "virtual-absolute",
            "virtual-relative",
            "virtual-basename",
            "synthetic-source-id",
            "absent",
            "closed",
            "refused",
            "typed-logical",
            "reserved-constant",
            "non-path"
          ]
        },
        "proofKind": {
          "enum": [
            "compiled-runtime-return-record",
            "loaded-engine-descriptor",
            "loaded-engine-return-record"
          ]
        },
        "observation": { "$ref": "#/$defs/normalizedObservation" }
      },
      "additionalProperties": false
    }
  }
}
