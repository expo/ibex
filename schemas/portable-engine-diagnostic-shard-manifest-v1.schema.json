{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/portable-engine-diagnostic-shard-manifest-v1.schema.json",
  "title": "Ibex portable engine diagnostic shard manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifestDigest",
    "suiteLineageId",
    "suitePlanDigest",
    "assignmentDigest",
    "sourceRevision",
    "sourceTreeDigest",
    "target",
    "engineProfile",
    "featureSet",
    "coverageMapDigest",
    "registryDigest",
    "vocabularyDigest",
    "policyDigest",
    "implementationDigest",
    "recipeCatalogDigest",
    "portableEngine",
    "mappedEngine",
    "shardId",
    "authorityClass",
    "workflowRunId",
    "workflowRunAttempt",
    "shardAttempt",
    "expectedCommandIds",
    "expectedRecipeIds",
    "expectedFixtureIds",
    "timeoutPolicyVersion",
    "producer",
    "declaredOutputs"
  ],
  "properties": {
    "schema": { "const": "ibex/portable-engine-diagnostic-shard-manifest/1" },
    "manifestDigest": {
      "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest",
      "$comment": "SHA-256 over JCS(shard manifest without manifestDigest), domain ibex.portable-engine-diagnostic-shard-manifest.v1 followed by one NUL byte."
    },
    "suiteLineageId": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stableId" },
    "suitePlanDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "assignmentDigest": {
      "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest",
      "$comment": "SHA-256 over the complete shard-assignment JCS, domain ibex.portable-engine-shard-assignment.v1 followed by one NUL byte."
    },
    "sourceRevision": { "$ref": "portable-engine-common-v1.schema.json#/$defs/sourceRevision" },
    "sourceTreeDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "target": { "$ref": "portable-engine-common-v1.schema.json#/$defs/target" },
    "engineProfile": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stableId" },
    "featureSet": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stringSet" },
    "coverageMapDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "registryDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "vocabularyDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "policyDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "implementationDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "recipeCatalogDigest": { "$ref": "portable-engine-common-v1.schema.json#/$defs/semanticDigest" },
    "portableEngine": { "$ref": "portable-engine-artifact-identity-v1.schema.json" },
    "mappedEngine": { "$ref": "mapped-engine-instance-identity-v1.schema.json" },
    "shardId": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stableId" },
    "authorityClass": { "const": "diagnostic" },
    "workflowRunId": { "$ref": "portable-engine-common-v1.schema.json#/$defs/positiveSafeInteger" },
    "workflowRunAttempt": { "$ref": "portable-engine-common-v1.schema.json#/$defs/positiveSafeInteger" },
    "shardAttempt": { "$ref": "portable-engine-common-v1.schema.json#/$defs/positiveSafeInteger" },
    "expectedCommandIds": { "$ref": "portable-engine-common-v1.schema.json#/$defs/idSet" },
    "expectedRecipeIds": { "$ref": "portable-engine-common-v1.schema.json#/$defs/idSet" },
    "expectedFixtureIds": { "$ref": "portable-engine-common-v1.schema.json#/$defs/idSet" },
    "timeoutPolicyVersion": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stableId" },
    "producer": { "$ref": "#/$defs/producer" },
    "declaredOutputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "portable-engine-common-v1.schema.json#/$defs/declaredOutput" }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": { "$ref": "portable-engine-common-v1.schema.json#/$defs/stableId" },
        "version": { "$ref": "portable-engine-common-v1.schema.json#/$defs/nonEmptyString" }
      }
    }
  }
}
