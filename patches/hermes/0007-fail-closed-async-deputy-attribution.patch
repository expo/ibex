diff --git a/lib/VM/Runtime.cpp b/lib/VM/Runtime.cpp
index 1cadc9340..98c12dbf0 100644
--- a/lib/VM/Runtime.cpp
+++ b/lib/VM/Runtime.cpp
@@ -1304,6 +1304,15 @@ Handle<JSObject> Runtime::runInternalJavaScript() {
   // is enabled, because the Promise implementation is a built-in.
   flags.funcsAreBuiltins = hasMicrotaskQueue();
 
+  // @ref LLP 0013#mechanism-3 — the internal bytecode (the JS Promise
+  // implementation etc.) is a runtime deputy, not first-party code. Stamp its
+  // Domain with the runtime principal (0xFFFFFFFF) so the capability frame walk
+  // SKIPS it. Otherwise it loads during Runtime construction with the default
+  // principal 0 and its reaction trampolines (`tryCallOne`) sit on the stack
+  // during every promise/microtask job with packageId 0 — indistinguishable from
+  // first-party root, which lets a package launder a deputy op detached from its
+  // own frame (`Promise.resolve(x).then(fs.readFileSync)`) into the root principal.
+  setPendingPackageId(0xFFFFFFFFu);
   auto res = runBytecode(
       std::move(bcResult.first),
       flags,
