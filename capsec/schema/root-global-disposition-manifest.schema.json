{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/root-global-disposition-manifest.schema.json",
  "title": "Ibex generated root-global disposition manifest",
  "type": "object",
  "required": [
    "rootGlobalDispositionManifestSchema",
    "profile",
    "status",
    "sourceDigest",
    "sweep",
    "registryJoin",
    "rows",
    "counts"
  ],
  "properties": {
    "rootGlobalDispositionManifestSchema": {
      "const": "ibex/root-global-disposition-manifest/1"
    },
    "profile": { "const": "ibex/capsec/1" },
    "status": { "const": "enforced-by-armed-live-sweep" },
    "sourceDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" }
      ]
    },
    "sweep": {
      "type": "object",
      "required": [
        "roots",
        "descriptorOnly",
        "invokeGetters",
        "includeNonEnumerable",
        "includePrototypes",
        "includeSymbols",
        "cyclePolicy",
        "descriptorLeafRoots",
        "maxDepth",
        "maxDescriptors",
        "maxObjects"
      ],
      "properties": {
        "roots": {
          "const": ["globalThis"]
        },
        "descriptorOnly": { "const": true },
        "invokeGetters": { "const": false },
        "includeNonEnumerable": { "const": true },
        "includePrototypes": { "const": true },
        "includeSymbols": { "const": true },
        "cyclePolicy": { "const": "object-identity-once-per-root" },
        "descriptorLeafRoots": {
          "const": ["localStorage", "sessionStorage"]
        },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxDescriptors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxObjects": { "type": "integer", "minimum": 1, "maximum": 65536 }
      },
      "additionalProperties": false
    },
    "registryJoin": {
      "type": "object",
      "required": ["coverageSchema", "edgeIds"],
      "properties": {
        "coverageSchema": { "const": "ibex/capsec-coverage/1" },
        "edgeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "counts": {
      "type": "object",
      "required": [
        "installBranches",
        "logicalGlobals",
        "registryEdges",
        "sealedOrPrivate",
        "permittedReachable"
      ],
      "properties": {
        "installBranches": { "type": "integer", "minimum": 1 },
        "logicalGlobals": { "type": "integer", "minimum": 1 },
        "registryEdges": { "type": "integer", "minimum": 1 },
        "sealedOrPrivate": { "type": "integer", "minimum": 1 },
        "permittedReachable": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "propertyKey": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "string",
            "well-known-symbol",
            "dynamic-table",
            "return-value"
          ]
        },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "propertyPath": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": { "$ref": "#/$defs/propertyKey" },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyKey" }
        }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["id", "routes", "sourceRefs", "targetVariant", "activation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "targetVariant": { "type": "string", "minLength": 1 },
        "activation": {
          "enum": [
            "always",
            "android-platform-state",
            "baseline-input",
            "bun-compat-shared-or-legacy-fallback",
            "bun-compat-shared-runtime",
            "diagnostic-unarmed-promise-fallback",
            "host-navigator-copy",
            "intrinsic-reference-only",
            "ipc-channel-bootstrap",
            "shared-runtime-bundle",
            "legacy-runtime-fallback",
            "openssl-crypto",
            "post-bootstrap-lazy",
            "web-streams-polyfill",
            "windows-native"
          ]
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "installId",
        "observedKey",
        "registryEdgeId",
        "branch",
        "property",
        "aliases",
        "installPhase",
        "privateConsumer",
        "disposition",
        "traversal",
        "liveExpectation",
        "resolution",
        "nativeImplementation"
      ],
      "properties": {
        "installId": {
          "type": "string",
          "pattern": "^root-global\\.[a-z0-9.]+\\.[a-f0-9]{16}$"
        },
        "observedKey": { "type": "string", "pattern": "^native-op:.+$" },
        "registryEdgeId": { "$ref": "common.schema.json#/$defs/stableId" },
        "branch": { "$ref": "#/$defs/branch" },
        "property": { "$ref": "#/$defs/propertyPath" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyPath" }
        },
        "installPhase": {
          "enum": [
            "engine-create",
            "native-install",
            "native-evaluated-script",
            "shared-runtime",
            "bootstrap-script",
            "source-derived"
          ]
        },
        "privateConsumer": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "disposition": {
          "enum": ["converted", "exposed", "private", "sealed"]
        },
        "traversal": { "enum": ["descend", "descriptor-leaf"] },
        "liveExpectation": { "enum": ["reachable", "absent"] },
        "resolution": { "type": "string", "minLength": 1 },
        "nativeImplementation": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
