+static CallResult<HermesValue> jobConstrainedPrincipalsToken(
+    Runtime &runtime,
+    const std::vector<uint32_t> &principals) {
+  auto arrayResult =
+      JSArray::create(runtime, principals.size(), principals.size());
+  if (arrayResult == ExecutionStatus::EXCEPTION)
+    return ExecutionStatus::EXCEPTION;
+  struct : public Locals {
+    PinnedValue<JSArray> array;
+  } lv;
+  LocalsRAII lraii(runtime, &lv);
+  lv.array = std::move(*arrayResult);
+  if (JSArray::setStorageEndIndex(lv.array, runtime, principals.size()) ==
+      ExecutionStatus::EXCEPTION) {
+    return ExecutionStatus::EXCEPTION;
+  }
+  for (size_t index = 0; index < principals.size(); ++index) {
+    JSArray::unsafeSetExistingElementAt(
+        *lv.array,
+        runtime,
+        index,
+        SmallHermesValue::encodeNumberValue(principals[index], runtime));
+  }
+  return lv.array.getHermesValue();
+}
