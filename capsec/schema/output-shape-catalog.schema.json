{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/output-shape-catalog.schema.json",
  "title": "Ibex independently discovered output-shape catalog",
  "type": "object",
  "required": [
    "outputShapeCatalogSchema",
    "profile",
    "discovery",
    "contexts",
    "surfaceAccounts",
    "parameterizedOutputBindings",
    "parameterizedBindingDigest",
    "catalogKeyDigest",
    "counts",
    "rows"
  ],
  "properties": {
    "outputShapeCatalogSchema": {
      "const": "ibex/capsec-output-shape-catalog/2"
    },
    "profile": { "const": "ibex/capsec/1" },
    "discovery": { "$ref": "#/$defs/discoveryState" },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executionContext" }
    },
    "surfaceAccounts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surfaceAccount" }
    },
    "parameterizedOutputBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameterizedOutputBinding" }
    },
    "parameterizedBindingDigest": { "$ref": "#/$defs/digest" },
    "catalogKeyDigest": { "$ref": "#/$defs/digest" },
    "counts": { "$ref": "#/$defs/counts" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/catalogRow" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "key": {
      "type": "object",
      "required": [
        "surfaceId",
        "output",
        "alias",
        "mode",
        "sourceKind",
        "returnVariant",
        "contextId"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "pattern": "^surface\\.[a-z0-9.]+$"
        },
        "output": { "$ref": "#/$defs/nonEmptyString" },
        "alias": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "$ref": "#/$defs/nonEmptyString" },
        "sourceKind": { "$ref": "#/$defs/nonEmptyString" },
        "returnVariant": { "$ref": "#/$defs/nonEmptyString" },
        "contextId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        }
      },
      "additionalProperties": false
    },
    "executionContext": {
      "type": "object",
      "required": [
        "contextId",
        "principalClass",
        "accessPhase",
        "runtimeState",
        "targetScope"
      ],
      "properties": {
        "contextId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "principalClass": {
          "enum": ["host", "package", "runtime-bootstrap"]
        },
        "accessPhase": {
          "enum": [
            "abi-call",
            "call",
            "callback-delivery",
            "import",
            "module-load",
            "property-read"
          ]
        },
        "runtimeState": { "enum": ["fresh", "initialized", "loaded"] },
        "targetScope": { "const": "candidate-target-cell" }
      },
      "additionalProperties": false
    },
    "surfaceAccount": {
      "type": "object",
      "required": [
        "surfaceId",
        "status",
        "reasonCode",
        "sourceRefs",
        "outputKinds"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "pattern": "^surface\\.[a-z0-9.]+$"
        },
        "status": {
          "enum": ["output-bearing", "structural-only", "unresolved"]
        },
        "reasonCode": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "outputKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "output-bearing" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "outputKinds": { "type": "array", "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "outputKinds": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "parameterizedOutputBinding": {
      "type": "object",
      "required": [
        "bindingSchema",
        "surfaceId",
        "surfaceName",
        "status",
        "reasonCode",
        "sourceRefs",
        "outputKinds",
        "accountSchema",
        "accountSetSource",
        "binding",
        "terminalSurfaces",
        "ordinaryCatalogRows"
      ],
      "properties": {
        "bindingSchema": { "$ref": "#/$defs/nonEmptyString" },
        "surfaceId": {
          "type": "string",
          "pattern": "^surface\\.[a-z0-9.]+$"
        },
        "surfaceName": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "const": "output-bearing" },
        "reasonCode": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyStringSet" },
        "outputKinds": { "$ref": "#/$defs/nonEmptyStringSet" },
        "accountSchema": { "$ref": "#/$defs/nonEmptyString" },
        "accountSetSource": { "$ref": "#/$defs/nonEmptyString" },
        "binding": { "$ref": "#/$defs/nonEmptyString" },
        "terminalSurfaces": {
          "type": "object",
          "required": ["enumerationRead", "scalarRead", "write"],
          "properties": {
            "enumerationRead": {
              "type": "object",
              "required": ["name", "readSurface", "surfaceId", "authorization"],
              "properties": {
                "name": { "const": "__exactGetAllEnv" },
                "readSurface": { "const": 1 },
                "surfaceId": {
                  "type": "string",
                  "pattern": "^surface\\.[a-z0-9.]+$"
                },
                "authorization": { "const": "nonempty-per-exact-name" }
              },
              "additionalProperties": false
            },
            "scalarRead": {
              "type": "object",
              "required": ["name", "readSurface", "surfaceId"],
              "properties": {
                "name": { "const": "__exactGetEnv" },
                "readSurface": { "const": 0 },
                "surfaceId": {
                  "type": "string",
                  "pattern": "^surface\\.[a-z0-9.]+$"
                }
              },
              "additionalProperties": false
            },
            "write": {
              "type": "object",
              "required": ["name", "surfaceId"],
              "properties": {
                "name": { "const": "__exactSetEnv" },
                "surfaceId": {
                  "type": "string",
                  "pattern": "^surface\\.[a-z0-9.]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ordinaryCatalogRows": { "const": "forbidden" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "coverageSurfaces",
        "outputBearingSurfaces",
        "structuralOnlySurfaces",
        "unresolvedSurfaces",
        "catalogRows",
        "parameterizedBindings",
        "sourceInventoryRows",
        "structuredRows"
      ],
      "properties": {
        "coverageSurfaces": { "type": "integer", "minimum": 0 },
        "outputBearingSurfaces": { "type": "integer", "minimum": 0 },
        "structuralOnlySurfaces": { "type": "integer", "minimum": 0 },
        "unresolvedSurfaces": { "type": "integer", "minimum": 0 },
        "catalogRows": { "type": "integer", "minimum": 0 },
        "parameterizedBindings": { "type": "integer", "minimum": 0 },
        "sourceInventoryRows": { "type": "integer", "minimum": 0 },
        "structuredRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "discoveryState": {
      "type": "object",
      "required": ["status", "method", "requiredExecutor"],
      "properties": {
        "status": { "enum": ["unpromotable", "verified"] },
        "method": {
          "const": "source-inventory-surface-accounting-plus-source-asserted-structured-outputs"
        },
        "requiredExecutor": {
          "const": "ibex-public-surface-harness/output-shape-sweep-v3"
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceTreeDigest": { "$ref": "#/$defs/digest" },
        "target": { "$ref": "#/$defs/target" },
        "engine": { "$ref": "#/$defs/engine" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unpromotable" } },
            "required": ["status"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": { "$ref": "#/$defs/nonEmptyString" },
              "sourceRevision": false,
              "sourceTreeDigest": false,
              "target": false,
              "engine": false
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          },
          "then": {
            "required": [
              "sourceRevision",
              "sourceTreeDigest",
              "target",
              "engine"
            ],
            "properties": {
              "reason": false,
              "sourceRevision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sourceTreeDigest": { "$ref": "#/$defs/digest" },
              "target": { "$ref": "#/$defs/target" },
              "engine": { "$ref": "#/$defs/engine" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["triple", "features"],
      "properties": {
        "triple": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,}$"
        },
        "features": { "$ref": "#/$defs/stableIdSet" }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": [
        "engineArtifactPath",
        "kind",
        "binaryDigest",
        "object",
        "targetArchitecture",
        "structuralFeatures"
      ],
      "properties": {
        "engineArtifactPath": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "const": "hermes" },
        "binaryDigest": { "$ref": "#/$defs/digest" },
        "object": {
          "type": "object",
          "required": ["platform", "volume", "file"],
          "properties": {
            "platform": { "enum": ["android", "apple", "unix", "windows"] },
            "volume": { "$ref": "#/$defs/nonEmptyString" },
            "file": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "targetArchitecture": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "structuralFeatures": { "$ref": "#/$defs/stableIdSet" }
      },
      "additionalProperties": false
    },
    "stableIdSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      }
    },
    "catalogRow": {
      "type": "object",
      "required": ["key", "discovery", "requiredValueProof"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "requiredValueProof": { "const": "live-value-observation" },
        "discovery": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "observedKeys", "sourceRefs"],
              "properties": {
                "kind": { "const": "source-inventory-surface" },
                "observedKeys": { "$ref": "#/$defs/nonEmptyStringSet" },
                "sourceRefs": { "$ref": "#/$defs/nonEmptyStringSet" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "sourceRefs"],
              "properties": {
                "kind": { "const": "source-asserted-structured-output" },
                "sourceRefs": { "$ref": "#/$defs/nonEmptyStringSet" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
