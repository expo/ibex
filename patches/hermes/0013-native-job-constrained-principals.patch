+/// Capture the effective carrier and authenticate the package that defined a
+/// bytecode callable. Async-generator lowering invokes _wrapAsyncGenerator at
+/// definition time, but the compatibility helper is also publicly reachable.
+/// Deriving the definition principal here prevents a package from lending that
+/// root-owned helper to a later clean deputy in order to wrap a package
+/// generator without its provenance.
+///
+/// Bound functions retain their bytecode target's package. Proxies and native
+/// or otherwise opaque callables deliberately fail closed: inspecting through
+/// a Proxy would itself trust attacker-controlled indirection.
+CallResult<HermesValue>
+hermesInternalCaptureCallableJobConstrainedPrincipals(
+    void *,
+    Runtime &runtime) {
+  NativeArgs args = runtime.getCurrentFrame().getNativeArgs();
+  auto callable = args.dyncastArg<Callable>(0);
+  auto merged = captureJobConstrainedPrincipals(runtime);
+  bool valid = true;
+  uint32_t definitionPrincipal = kNoUserPrincipal;
+  if (callable) {
+    if (const CodeBlock *codeBlock = getLeafCodeBlock(callable, runtime)) {
+      if (RuntimeModule *runtimeModule = codeBlock->getRuntimeModule()) {
+        if (Domain *domain = runtimeModule->getDomainUnsafe(runtime)) {
+          const uint32_t packageId = domain->getPackageId();
+          if (packageId != Runtime::kNoJobSchedulerPrincipal) {
+            definitionPrincipal = packageId;
+          }
+        }
+      }
+    }
+  }
+  appendDistinctJobConstrainedPrincipal(
+      merged, definitionPrincipal, valid);
+  return jobConstrainedPrincipalsToken(runtime, merged);
+}
