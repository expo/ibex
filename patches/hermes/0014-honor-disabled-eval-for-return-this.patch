@@ -208,6 +208,15 @@ HERMES_EXPORT void ex_hermes_vm_set_default_package_id(
   reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)->setDefaultPackageId(id);
 }
 
+/// Irreversibly close eval and Function-family string compilation after an
+/// embedder has completed trusted bootstrap. Host-side evaluateJavaScript is
+/// intentionally unaffected.
+HERMES_EXPORT void ex_hermes_vm_disable_eval(void *vmRuntime) {
+  if (!vmRuntime)
+    return;
+  reinterpret_cast<::hermes::vm::Runtime *>(vmRuntime)->disableEval();
+}
