+TEST(HermesKeyedExternalArrayBufferTest, AliasesShareBackingAndRequireMatchingKey) {
+  struct FixedBuffer final : MutableBuffer {
+    size_t size() const override {
+      return bytes.size();
+    }
+    uint8_t *data() override {
+      return bytes.data();
+    }
+
+    std::array<uint8_t, 16> bytes{};
+  };
+
+  auto rt = makeHermesRuntime();
+  auto *mappedBuffers = castInterface<IKeyedExternalArrayBuffer>(rt.get());
+  ASSERT_NE(mappedBuffers, nullptr);
+
+  auto backing = std::make_shared<FixedBuffer>();
+  backing->bytes[5] = 17;
+  ArrayBuffer source(*rt, backing);
+  auto alias = mappedBuffers->createKeyedExternalRangeAlias(source, 4, 6);
+  auto overlappingAlias =
+      mappedBuffers->createKeyedExternalRangeAlias(source, 5, 3);
+  ASSERT_EQ(alias.size(*rt), 6);
+  EXPECT_EQ(alias.data(*rt)[1], 17);
+  alias.data(*rt)[2] = 29;
+  EXPECT_EQ(backing->bytes[6], 29);
+  EXPECT_EQ(source.data(*rt)[6], 29);
+  EXPECT_EQ(overlappingAlias.data(*rt)[1], 29);
+
+#ifdef JSI_UNSTABLE
+  auto *serialization = castInterface<ISerialization>(rt.get());
+  ASSERT_NE(serialization, nullptr);
+  auto transfers = Array::createWithElements(*rt, Value(*rt, alias));
+  EXPECT_THROW(
+      serialization->serializeWithTransfer(Value(*rt, alias), transfers),
+      JSError);
+  EXPECT_EQ(alias.size(*rt), 6);
+#endif
+
+  EXPECT_THROW(
+      mappedBuffers->createKeyedExternalRangeAlias(alias, 0, 1),
+      JSINativeException);
+  EXPECT_FALSE(mappedBuffers->detachKeyedExternalRange(source));
+  EXPECT_EQ(source.size(*rt), backing->bytes.size());
+
+  EXPECT_TRUE(mappedBuffers->detachKeyedExternalRange(alias));
+  EXPECT_THROW(alias.size(*rt), JSINativeException);
+  EXPECT_FALSE(mappedBuffers->detachKeyedExternalRange(alias));
+  EXPECT_EQ(overlappingAlias.size(*rt), 3);
+  EXPECT_TRUE(mappedBuffers->detachKeyedExternalRange(overlappingAlias));
+  EXPECT_EQ(source.data(*rt)[6], 29);
+
+  auto internalValue = rt->evaluateJavaScript(
+      std::make_shared<StringBuffer>(
+          "var internalMappedSource = new ArrayBuffer(16);"
+          "new Uint8Array(internalMappedSource)[7] = 41;"
+          "internalMappedSource;"),
+      "keyed-external-internal-source.js");
+  auto internalSource =
+      internalValue.asObject(*rt).getArrayBuffer(*rt);
+  auto internalAlias =
+      mappedBuffers->createKeyedExternalRangeAlias(internalSource, 6, 4);
+  EXPECT_EQ(internalAlias.data(*rt)[1], 41);
+  internalAlias.data(*rt)[2] = 53;
+  EXPECT_EQ(internalSource.data(*rt)[8], 53);
+  EXPECT_TRUE(mappedBuffers->detachKeyedExternalRange(internalAlias));
+  EXPECT_EQ(internalSource.size(*rt), 16);
+  EXPECT_EQ(internalSource.data(*rt)[8], 53);
+}
