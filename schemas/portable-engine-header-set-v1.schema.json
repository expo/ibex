{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/portable-engine-header-set-v1.schema.json",
  "title": "Ibex portable engine header set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "targetTriple", "includeRoots", "headers"],
  "properties": {
    "schema": { "const": "ibex/portable-engine-header-set/1" },
    "targetTriple": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+){2,3}$"
    },
    "includeRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "portable-engine-common-v1.schema.json#/$defs/normalizedPayloadPath"
      }
    },
    "headers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "size"],
        "properties": {
          "path": {
            "$ref": "portable-engine-common-v1.schema.json#/$defs/normalizedPayloadPath"
          },
          "digest": {
            "$ref": "portable-engine-common-v1.schema.json#/$defs/rawDigest"
          },
          "size": {
            "$ref": "portable-engine-common-v1.schema.json#/$defs/safeInteger"
          }
        }
      }
    }
  }
}
