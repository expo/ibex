{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/schemas/application-binding-v1.schema.json",
  "title": "Ibex immutable app-bound parent binding v1",
  "type": "object",
  "required": ["schema", "origin", "appId", "engineCompatibility", "brokerProtocols", "releaseLineage"],
  "properties": {
    "schema": { "const": "ibex/app-bound-parent/1" },
    "origin": { "type": "string", "pattern": "^https://[^/?#@]+$" },
    "appId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "engineCompatibility": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "brokerProtocols": {
      "const": ["ibex/restricted-worker-broker/1"]
    },
    "releaseLineage": {
      "type": "object",
      "required": ["schema", "publisherKeyId", "channel", "recipeDigest"],
      "properties": {
        "schema": { "const": "ibex/app-cli-release-lineage/1" },
        "publisherKeyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "channel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recipeDigest": { "$ref": "app-bound-common-v1.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
