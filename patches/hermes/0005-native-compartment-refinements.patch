 /// found. Skips native frames, whose callee CodeBlock is null.
 uint32_t getCurrentPackageId(Runtime &runtime);
 
+/// \return the compartment global of the nearest user JS frame's Domain, or
+/// nullptr when none. A helper for binding eval/Function-produced code to the
+/// caller's compartment. @ref LLP 0013#mechanism-2
+JSObject *getCurrentCompartmentGlobal(Runtime &runtime);
+
 } // namespace vm
 } // namespace hermes
 
