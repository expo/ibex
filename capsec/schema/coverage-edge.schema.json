{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/coverage-edge.schema.json",
  "title": "Ibex capsec coverage-edge dataset",
  "type": "object",
  "required": ["coverageSchema", "profile", "edges"],
  "properties": {
    "coverageSchema": { "const": "ibex/capsec-coverage/1" },
    "profile": { "const": "ibex/capsec/1" },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/effectEdge" },
          { "$ref": "#/$defs/nonCapabilityEdge" },
          { "$ref": "#/$defs/closedEdge" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": [
            "builtin",
            "callback",
            "cli",
            "host-abi",
            "loader",
            "native-op",
            "startup"
          ]
        },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effectTemplate": {
      "type": "object",
      "required": [
        "cap",
        "selectorNormalizer",
        "occurrenceNormalizer",
        "stages",
        "positiveSources"
      ],
      "properties": {
        "cap": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
        },
        "selectorNormalizer": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "occurrenceNormalizer": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "requested",
              "discovery",
              "candidate",
              "commit",
              "delivery",
              "repeat",
              "cleanup"
            ]
          }
        },
        "positiveSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ambient-root",
              "handle",
              "implicit-self",
              "session",
              "static-floor"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "barriers": {
      "type": "object",
      "required": ["authorizeBefore", "recheckAt", "cancelAt"],
      "properties": {
        "authorizeBefore": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "recheckAt": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cancelAt": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "logicalBranch": {
      "type": "object",
      "required": [
        "id",
        "when",
        "effects",
        "principalSources",
        "effectOwnerSource",
        "lifetimeContract",
        "barriers"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["fact", "equals"],
            "properties": {
              "fact": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              },
              "equals": {
                "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
              }
            },
            "additionalProperties": false
          }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effectTemplate" }
        },
        "principalSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "descriptor-owner",
              "frame-set",
              "loader-referrer",
              "root",
              "runtime",
              "schedule-time"
            ]
          }
        },
        "effectOwnerSource": {
          "enum": [
            "descriptor-owner",
            "innermost-nontransparent-frame",
            "loader-referrer",
            "root",
            "runtime"
          ]
        },
        "lifetimeContract": {
          "enum": [
            "child-process",
            "file-handle",
            "listener",
            "none",
            "operation",
            "socket-stream",
            "watch"
          ]
        },
        "barriers": { "$ref": "#/$defs/barriers" }
      },
      "additionalProperties": false
    },
    "effectEdge": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "surface",
        "effects",
        "principalSources",
        "effectOwnerSource",
        "gate",
        "effectMode",
        "atomicityGroup",
        "lifetimeContract",
        "barriers"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "effects" },
        "surface": { "$ref": "#/$defs/surface" },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/effectTemplate" }
        },
        "principalSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "descriptor-owner",
              "frame-set",
              "loader-referrer",
              "root",
              "runtime",
              "schedule-time"
            ]
          }
        },
        "effectOwnerSource": {
          "enum": [
            "descriptor-owner",
            "innermost-nontransparent-frame",
            "loader-referrer",
            "root",
            "runtime"
          ]
        },
        "gate": {
          "enum": [
            "adds-op-gate",
            "loader-admission",
            "reachability-close",
            "reclassifies"
          ]
        },
        "effectMode": {
          "enum": ["conjunctive", "conditional", "conditional-unrefined"]
        },
        "logicalBranches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/logicalBranch" }
        },
        "refinementOwner": {
          "type": "string",
          "pattern": "^WP(?:[0-9]|1[01])$"
        },
        "rationale": { "type": "string", "minLength": 1 },
        "atomicityGroup": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "lifetimeContract": {
          "enum": [
            "child-process",
            "file-handle",
            "listener",
            "none",
            "operation",
            "socket-stream",
            "watch"
          ]
        },
        "barriers": { "$ref": "#/$defs/barriers" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effectMode": { "const": "conditional-unrefined" }
            },
            "required": ["effectMode"]
          },
          "then": {
            "required": ["refinementOwner", "rationale"],
            "properties": { "refinementOwner": true, "rationale": true }
          }
        },
        {
          "if": {
            "properties": { "effectMode": { "const": "conditional" } },
            "required": ["effectMode"]
          },
          "then": {
            "required": ["logicalBranches"],
            "properties": {
              "logicalBranches": true,
              "refinementOwner": false,
              "rationale": false
            }
          },
          "else": {
            "properties": { "logicalBranches": false }
          }
        }
      ],
      "additionalProperties": false
    },
    "nonCapabilityEdge": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "surface",
        "rationaleId",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "non-capability" },
        "surface": { "$ref": "#/$defs/surface" },
        "rationaleId": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "closedEdge": {
      "type": "object",
      "required": ["id", "classification", "surface", "cap", "rationale"],
      "properties": {
        "id": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/stableId"
        },
        "classification": { "const": "closed" },
        "surface": { "$ref": "#/$defs/surface" },
        "cap": {
          "$ref": "https://ibex.dev/capsec/schema/common.schema.json#/$defs/actionId"
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
