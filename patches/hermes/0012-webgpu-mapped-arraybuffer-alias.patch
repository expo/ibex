+TEST(HermesWebGpuArrayBufferTest, AliasesShareBackingAndRequireMatchingKey) {
+  struct FixedBuffer final : MutableBuffer {
+    size_t size() const override {
+      return bytes.size();
+    }
+    uint8_t *data() override {
+      return bytes.data();
+    }
+
+    std::array<uint8_t, 16> bytes{};
+  };
+
+  auto rt = makeHermesRuntime();
+  auto *mappedBuffers = castInterface<IExactWebGpuArrayBuffer>(rt.get());
+  ASSERT_NE(mappedBuffers, nullptr);
+
+  auto backing = std::make_shared<FixedBuffer>();
+  backing->bytes[5] = 17;
+  ArrayBuffer source(*rt, backing);
+  auto alias = mappedBuffers->createWebGpuMappedRangeAlias(source, 4, 6);
+  auto overlappingAlias =
+      mappedBuffers->createWebGpuMappedRangeAlias(source, 5, 3);
+  ASSERT_EQ(alias.size(*rt), 6);
+  EXPECT_EQ(alias.data(*rt)[1], 17);
+  alias.data(*rt)[2] = 29;
+  EXPECT_EQ(backing->bytes[6], 29);
+  EXPECT_EQ(source.data(*rt)[6], 29);
+  EXPECT_EQ(overlappingAlias.data(*rt)[1], 29);
+
+#ifdef JSI_UNSTABLE
+  auto *serialization = castInterface<ISerialization>(rt.get());
+  ASSERT_NE(serialization, nullptr);
+  auto transfers = Array::createWithElements(*rt, Value(*rt, alias));
+  EXPECT_THROW(
+      serialization->serializeWithTransfer(Value(*rt, alias), transfers),
+      JSError);
+  EXPECT_EQ(alias.size(*rt), 6);
+#endif
+
+  EXPECT_THROW(
+      mappedBuffers->createWebGpuMappedRangeAlias(alias, 0, 1),
+      JSINativeException);
+  EXPECT_FALSE(mappedBuffers->detachWebGpuMappedRange(source));
+  EXPECT_EQ(source.size(*rt), backing->bytes.size());
+
+  EXPECT_TRUE(mappedBuffers->detachWebGpuMappedRange(alias));
+  EXPECT_THROW(alias.size(*rt), JSINativeException);
+  EXPECT_FALSE(mappedBuffers->detachWebGpuMappedRange(alias));
+  EXPECT_EQ(overlappingAlias.size(*rt), 3);
+  EXPECT_TRUE(mappedBuffers->detachWebGpuMappedRange(overlappingAlias));
+  EXPECT_EQ(source.data(*rt)[6], 29);
+}
