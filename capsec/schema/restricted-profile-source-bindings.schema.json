{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-source-bindings.schema.json",
  "title": "Ibex restricted-profile executable source bindings",
  "type": "object",
  "required": [
    "sourceBindingSchema",
    "authorityDigests",
    "counts",
    "bindings"
  ],
  "properties": {
    "sourceBindingSchema": {
      "const": "ibex/restricted-profile-source-bindings/1"
    },
    "authorityDigests": {
      "type": "object",
      "required": ["implementationManifest"],
      "properties": {
        "implementationManifest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["bindings", "sites", "producerPaths", "provenanceOnly"],
      "properties": {
        "bindings": { "type": "integer", "minimum": 1 },
        "sites": { "type": "integer", "minimum": 1 },
        "producerPaths": { "type": "integer", "minimum": 1 },
        "provenanceOnly": { "const": 0 }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceBinding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9_-]{43}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "site": {
      "type": "object",
      "required": [
        "siteId",
        "path",
        "role",
        "startByte",
        "endByte",
        "startLine",
        "endLine",
        "rawContentDigest"
      ],
      "properties": {
        "siteId": { "$ref": "#/$defs/stableId" },
        "path": { "$ref": "#/$defs/repoPath" },
        "role": {
          "enum": [
            "definition",
            "value-producer",
            "selector",
            "guard",
            "registration",
            "publication",
            "alias",
            "lazy-trigger",
            "retention",
            "dispatch"
          ]
        },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "rawContentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "producerPath": {
      "type": "object",
      "required": ["pathId", "conditionId", "requiredSiteIds"],
      "properties": {
        "pathId": { "$ref": "#/$defs/stableId" },
        "conditionId": { "$ref": "#/$defs/stableId" },
        "requiredSiteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      },
      "additionalProperties": false
    },
    "sourceBinding": {
      "type": "object",
      "required": [
        "sourceRef",
        "locatorKind",
        "resolutionPolicy",
        "sites",
        "producerPaths"
      ],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 3 },
        "locatorKind": { "type": "string", "minLength": 1 },
        "resolutionPolicy": {
          "enum": [
            "single-site",
            "composite-path",
            "conditioned-alternatives",
            "provenance-only"
          ]
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/site" }
        },
        "producerPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/producerPath" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolutionPolicy": { "const": "provenance-only" }
            },
            "required": ["resolutionPolicy"]
          },
          "then": {
            "properties": {
              "producerPaths": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "producerPaths": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
