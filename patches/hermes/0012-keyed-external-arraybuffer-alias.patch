+std::shared_ptr<void> JSArrayBuffer::getOrPromoteExternalDataContext(
+    Runtime &runtime,
+    Handle<JSArrayBuffer> self) {
+  assert(self->attached() && "Cannot promote a detached ArrayBuffer");
+  if (self->external()) {
+    return getExternalDataContext(runtime, self);
+  }
+
+  struct PromotedDataBlockOwner final {
+    explicit PromotedDataBlockOwner(uint8_t *data) : data(data) {}
+    ~PromotedDataBlockOwner() {
+      if (ownsData) {
+        free(data);
+      }
+    }
+
+    uint8_t *data;
+    bool ownsData{false};
+  };
+
+  // Keep ownership with the internal ArrayBuffer until every fallible owner
+  // allocation is complete. Only the no-fail commit below arms the shared
+  // deleter, so an exception cannot free storage still referenced by self.
+  auto owner = std::make_shared<PromotedDataBlockOwner>(self->data_);
+  std::shared_ptr<void> context = owner;
+  auto contextPtr = std::make_unique<std::shared_ptr<void>>(context);
+  auto finalizer = [](GC &, NativeState *ns) {
+    delete static_cast<std::shared_ptr<void> *>(ns->context());
+  };
+  struct : public Locals {
+    PinnedValue<NativeState> nativeState;
+  } lv;
+  LocalsRAII lraii(runtime, &lv);
+  lv.nativeState = NativeState::create(runtime, contextPtr.get(), finalizer);
+  contextPtr.release();
+  setExternalFinalizer(runtime, self, lv.nativeState);
+
+  self->untrackInternalBuffer(runtime.getHeap());
+  self->external_ = true;
+  owner->ownsData = true;
+  return context;
+}
