{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibex.dev/capsec/schema/restricted-profile-absence-probe-plan.schema.json",
  "title": "Restricted Exact per-edge absence probe plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probePlanSchema",
    "profile",
    "projectionRawContentDigest",
    "coverageRawContentDigest",
    "implementationManifestRawContentDigest",
    "rootGlobalManifestRawContentDigest",
    "counts",
    "edges"
  ],
  "properties": {
    "probePlanSchema": { "const": "ibex/restricted-profile-absence-probe-plan/1" },
    "profile": { "const": "ibex/exact-embedder-contract/1" },
    "projectionRawContentDigest": { "$ref": "#/$defs/digest" },
    "coverageRawContentDigest": { "$ref": "#/$defs/digest" },
    "implementationManifestRawContentDigest": { "$ref": "#/$defs/digest" },
    "rootGlobalManifestRawContentDigest": { "$ref": "#/$defs/digest" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "sourceInstallProbes", "liveReachabilityProbes"],
      "properties": {
        "edges": { "type": "integer", "minimum": 1 },
        "sourceInstallProbes": { "type": "integer", "minimum": 1 },
        "liveReachabilityProbes": { "type": "integer", "minimum": 1 }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edgeId",
          "surfaceKind",
          "surfaceName",
          "observedIdentity",
          "sourceInstall",
          "liveReachability"
        ],
        "properties": {
          "edgeId": { "$ref": "#/$defs/stableId" },
          "surfaceKind": {
            "enum": ["builtin", "callback", "cli", "host-abi", "loader", "native-op", "startup"]
          },
          "surfaceName": { "type": "string", "minLength": 1 },
          "observedIdentity": { "type": "string", "minLength": 1 },
          "sourceInstall": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourceProbe" }
          },
          "liveReachability": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/liveProbe" }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "stableId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$" },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeId",
        "branchId",
        "enforcementBranchId",
        "enforcementRouteKind",
        "sourceRefs",
        "proofPaths",
        "expected"
      ],
      "properties": {
        "probeId": { "$ref": "#/$defs/stableId" },
        "branchId": { "type": "string", "minLength": 1 },
        "enforcementBranchId": { "type": "string", "minLength": 1 },
        "enforcementRouteKind": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/stringArray" },
        "proofPaths": { "$ref": "#/$defs/stringArray" },
        "expected": { "const": "not-selected-or-retained" }
      }
    },
    "liveProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "routeKind", "target", "expected"],
      "properties": {
        "probeId": { "$ref": "#/$defs/stableId" },
        "routeKind": {
          "enum": [
            "descriptor-prefix",
            "restricted-module-resolution",
            "restricted-callback-route",
            "restricted-cli-entry",
            "restricted-js-native-abi",
            "restricted-loader-entry",
            "restricted-native-installer-route",
            "restricted-startup-route"
          ]
        },
        "target": { "type": "string", "minLength": 1 },
        "unresolvedSegment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "expected": { "const": "unreachable" }
      }
    }
  }
}
