+    truncated = true;
+    return false;
+  }
+  return true;
+}
+
+bool appendBoundedUTF8(
+    std::string &output,
+    llvh::StringRef text,
+    bool &truncated) {
+  if (truncated)
+    return false;
+  if (text.size() <= kMaximumSafeTextBytes - output.size()) {
+    output.append(text.data(), text.size());
+    return true;
+  }
+
+  truncated = true;
+  const size_t contentBytes =
+      kMaximumSafeTextBytes - kSafeTextTruncationMarkerBytes;
+  if (output.size() > contentBytes) {
+    output.resize(validUTF8PrefixLength(output, contentBytes));
+  }
+  const size_t available = contentBytes - output.size();
+  const size_t prefix = validUTF8PrefixLength(text, available);
+  output.append(text.data(), prefix);
+  output.append(kSafeTextTruncationMarker);
+  return false;
+}
+
+void finishBoundedTruncation(std::string &output, bool &truncated) {
+  if (truncated)
+    return;
+  const size_t contentBytes =
+      kMaximumSafeTextBytes - kSafeTextTruncationMarkerBytes;
+  if (output.size() > contentBytes) {
+    output.resize(validUTF8PrefixLength(output, contentBytes));
+  }
+  output.append(kSafeTextTruncationMarker);
+  truncated = true;
+}
