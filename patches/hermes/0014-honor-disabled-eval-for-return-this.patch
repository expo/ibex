+/// One-way embedder latch for eval and Function-family string compilation.
+/// `vmRuntime` is the opaque pointer returned by IHermes::getVMRuntimeUnsafe().
+extern "C" HERMES_EXPORT void ex_hermes_vm_disable_eval(void *vmRuntime);
